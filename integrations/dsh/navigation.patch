@@ -0,0 +1,43 @@
+import type { Context } from '@deepseek-ai/cordis'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-agent'
+import type {} from '@deepseek-ai/dsh-session-projection'
+import type {} from '@deepseek-ai/dsh-session-title/types'
+import type {} from '@deepseek-ai/dsh-user-approval'
+import type {} from '@deepseek-ai/dsh-user-questions'
+import type {} from '@deepseek-ai/dsh-workspace'
+import type { MicroInputHost } from './micro-input.ts'
+
+export function microInputHost(ctx: Context, navigate: MicroInputHost['navigate']): MicroInputHost {
+  return {
+    read(id) {
+      const session = ctx.sessions.get(SessionId(id))
+      if (session === undefined) return undefined
+      const questions = ctx.userQuestions.pendingCount(session)
+      if (questions === undefined) return undefined
+      const agent = ctx.agents.get(session.id)
+      const workspace = ctx.workspaceRegistry.list().find(item => item.sessionIds.includes(session.id))
+      return { identity: session, row: {
+        sessionId: id, workspaceId: workspace?.id ?? '',
+        title: ctx.sessionProjections.cachedStateOf(session, 'title') ?? id,
+        active: agent?.session === session,
+        running: agent?.session === session && agent.status === 'running',
+        pendingInput: ctx.approval.pendingCount(session) + questions,
+      } }
+    },
+    observe(changed) {
+      const stops = [
+        ctx.on('agent/status', ({ agent }) => { changed(agent.id) }, { global: true }),
+        ctx.on('agent/created', ({ agent }) => { changed(agent.id) }, { global: true }),
+        ctx.on('agent/disposed', ({ agent }) => { changed(agent.id) }, { global: true }),
+        ctx.on('session/created', (session) => { changed(session.id) }, { global: true }),
+        ctx.on('session/disposed', (session) => { changed(session.id) }, { global: true }),
+        ctx.on('session/event', (session) => { changed(session.id) }, { global: true }),
+        ctx.approval.observePending((session) => { changed(session.id) }),
+        ctx.userQuestions.observePending((session) => { changed(session.id) }),
+      ]
+      return () => { for (const stop of stops)  stop() }
+    },
+    navigate,
+  }
+}
diff --git a/apps/desktop-host/src/micro-input.ts b/apps/desktop-host/src/micro-input.ts
new file mode 100644
index 00000000..138ffe00
--- /dev/null
+++ b/apps/desktop-host/src/micro-input.ts
@@ -0,0 +1,203 @@
+import { randomBytes, randomUUID, timingSafeEqual } from 'node:crypto'
+import { constants, closeSync, fstatSync, lstatSync, openSync, readFileSync } from 'node:fs'
+import { chmod, lstat, mkdir, rm, writeFile } from 'node:fs/promises'
+import { createServer, type Socket } from 'node:net'
+import { dirname, isAbsolute, join } from 'node:path'
+
+export interface MicroInputRow {
+  readonly sessionId: string
+  readonly workspaceId: string
+  readonly title: string
+  readonly active: boolean
+  readonly running: boolean
+  readonly pendingInput: number
+}
+export interface MicroInputHost {
+  read(sessionId: string): { row: MicroInputRow; identity: object } | undefined
+  observe(changed: (sessionId: string) => void): () => void
+  navigate(sessionId: string, signal: AbortSignal): Promise<string | undefined>
+}
+interface Config { readonly directory: string; readonly sessionIds: readonly string[] }
+export interface MicroInputGrant extends Config {
+  readonly version: 1
+  readonly socketPath: string
+  readonly token: string
+  readonly hostId: string
+  readonly generation: number
+}
+interface Request {
+  readonly version: 1
+  readonly id: string
+  readonly token: string
+  readonly hostId: string
+  readonly generation: number
+  readonly subscriptionId: string
+  readonly op: 'subscribe' | 'read' | 'open' | 'close'
+  readonly activate?: false
+  readonly after?: number
+  readonly sessionId?: string
+  readonly workspaceId?: string
+}
+interface Change { readonly sequence: number; readonly row: MicroInputRow }
+const text = (value: unknown, max = 4096): value is string => typeof value === 'string' && value.length > 0 && Buffer.byteLength(value) <= max
+
+export function readMicroInputConfig(path: string): Config {
+  const fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK)
+  try {
+    const info = fstatSync(fd)
+    if (!info.isFile() || info.uid !== process.getuid?.() || (info.mode & 0o077) !== 0 || info.size > 65536) throw new Error('invalid Micro Input config')
+    const config = JSON.parse(readFileSync(fd, 'utf8')) as Record<string, unknown>
+    if (Object.keys(config).some(key => !['directory', 'sessionIds'].includes(key))
+      || typeof config.directory !== 'string' || !isAbsolute(config.directory)
+      || !Array.isArray(config.sessionIds) || config.sessionIds.length < 1 || config.sessionIds.length > 64
+      || !config.sessionIds.every(id => text(id)) || new Set(config.sessionIds).size !== config.sessionIds.length) throw new Error('invalid Micro Input scope')
+    return config as unknown as Config
+  } finally { closeSync(fd) }
+}
+
+export async function startOptionalMicroInputBridge(path: string, host: MicroInputHost) {
+  try { return await startMicroInputBridge(readMicroInputConfig(path), host) }
+  catch { return undefined }
+}
+
+export async function startMicroInputBridge(config: Config, host: MicroInputHost) {
+  const parent = lstatSync(dirname(config.directory))
+  if (!parent.isDirectory() || parent.uid !== process.getuid?.()) throw new Error('invalid Micro Input parent')
+  await mkdir(config.directory, { mode: 0o700, recursive: false }).catch((error: unknown) => {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error
+  })
+  const directory = await lstat(config.directory)
+  if (!directory.isDirectory() || directory.uid !== process.getuid() || (directory.mode & 0o077) !== 0) throw new Error('invalid Micro Input directory')
+  const lock = join(config.directory, 'dsh.lock')
+  await mkdir(lock, { mode: 0o700 })
+  const socketPath = join(config.directory, 'dsh.sock')
+  const grantPath = join(config.directory, 'dsh-grant.json')
+  const grant: MicroInputGrant = { version: 1, directory: config.directory, sessionIds: config.sessionIds,
+    socketPath, token: randomBytes(32).toString('hex'), hostId: randomUUID(), generation: 1 }
+  let disposed = false, stale = false, subscribed = false, cursor = 0
+  let subscriptionId: string | undefined
+  const isStale = () => stale
+  const isDisposed = () => disposed
+  const isSubscribed = () => subscribed
+  const rows = new Map<string, MicroInputRow>(), identities = new Map<string, object>()
+  const journal: Change[] = [], sockets = new Set<Socket>()
+  const opens = new Set<AbortController>()
+  let unobserve: (() => void) | undefined
+  const read = (id: string): MicroInputRow | undefined => {
+    const value = host.read(id)
+    if (value === undefined) { rows.delete(id); return undefined }
+    const old = identities.get(id)
+    if (old !== undefined && old !== value.identity) { stale = true; return undefined }
+    identities.set(id, value.identity)
+    const row = value.row
+    if (row.sessionId !== id || typeof row.title !== 'string' || Buffer.byteLength(row.title) > 4096 || typeof row.workspaceId !== 'string'
+      || Buffer.byteLength(row.workspaceId) > 4096 || typeof row.active !== 'boolean' || typeof row.running !== 'boolean'
+      || !Number.isSafeInteger(row.pendingInput) || row.pendingInput < 0) { stale = true; return undefined }
+    return row
+  }
+  const change = (id: string) => {
+    if (!subscribed || disposed || stale || !config.sessionIds.includes(id)) return
+    const row = read(id)
+    if (row === undefined) return
+    if (JSON.stringify(rows.get(id)) !== JSON.stringify(row)) {
+      rows.set(id, row)
+      journal.push({ sequence: ++cursor, row })
+      if (journal.length > 1024) journal.shift()
+    }
+  }
+  const stopSubscription = () => {
+    subscribed = false; unobserve?.(); unobserve = undefined
+    for (const open of opens) open.abort()
+    opens.clear(); rows.clear(); journal.length = 0
+  }
+  const requestValid = (value: unknown): value is Request => {
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) return false
+    const r = value as Record<string, unknown>
+    return Object.keys(r).every(key => ['version', 'id', 'token', 'hostId', 'generation', 'subscriptionId', 'op', 'activate', 'after', 'sessionId', 'workspaceId'].includes(key))
+      && r.version === 1 && text(r.subscriptionId, 256) && text(r.id, 256) && text(r.token, 256) && text(r.hostId, 256)
+      && Number.isSafeInteger(r.generation) && ['subscribe', 'read', 'open', 'close'].includes(String(r.op))
+  }
+  const dispatch = async (input: unknown): Promise<object> => {
+    const base = { version: 1, id: requestValid(input) ? input.id : '', subscriptionId: requestValid(input) ? input.subscriptionId : '', hostId: grant.hostId, generation: grant.generation }
+    if (!requestValid(input)) return { ...base, status: 'denied' }
+    const token = Buffer.from(input.token), expected = Buffer.from(grant.token)
+    if (token.length !== expected.length || !timingSafeEqual(token, expected)) return { ...base, status: 'denied' }
+    if (disposed || stale || input.hostId !== grant.hostId || input.generation !== grant.generation) return { ...base, status: 'stale' }
+    if (input.op !== 'subscribe' && input.subscriptionId !== subscriptionId) return { ...base, status: 'stale' }
+    if (input.op === 'close') {
+      if (input.activate !== undefined || input.after !== undefined || input.sessionId !== undefined || input.workspaceId !== undefined) return { ...base, status: 'denied' }
+      stopSubscription(); return { ...base, status: 'ok' }
+    }
+    if (input.op === 'subscribe') {
+      if (subscribed && input.subscriptionId !== subscriptionId) return { ...base, status: 'stale' }
+      if (input.activate !== false || input.after !== undefined || input.sessionId !== undefined || input.workspaceId !== undefined) return { ...base, status: 'denied' }
+      stopSubscription(); subscriptionId = input.subscriptionId; subscribed = true
+      unobserve = host.observe(change)
+      for (const id of config.sessionIds) { const row = read(id); if (row !== undefined) rows.set(id, row) }
+      if (isStale()) { stopSubscription(); return { ...base, status: 'stale' } }
+      return { ...base, status: 'ok', cursor, rows: [...rows.values()], changes: [], unavailableSessionIds: config.sessionIds.filter(id => !rows.has(id)) }
+    }
+    if (!subscribed) return { ...base, status: 'denied' }
+    if (input.op === 'read') {
+      const afterCursor = input.after
+      if (typeof afterCursor !== 'number' || !Number.isSafeInteger(afterCursor) || afterCursor < 0 || afterCursor > cursor || input.sessionId !== undefined || input.workspaceId !== undefined || input.activate !== undefined) return { ...base, status: 'denied' }
+      if (afterCursor < (journal[0]?.sequence ?? cursor + 1) - 1) return { ...base, status: 'gap' }
+      for (const id of config.sessionIds) change(id)
+      if (afterCursor < (journal[0]?.sequence ?? cursor + 1) - 1) return { ...base, status: 'gap' }
+      if (isStale()) return { ...base, status: 'stale' }
+      return { ...base, status: 'ok', cursor, rows: [...rows.values()], changes: journal.filter(item => item.sequence > afterCursor), unavailableSessionIds: config.sessionIds.filter(id => !rows.has(id)) }
+    }
+    if (!text(input.sessionId) || !config.sessionIds.includes(input.sessionId) || typeof input.workspaceId !== 'string'
+      || input.after !== undefined || input.activate !== undefined) return { ...base, status: 'denied' }
+    const before = read(input.sessionId)
+    if (isStale()) return { ...base, status: 'stale' }
+    if (before === undefined) return { ...base, status: 'unavailable' }
+    if (before.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+    const abort = new AbortController(); opens.add(abort)
+    const timer = setTimeout(() =>{  abort.abort() }, 1500)
+    try {
+      const selected = await host.navigate(input.sessionId, abort.signal)
+      const after = read(input.sessionId)
+      if (isDisposed() || isStale() || !isSubscribed() || subscriptionId !== input.subscriptionId || abort.signal.aborted || after?.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+      return selected === input.sessionId ? { ...base, status: 'confirmed', selected } : { ...base, status: 'unconfirmed' }
+    } catch { return { ...base, status: 'unavailable' } }
+    finally { clearTimeout(timer); opens.delete(abort) }
+  }
+  const server = createServer((socket) => {
+    sockets.add(socket); socket.setTimeout(2000, () => socket.destroy())
+    let buffer = Buffer.alloc(0), used = false
+    socket.on('error', () => {})
+    socket.on('close', () => sockets.delete(socket))
+    socket.on('data', (chunk) => {
+      if (used) return
+      buffer = Buffer.concat([buffer, chunk])
+      if (buffer.length > 65536) { socket.destroy(); return }
+      const end = buffer.indexOf(10)
+      if (end < 0) return
+      used = true
+      let request: unknown
+      try { request = JSON.parse(buffer.subarray(0, end).toString()) } catch { socket.end('{}\n'); return }
+      void dispatch(request).then(reply => socket.end(`${JSON.stringify(reply)}\n`), () => socket.end('{}\n'))
+    })
+  })
+  const ownership = { socket: false }
+  try {
+    if (Buffer.byteLength(socketPath) >= 104) throw new Error('Micro Input socket path too long')
+    await new Promise<void>((resolve, reject) => { server.once('error', reject); server.listen(socketPath, () => { ownership.socket = true; resolve() }) })
+    await chmod(socketPath, 0o600)
+    const { directory: _directory, ...publicGrant } = grant
+    await writeFile(grantPath, JSON.stringify(publicGrant), { mode: 0o600, flag: 'wx' })
+  } catch (error) {
+    server.close()
+    if (ownership.socket) await rm(socketPath, { force: true })
+    await rm(lock, { recursive: true, force: true })
+    throw error
+  }
+  return { grantPath, grant, async close() {
+    if (disposed) return
+    disposed = true; stopSubscription()
+    for (const socket of sockets) socket.destroy()
+    await new Promise<void>(resolve => server.close(() =>{  resolve() }))
+    await rm(grantPath, { force: true }); await rm(socketPath, { force: true }); await rm(lock, { recursive: true, force: true })
+  } }
+}
diff --git a/apps/desktop-host/tests/micro-input-host.spec.ts b/apps/desktop-host/tests/micro-input-host.spec.ts
