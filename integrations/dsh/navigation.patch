diff --git a/apps/desktop-host/src/micro-input-host.ts b/apps/desktop-host/src/micro-input-host.ts
new file mode 100644
index 00000000..2cb3c4f4
--- /dev/null
+++ b/apps/desktop-host/src/micro-input-host.ts
@@ -0,0 +1,176 @@
+import { randomUUID } from 'node:crypto'
+import type { Context } from '@deepseek-ai/cordis'
+import { SessionId, type Session, type UserMessage } from '@deepseek-ai/dsh-session'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type {} from '@deepseek-ai/dsh-session-projection'
+import type {} from '@deepseek-ai/dsh-session-title/types'
+import type {} from '@deepseek-ai/dsh-user-approval'
+import type {} from '@deepseek-ai/dsh-user-questions'
+import type {} from '@deepseek-ai/dsh-workspace'
+import type { MicroInputHost, MicroInputPromptOutcome } from './micro-input.ts'
+
+export function microInputHost(
+  ctx: Context,
+  navigate: MicroInputHost['navigate'],
+  selected?: MicroInputHost['selected'],
+): MicroInputHost & Required<Pick<MicroInputHost, 'create' | 'prompt' | 'cancel'>> {
+  const createdAgents = new Map<string, Agent>()
+  const promptLedger = new WeakMap<Session, Map<string, 'queue' | 'steer'>>()
+  let createdCounter = 0
+  const readTurnAndQueue = (session: Session) => {
+    const boundary = ctx.sessionProjections.cachedStateOf(session, 'turnBoundary')
+    const inbox = ctx.sessionProjections.cachedStateOf(session, 'inbox')
+    if (boundary !== undefined && inbox !== undefined) {
+      return {
+        currentTurn: boundary.openTurnStartSeq === null ? null : boundary.lastTurn,
+        queuedCount: inbox['next-step'].length + inbox['next-turn'].length,
+      }
+    }
+    return ctx.sessionProjections.cachedTurnAndQueueOf(session)
+  }
+  const resolveAgent = (session: Session): Agent | undefined =>
+    ctx.agents.get(session.id) ?? createdAgents.get(session.id)
+
+  return {
+    read(id) {
+      const session = ctx.sessions.get(SessionId(id))
+      if (session === undefined) return undefined
+      const questions = ctx.userQuestions.pendingCount(session)
+      if (questions === undefined) return undefined
+      const turnAndQueue = readTurnAndQueue(session)
+      if (turnAndQueue === undefined) return undefined
+      const agent = resolveAgent(session)
+      const workspace = ctx.workspaceRegistry.list().find(item => item.sessionIds.includes(session.id))
+      const active = agent?.session === session
+      const running = active && agent.status === 'running'
+      return {
+        identity: session,
+        row: {
+          sessionId: id,
+          workspaceId: workspace?.id ?? '',
+          title: ctx.sessionProjections.cachedStateOf(session, 'title') ?? id,
+          active,
+          running,
+          pendingInput: ctx.approval.pendingCount(session) + questions,
+          currentTurn: turnAndQueue.currentTurn,
+          queuedCount: turnAndQueue.queuedCount,
+        },
+      }
+    },
+    observe(changed) {
+      const stops = [
+        ctx.on('agent/status', ({ agent }) => { changed(agent.id) }, { global: true }),
+        ctx.on('agent/created', ({ agent }) => { changed(agent.id) }, { global: true }),
+        ctx.on('agent/disposed', ({ agent }) => { changed(agent.id) }, { global: true }),
+        ctx.on('session/created', (session) => { changed(session.id) }, { global: true }),
+        ctx.on('session/disposed', (session) => { createdAgents.delete(session.id); changed(session.id) }, { global: true }),
+        ctx.on('session/event', (session) => { changed(session.id) }, { global: true }),
+        ctx.approval.observePending((session) => { changed(session.id) }),
+        ctx.userQuestions.observePending((session) => { changed(session.id) }),
+      ]
+      return () => { for (const stop of stops) stop() }
+    },
+    navigate,
+    ...(selected === undefined ? {} : { selected }),
+    async create(workspaceId, signal) {
+      signal.throwIfAborted()
+      const workspace = ctx.workspaceRegistry.list().find(item => item.id === workspaceId)
+      if (workspace === undefined) return undefined
+      const sessionId = SessionId(`dsh-created-${++createdCounter}`)
+      const session = ctx.sessions.create(sessionId)
+      const attach = (workspace as { attachSession?: (id: SessionId) => Promise<void> }).attachSession
+      if (typeof attach === 'function') await attach.call(workspace, session.id)
+      else if (Array.isArray(workspace.sessionIds) && !workspace.sessionIds.includes(session.id)) {
+        (workspace.sessionIds as SessionId[]).push(session.id)
+      }
+      createdAgents.set(session.id, {
+        id: session.id,
+        session,
+        status: 'idle',
+        inbox: { nextStep: [], nextTurn: [] },
+      } as unknown as Agent)
+      return session.id
+    },
+    prompt(sessionId, mode, text, requestId, signal): Promise<MicroInputPromptOutcome> {
+      try {
+        signal.throwIfAborted()
+      } catch (error) {
+        return Promise.reject(error instanceof Error ? error : new Error(String(error)))
+      }
+      const session = ctx.sessions.get(SessionId(sessionId))
+      const agent = session === undefined ? undefined : resolveAgent(session)
+      if (session === undefined || agent === undefined || agent.session !== session) {
+        return Promise.resolve({ status: 'unavailable', reasonCode: 'session.notFound' })
+      }
+      if (text.trim().length === 0) return Promise.resolve({ status: 'denied', reasonCode: 'prompt.empty' })
+      const turnAndQueue = readTurnAndQueue(session)
+      if (turnAndQueue === undefined) return Promise.resolve({ status: 'unavailable', reasonCode: 'session.unmaterialized' })
+      let ledger = promptLedger.get(session)
+      if (ledger === undefined) {
+        ledger = new Map()
+        promptLedger.set(session, ledger)
+      }
+      const existingDelivery = ledger.get(requestId)
+      if (existingDelivery !== undefined) {
+        return Promise.resolve(existingDelivery === 'steer'
+          ? { status: 'steered', delivery: 'steer', currentTurn: turnAndQueue.currentTurn, queuedCount: turnAndQueue.queuedCount }
+          : { status: 'queued', delivery: 'queue', currentTurn: turnAndQueue.currentTurn, queuedCount: turnAndQueue.queuedCount })
+      }
+      if (mode === 'steer' && (agent.status !== 'running' || turnAndQueue.currentTurn === null)) {
+        return Promise.resolve({ status: 'unavailable', reasonCode: 'session.steerUnavailable' })
+      }
+      const message = {
+        id: randomUUID(),
+        role: 'user',
+        content: [{ type: 'text', text }],
+        source: { kind: 'user', rpcId: requestId },
+      } as unknown as UserMessage
+      if (mode === 'steer') {
+        const steer = (agent as unknown as { steer?: (input: UserMessage) => void }).steer
+        if (typeof steer === 'function') steer.call(agent, message)
+        else {
+          session.append('agent/inbox/spliced', { target: 'next-step', start: turnAndQueue.queuedCount, inserted: [message] })
+        }
+      } else {
+        const followup = (agent as unknown as { followup?: (input: UserMessage) => void }).followup
+        if (typeof followup === 'function') followup.call(agent, message)
+        else {
+          session.append('agent/inbox/spliced', { target: 'next-turn', start: turnAndQueue.queuedCount, inserted: [message] })
+        }
+      }
+      ledger.set(requestId, mode)
+      const after = readTurnAndQueue(session) ?? turnAndQueue
+      return Promise.resolve(mode === 'steer'
+        ? { status: 'steered', delivery: 'steer', currentTurn: after.currentTurn, queuedCount: after.queuedCount }
+        : { status: 'queued', delivery: 'queue', currentTurn: after.currentTurn, queuedCount: after.queuedCount })
+    },
+    cancel(sessionId, expectedTurn) {
+      const session = ctx.sessions.get(SessionId(sessionId))
+      const agent = session === undefined ? undefined : resolveAgent(session)
+      if (session === undefined || agent === undefined || agent.session !== session) {
+        return { status: 'unavailable', reasonCode: 'session.notFound' }
+      }
+      const turnAndQueue = readTurnAndQueue(session)
+      if (turnAndQueue === undefined || (agent.status === 'running' && turnAndQueue.currentTurn === null)) {
+        return { status: 'denied', reasonCode: 'guard.unprovableTurnAtomicity' }
+      }
+      if (agent.status !== 'running' || turnAndQueue.currentTurn === null) {
+        return { status: 'noop', reasonCode: 'guard.notRunning', currentTurn: null, queuedCount: turnAndQueue.queuedCount }
+      }
+      if (turnAndQueue.currentTurn !== expectedTurn) {
+        return { status: 'noop', reasonCode: 'guard.turnChanged', currentTurn: turnAndQueue.currentTurn, queuedCount: turnAndQueue.queuedCount }
+      }
+      const cancelAgent = (agent as unknown as { cancel?: (cause: { kind: 'user' }, options: { keepInbox: true }) => void }).cancel
+      if (typeof cancelAgent === 'function') cancelAgent.call(agent, { kind: 'user' }, { keepInbox: true })
+      if ((readTurnAndQueue(session)?.currentTurn ?? null) === expectedTurn) {
+        ;(agent as unknown as { status: string }).status = 'idle'
+        session.append('turn/end', { turn: expectedTurn, reason: { kind: 'aborted', reason: { kind: 'user' } } })
+        ctx.emit('agent/status', { agent, status: 'idle' })
+      }
+      const after = readTurnAndQueue(session) ?? { currentTurn: null, queuedCount: turnAndQueue.queuedCount }
+      return after.queuedCount > 0
+        ? { status: 'cancelledQueueRemaining', currentTurn: after.currentTurn, queuedCount: after.queuedCount }
+        : { status: 'cancelled', currentTurn: after.currentTurn, queuedCount: 0 }
+    },
+  }
+}
diff --git a/apps/desktop-host/src/micro-input.ts b/apps/desktop-host/src/micro-input.ts
new file mode 100644
index 00000000..f883f2cb
--- /dev/null
+++ b/apps/desktop-host/src/micro-input.ts
@@ -0,0 +1,438 @@
+import { randomBytes, randomUUID, timingSafeEqual } from 'node:crypto'
+import { constants, closeSync, fstatSync, lstatSync, openSync, readFileSync } from 'node:fs'
+import { chmod, lstat, mkdir, rm, writeFile } from 'node:fs/promises'
+import { createServer, type Socket } from 'node:net'
+import { dirname, isAbsolute, join } from 'node:path'
+
+export interface MicroInputRow {
+  readonly sessionId: string
+  readonly workspaceId: string
+  readonly title: string
+  readonly active: boolean
+  readonly running: boolean
+  readonly pendingInput: number
+  readonly currentTurn: number | null
+  readonly queuedCount: number
+}
+export type MicroInputPromptOutcome =
+  | {
+    readonly status: 'queued'
+    readonly delivery: 'queue'
+    readonly currentTurn: number | null
+    readonly queuedCount: number
+  }
+  | {
+    readonly status: 'steered'
+    readonly delivery: 'steer'
+    readonly currentTurn: number | null
+    readonly queuedCount: number
+  }
+  | {
+    readonly status: 'unavailable'
+    readonly reasonCode: string
+  }
+  | {
+    readonly status: 'denied'
+    readonly reasonCode: string
+  }
+export type MicroInputCancelOutcome =
+  | {
+    readonly status: 'cancelled'
+    readonly currentTurn: number | null
+    readonly queuedCount: number
+  }
+  | {
+    readonly status: 'cancelledQueueRemaining'
+    readonly currentTurn: number | null
+    readonly queuedCount: number
+  }
+  | {
+    readonly status: 'noop'
+    readonly reasonCode: string
+    readonly currentTurn: number | null
+    readonly queuedCount: number
+  }
+  | {
+    readonly status: 'unavailable'
+    readonly reasonCode: string
+  }
+  | {
+    readonly status: 'denied'
+    readonly reasonCode: string
+  }
+export interface MicroInputHost {
+  read(sessionId: string): { row: MicroInputRow; identity: object } | undefined
+  observe(changed: (sessionId: string) => void): () => void
+  navigate(sessionId: string, signal: AbortSignal): Promise<string | undefined>
+  selected?(): string | undefined
+  create?(workspaceId: string, signal: AbortSignal): Promise<string | undefined>
+  prompt?(
+    sessionId: string,
+    mode: 'queue' | 'steer',
+    text: string,
+    requestId: string,
+    signal: AbortSignal,
+  ): Promise<MicroInputPromptOutcome>
+  cancel?(sessionId: string, expectedTurn: number): MicroInputCancelOutcome
+}
+interface Config { readonly directory: string; readonly sessionIds: readonly string[] }
+export interface MicroInputGrant extends Config {
+  readonly version: 1
+  readonly socketPath: string
+  readonly token: string
+  readonly hostId: string
+  readonly generation: number
+}
+interface Request {
+  readonly version: 1
+  readonly id: string
+  readonly token: string
+  readonly hostId: string
+  readonly generation: number
+  readonly subscriptionId: string
+  readonly op: 'subscribe' | 'read' | 'open' | 'create' | 'prompt' | 'cancel' | 'query' | 'close'
+  readonly activate?: false
+  readonly after?: number
+  readonly sessionId?: string
+  readonly workspaceId?: string
+  readonly requestId?: string
+  readonly mode?: 'queue' | 'steer'
+  readonly text?: string
+  readonly expectedTurn?: number
+}
+interface Change { readonly sequence: number; readonly row: MicroInputRow }
+const text = (value: unknown, max = 4096): value is string => typeof value === 'string' && value.length > 0 && Buffer.byteLength(value) <= max
+
+export function readMicroInputConfig(path: string): Config {
+  const fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK)
+  try {
+    const info = fstatSync(fd)
+    if (!info.isFile() || info.uid !== process.getuid?.() || (info.mode & 0o077) !== 0 || info.size > 65536) throw new Error('invalid Micro Input config')
+    const config = JSON.parse(readFileSync(fd, 'utf8')) as Record<string, unknown>
+    if (Object.keys(config).some(key => !['directory', 'sessionIds'].includes(key))
+      || typeof config.directory !== 'string' || !isAbsolute(config.directory)
+      || !Array.isArray(config.sessionIds) || config.sessionIds.length < 1 || config.sessionIds.length > 64
+      || !config.sessionIds.every(id => text(id)) || new Set(config.sessionIds).size !== config.sessionIds.length) throw new Error('invalid Micro Input scope')
+    return config as unknown as Config
+  } finally { closeSync(fd) }
+}
+
+export async function startOptionalMicroInputBridge(path: string, host: MicroInputHost) {
+  try { return await startMicroInputBridge(readMicroInputConfig(path), host) }
+  catch { return undefined }
+}
+
+export async function startMicroInputBridge(config: Config, host: MicroInputHost) {
+  const parent = lstatSync(dirname(config.directory))
+  if (!parent.isDirectory() || parent.uid !== process.getuid?.()) throw new Error('invalid Micro Input parent')
+  await mkdir(config.directory, { mode: 0o700, recursive: false }).catch((error: unknown) => {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error
+  })
+  const directory = await lstat(config.directory)
+  if (!directory.isDirectory() || directory.uid !== process.getuid() || (directory.mode & 0o077) !== 0) throw new Error('invalid Micro Input directory')
+  const lock = join(config.directory, 'dsh.lock')
+  await mkdir(lock, { mode: 0o700 })
+  const socketPath = join(config.directory, 'dsh.sock')
+  const grantPath = join(config.directory, 'dsh-grant.json')
+  const grant: MicroInputGrant = { version: 1, directory: config.directory, sessionIds: config.sessionIds,
+    socketPath, token: randomBytes(32).toString('hex'), hostId: randomUUID(), generation: 1 }
+  let disposed = false, stale = false, subscribed = false, cursor = 0
+  let subscriptionId: string | undefined, lastSelected: string | undefined
+  const allowedSessionIds = [...config.sessionIds]
+  const allowedWorkspaces = new Set<string>()
+  const isStale = () => stale
+  const isDisposed = () => disposed
+  const isSubscribed = () => subscribed
+  const rows = new Map<string, MicroInputRow>(), identities = new Map<string, object>()
+  const settledCommands = new Map<string, Record<string, unknown>>()
+  const journal: Change[] = [], sockets = new Set<Socket>()
+  const opens = new Set<AbortController>()
+  let unobserve: (() => void) | undefined
+  const validTurn = (turn: unknown): turn is number | null =>
+    turn === null || (typeof turn === 'number' && Number.isSafeInteger(turn) && turn >= 1)
+  const read = (id: string): MicroInputRow | undefined => {
+    const value = host.read(id)
+    if (value === undefined) { rows.delete(id); return undefined }
+    const old = identities.get(id)
+    if (old !== undefined && old !== value.identity) { stale = true; return undefined }
+    identities.set(id, value.identity)
+    const row = value.row
+    if (row.sessionId !== id || typeof row.title !== 'string' || Buffer.byteLength(row.title) > 4096 || typeof row.workspaceId !== 'string'
+      || Buffer.byteLength(row.workspaceId) > 4096 || typeof row.active !== 'boolean' || typeof row.running !== 'boolean'
+      || !Number.isSafeInteger(row.pendingInput) || row.pendingInput < 0
+      || !validTurn(row.currentTurn) || !Number.isSafeInteger(row.queuedCount) || row.queuedCount < 0) { stale = true; return undefined }
+    if (row.workspaceId.length > 0) allowedWorkspaces.add(row.workspaceId)
+    return row
+  }
+  const change = (id: string) => {
+    if (!subscribed || disposed || stale || !allowedSessionIds.includes(id)) return
+    const row = read(id)
+    if (row === undefined) return
+    if (JSON.stringify(rows.get(id)) !== JSON.stringify(row)) {
+      rows.set(id, row)
+      journal.push({ sequence: ++cursor, row })
+      if (journal.length > 1024) journal.shift()
+    }
+  }
+  const stopSubscription = () => {
+    subscribed = false; unobserve?.(); unobserve = undefined; lastSelected = undefined
+    for (const open of opens) open.abort()
+    opens.clear(); rows.clear(); journal.length = 0; settledCommands.clear()
+  }
+  const currentSelected = () => host.selected !== undefined ? host.selected() : lastSelected
+  const requestValid = (value: unknown): value is Request => {
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) return false
+    const r = value as Record<string, unknown>
+    return Object.keys(r).every(key => [
+      'version', 'id', 'token', 'hostId', 'generation', 'subscriptionId', 'op',
+      'activate', 'after', 'sessionId', 'workspaceId', 'requestId', 'mode', 'text', 'expectedTurn',
+    ].includes(key))
+      && r.version === 1 && text(r.subscriptionId, 256) && text(r.id, 256) && text(r.token, 256) && text(r.hostId, 256)
+      && Number.isSafeInteger(r.generation)
+      && ['subscribe', 'read', 'open', 'create', 'prompt', 'cancel', 'query', 'close'].includes(String(r.op))
+  }
+  const hasExtraFields = (input: Request, allowed: readonly string[]) =>
+    Object.keys(input).some(key => !['version', 'id', 'token', 'hostId', 'generation', 'subscriptionId', 'op', ...allowed].includes(key))
+  const dispatch = async (input: unknown): Promise<object> => {
+    const base = { version: 1, id: requestValid(input) ? input.id : '', subscriptionId: requestValid(input) ? input.subscriptionId : '', hostId: grant.hostId, generation: grant.generation }
+    if (!requestValid(input)) return { ...base, status: 'denied' }
+    const token = Buffer.from(input.token), expected = Buffer.from(grant.token)
+    if (token.length !== expected.length || !timingSafeEqual(token, expected)) return { ...base, status: 'denied' }
+    if (disposed || stale || input.hostId !== grant.hostId || input.generation !== grant.generation) return { ...base, status: 'stale' }
+    if (input.op !== 'subscribe' && input.subscriptionId !== subscriptionId) return { ...base, status: 'stale' }
+    if (input.op === 'close') {
+      if (hasExtraFields(input, [])) return { ...base, status: 'denied' }
+      stopSubscription(); return { ...base, status: 'ok' }
+    }
+    if (input.op === 'subscribe') {
+      if (subscribed && input.subscriptionId !== subscriptionId) return { ...base, status: 'stale' }
+      if (input.activate !== false || hasExtraFields(input, ['activate'])) return { ...base, status: 'denied' }
+      stopSubscription(); subscriptionId = input.subscriptionId; subscribed = true
+      unobserve = host.observe(change)
+      for (const id of allowedSessionIds) { const row = read(id); if (row !== undefined) rows.set(id, row) }
+      if (isStale()) { stopSubscription(); return { ...base, status: 'stale' } }
+      const activeSelected = currentSelected()
+      const validSelected = activeSelected !== undefined && rows.has(activeSelected) ? activeSelected : undefined
+      return {
+        ...base,
+        status: 'ok',
+        cursor,
+        rows: [...rows.values()],
+        changes: [],
+        unavailableSessionIds: allowedSessionIds.filter(id => !rows.has(id)),
+        ...(validSelected === undefined ? {} : { selected: validSelected }),
+      }
+    }
+    if (!subscribed) return { ...base, status: 'denied' }
+    if (input.op === 'read') {
+      const afterCursor = input.after
+      if (typeof afterCursor !== 'number' || !Number.isSafeInteger(afterCursor) || afterCursor < 0 || afterCursor > cursor || hasExtraFields(input, ['after'])) return { ...base, status: 'denied' }
+      if (afterCursor < (journal[0]?.sequence ?? cursor + 1) - 1) return { ...base, status: 'gap' }
+      for (const id of allowedSessionIds) change(id)
+      if (afterCursor < (journal[0]?.sequence ?? cursor + 1) - 1) return { ...base, status: 'gap' }
+      if (isStale()) return { ...base, status: 'stale' }
+      const activeSelected = currentSelected()
+      const validSelected = activeSelected !== undefined && rows.has(activeSelected) ? activeSelected : undefined
+      return {
+        ...base,
+        status: 'ok',
+        cursor,
+        rows: [...rows.values()],
+        changes: journal.filter(item => item.sequence > afterCursor),
+        unavailableSessionIds: allowedSessionIds.filter(id => !rows.has(id)),
+        ...(validSelected === undefined ? {} : { selected: validSelected }),
+      }
+    }
+    if (input.op === 'query') {
+      if (!text(input.requestId, 256) || hasExtraFields(input, ['sessionId', 'workspaceId', 'requestId'])) return { ...base, status: 'denied' }
+      const targetKey = input.sessionId !== undefined ? input.sessionId : input.workspaceId
+      if (!text(targetKey)) return { ...base, status: 'denied' }
+      if (input.sessionId !== undefined && !allowedSessionIds.includes(input.sessionId)) return { ...base, status: 'denied' }
+      for (const id of allowedSessionIds) change(id)
+      if (isStale()) return { ...base, status: 'stale' }
+      if (input.sessionId === undefined && input.workspaceId !== undefined && !allowedWorkspaces.has(input.workspaceId)) return { ...base, status: 'denied' }
+      const settled = settledCommands.get(`${targetKey}:${input.requestId}`)
+      if (settled !== undefined) return { ...base, ...settled, duplicate: true }
+      return {
+        ...base,
+        status: 'unknown',
+        requestId: input.requestId,
+        ...(input.sessionId === undefined ? {} : { sessionId: input.sessionId }),
+        ...(input.workspaceId === undefined ? {} : { workspaceId: input.workspaceId }),
+      }
+    }
+    if (input.op === 'create') {
+      if (!text(input.workspaceId) || !text(input.requestId, 256) || hasExtraFields(input, ['workspaceId', 'requestId'])) return { ...base, status: 'denied' }
+      for (const id of allowedSessionIds) change(id)
+      if (isStale()) return { ...base, status: 'stale' }
+      const queryKey = `${input.workspaceId}:${input.requestId}`
+      const existing = settledCommands.get(queryKey)
+      if (existing !== undefined) return { ...base, ...existing, duplicate: true }
+      if (!allowedWorkspaces.has(input.workspaceId)) return { ...base, status: 'denied', reasonCode: 'guard.unauthorizedWorkspace' }
+      if (host.create === undefined) return { ...base, status: 'unavailable', reasonCode: 'create.unsupported' }
+      const abort = new AbortController(); opens.add(abort)
+      const isAborted = () => abort.signal.aborted
+      const timer = setTimeout(() => { abort.abort() }, 1500)
+      try {
+        const createdId = await host.create(input.workspaceId, abort.signal)
+        if (!text(createdId)) return { ...base, status: 'unavailable', reasonCode: 'create.failed' }
+        if (!allowedSessionIds.includes(createdId)) allowedSessionIds.push(createdId)
+        const createdRow = read(createdId)
+        change(createdId)
+        if (isDisposed() || isStale() || !isSubscribed() || subscriptionId !== input.subscriptionId || isAborted() || createdRow?.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+        const selected = await host.navigate(createdId, abort.signal)
+        const after = read(createdId)
+        change(createdId)
+        if (isDisposed() || isStale() || !isSubscribed() || subscriptionId !== input.subscriptionId || isAborted() || after?.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+        lastSelected = selected
+        if (selected !== createdId) return { ...base, status: 'unconfirmed', sessionId: createdId, workspaceId: input.workspaceId }
+        const settled = {
+          status: 'confirmed',
+          sessionId: createdId,
+          workspaceId: input.workspaceId,
+          selected: createdId,
+          requestId: input.requestId,
+          currentTurn: after.currentTurn,
+          queuedCount: after.queuedCount,
+          duplicate: false,
+        }
+        settledCommands.set(queryKey, settled)
+        settledCommands.set(`${createdId}:${input.requestId}`, settled)
+        return { ...base, ...settled }
+      } catch { return { ...base, status: 'unavailable' } }
+      finally { clearTimeout(timer); opens.delete(abort) }
+    }
+    if (!text(input.sessionId) || !allowedSessionIds.includes(input.sessionId) || typeof input.workspaceId !== 'string') return { ...base, status: 'denied' }
+    if (input.op === 'open') {
+      if (hasExtraFields(input, ['sessionId', 'workspaceId'])) return { ...base, status: 'denied' }
+      const before = read(input.sessionId)
+      if (isStale()) return { ...base, status: 'stale' }
+      if (before === undefined) return { ...base, status: 'unavailable' }
+      if (before.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+      const abort = new AbortController(); opens.add(abort)
+      const timer = setTimeout(() => { abort.abort() }, 1500)
+      try {
+        const selected = await host.navigate(input.sessionId, abort.signal)
+        const after = read(input.sessionId)
+        if (isDisposed() || isStale() || !isSubscribed() || subscriptionId !== input.subscriptionId || abort.signal.aborted || after?.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+        lastSelected = selected
+        return selected === input.sessionId ? { ...base, status: 'confirmed', selected } : { ...base, status: 'unconfirmed' }
+      } catch { return { ...base, status: 'unavailable' } }
+      finally { clearTimeout(timer); opens.delete(abort) }
+    }
+    if (input.op === 'prompt') {
+      if (!text(input.requestId, 256) || (input.mode !== 'queue' && input.mode !== 'steer')
+        || !text(input.text, 16384) || input.text.trim().length === 0
+        || hasExtraFields(input, ['sessionId', 'workspaceId', 'requestId', 'mode', 'text'])) return { ...base, status: 'denied' }
+      const before = read(input.sessionId)
+      if (isStale()) return { ...base, status: 'stale' }
+      if (before === undefined) return { ...base, status: 'unavailable' }
+      if (before.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+      const commandKey = `${input.sessionId}:${input.requestId}`
+      const existing = settledCommands.get(commandKey)
+      if (existing !== undefined) return { ...base, ...existing, duplicate: true }
+      const activeSelected = currentSelected()
+      if (activeSelected !== input.sessionId) {
+        return { ...base, status: 'unconfirmed', ...(activeSelected === undefined ? {} : { selected: activeSelected }), reasonCode: 'guard.selectionMismatch' }
+      }
+      if (host.prompt === undefined) return { ...base, status: 'unavailable', reasonCode: 'prompt.unsupported' }
+      const abort = new AbortController(); opens.add(abort)
+      const timer = setTimeout(() => { abort.abort() }, 1500)
+      try {
+        const outcome = await host.prompt(input.sessionId, input.mode, input.text, input.requestId, abort.signal)
+        const after = read(input.sessionId)
+        change(input.sessionId)
+        if (isDisposed() || isStale() || !isSubscribed() || subscriptionId !== input.subscriptionId || abort.signal.aborted || after?.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+        if (outcome.status === 'denied' || outcome.status === 'unavailable') {
+          return { ...base, status: outcome.status, reasonCode: outcome.reasonCode }
+        }
+        const settled = {
+          status: outcome.status,
+          delivery: outcome.delivery,
+          sessionId: input.sessionId,
+          workspaceId: input.workspaceId,
+          requestId: input.requestId,
+          currentTurn: outcome.currentTurn,
+          queuedCount: outcome.queuedCount,
+          duplicate: false,
+        }
+        settledCommands.set(commandKey, settled)
+        return { ...base, ...settled }
+      } catch { return { ...base, status: 'unavailable' } }
+      finally { clearTimeout(timer); opens.delete(abort) }
+    }
+    if (!text(input.requestId, 256) || typeof input.expectedTurn !== 'number' || !Number.isSafeInteger(input.expectedTurn) || input.expectedTurn < 1
+      || hasExtraFields(input, ['sessionId', 'workspaceId', 'requestId', 'expectedTurn'])) return { ...base, status: 'denied', reasonCode: 'guard.invalidCancelRequest' }
+    const before = read(input.sessionId)
+    if (isStale()) return { ...base, status: 'stale' }
+    if (before === undefined) return { ...base, status: 'unavailable' }
+    if (before.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+    const commandKey = `${input.sessionId}:${input.requestId}`
+    const existing = settledCommands.get(commandKey)
+    if (existing !== undefined) return { ...base, ...existing, duplicate: true }
+    const activeSelected = currentSelected()
+    if (activeSelected !== input.sessionId) {
+      return { ...base, status: 'unconfirmed', ...(activeSelected === undefined ? {} : { selected: activeSelected }), reasonCode: 'guard.selectionMismatch' }
+    }
+    if (host.cancel === undefined) {
+      return { ...base, status: 'denied', reasonCode: 'guard.unprovableTurnAtomicity' }
+    }
+    const outcome = host.cancel(input.sessionId, input.expectedTurn)
+    const after = read(input.sessionId)
+    change(input.sessionId)
+    if (isDisposed() || isStale() || !isSubscribed() || subscriptionId !== input.subscriptionId || after?.workspaceId !== input.workspaceId) return { ...base, status: 'stale' }
+    if (outcome.status === 'denied' || outcome.status === 'unavailable') {
+      return { ...base, status: outcome.status, reasonCode: outcome.reasonCode }
+    }
+    const settled = {
+      status: outcome.status,
+      sessionId: input.sessionId,
+      workspaceId: input.workspaceId,
+      requestId: input.requestId,
+      expectedTurn: input.expectedTurn,
+      currentTurn: outcome.currentTurn,
+      queuedCount: outcome.queuedCount,
+      ...('reasonCode' in outcome ? { reasonCode: outcome.reasonCode } : {}),
+      duplicate: false,
+    }
+    settledCommands.set(commandKey, settled)
+    return { ...base, ...settled }
+  }
+  const server = createServer((socket) => {
+    sockets.add(socket); socket.setTimeout(2000, () => socket.destroy())
+    let buffer = Buffer.alloc(0), used = false
+    socket.on('error', () => {})
+    socket.on('close', () => sockets.delete(socket))
+    socket.on('data', (chunk) => {
+      if (used) return
+      buffer = Buffer.concat([buffer, chunk])
+      if (buffer.length > 65536) { socket.destroy(); return }
+      const end = buffer.indexOf(10)
+      if (end < 0) return
+      used = true
+      let request: unknown
+      try { request = JSON.parse(buffer.subarray(0, end).toString()) } catch { socket.end('{}\n'); return }
+      void dispatch(request).then(reply => socket.end(`${JSON.stringify(reply)}\n`), () => socket.end('{}\n'))
+    })
+  })
+  const ownership = { socket: false }
+  try {
+    if (Buffer.byteLength(socketPath) >= 104) throw new Error('Micro Input socket path too long')
+    await new Promise<void>((resolve, reject) => { server.once('error', reject); server.listen(socketPath, () => { ownership.socket = true; resolve() }) })
+    await chmod(socketPath, 0o600)
+    const { directory: _directory, ...publicGrant } = grant
+    await writeFile(grantPath, JSON.stringify(publicGrant), { mode: 0o600, flag: 'wx' })
+  } catch (error) {
+    server.close()
+    if (ownership.socket) await rm(socketPath, { force: true })
+    await rm(lock, { recursive: true, force: true })
+    throw error
+  }
+  return { grantPath, grant, async close() {
+    if (disposed) return
+    disposed = true; stopSubscription()
+    for (const socket of sockets) socket.destroy()
+    await new Promise<void>(resolve => server.close(() =>{  resolve() }))
+    await rm(grantPath, { force: true }); await rm(socketPath, { force: true }); await rm(lock, { recursive: true, force: true })
+  } }
+}
