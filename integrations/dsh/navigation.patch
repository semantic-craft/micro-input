+++ b/scripts/micro-input-fixture.ts
@@ -0,0 +1,156 @@
+import { createServer } from 'node:net'
+import { chmod, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { Context, FiberState } from '@deepseek-ai/cordis'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SessionTitleService from '@deepseek-ai/dsh-session-title'
+import ApprovalService from '@deepseek-ai/dsh-user-approval'
+import UserQuestionService from '@deepseek-ai/dsh-user-questions'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import { microInputHost } from '../apps/desktop-host/src/micro-input-host.ts'
+import { startMicroInputBridge } from '../apps/desktop-host/src/micro-input.ts'
+
+const args = process.argv.slice(2)
+const directory = args[args.indexOf('--directory') + 1]
+const ttl = Number(args[args.indexOf('--ttl') + 1] ?? 120)
+if (!directory?.startsWith('/') || !Number.isSafeInteger(ttl) || ttl < 1 || ttl > 600) throw new Error('fixture directory/ttl required')
+const ctx = new Context()
+await ctx.plugin(SessionStore)
+await ctx.plugin(SessionProjectionRegistry)
+await ctx.plugin(SessionTitleService, { fallbackMaxWords: 8, fallbackMaxBytes: 64, maxTitleBytes: 256 })
+const agents = new Map<string, Agent>()
+const workspaceA = { id: 'workspace-a', sessionIds: [SessionId('dsh-a')] }
+const workspaceB = { id: 'workspace-b', sessionIds: [SessionId('dsh-b')] }
+ctx.provide('agents', { get: (id: string) => agents.get(id), roots: () => [...agents.values()] } as never)
+ctx.provide('workspaceRegistry', { list: () => [workspaceA, workspaceB] } as never)
+await ctx.plugin(ApprovalService)
+await ctx.plugin(UserQuestionService)
+for (const id of ['dsh-a', 'dsh-b']) {
+  const session = ctx.sessions.create(SessionId(id))
+  session.append('session/title', { title: 'Same title', messageSeqs: [], source: { kind: 'user' } })
+  session.append('turn/start', { turn: 1 })
+  agents.set(id, { id: session.id, session, status: 'running', inbox: { nextStep: [], nextTurn: [] } } as unknown as Agent)
+}
+let metadataReads = 0, navigationCount = 0, activationCount = 0, selected: string | undefined
+let createCount = 0, promptCount = 0, cancelCount = 0
+const originalPrepare = ctx.sessions.prepare.bind(ctx.sessions)
+ctx.sessions.prepare = (...input) => {
+  if (!String(input[0]).startsWith('dsh-created-')) activationCount++
+  return originalPrepare(...input)
+}
+const identities = new Map<string, object>()
+const deleted = new Set<string>()
+const source = microInputHost(
+  ctx,
+  (id, signal) => {
+    signal.throwIfAborted(); navigationCount++; selected = id; return Promise.resolve(selected)
+  },
+  () => selected,
+)
+const bridge = await startMicroInputBridge({ directory, sessionIds: ['dsh-a', 'dsh-b', 'dsh-cold'] }, {
+  ...source,
+  read(id) {
+    metadataReads++
+    const value = deleted.has(id) ? undefined : source.read(id)
+    return value === undefined ? undefined : { ...value, identity: identities.get(id) ?? value.identity }
+  },
+  async create(workspaceId, signal) {
+    const createdId = await source.create(workspaceId, signal)
+    if (createdId !== undefined) createCount++
+    return createdId
+  },
+  async prompt(sessionId, mode, text, requestId, signal) {
+    const outcome = await source.prompt(sessionId, mode, text, requestId, signal)
+    if (outcome.status === 'queued' || outcome.status === 'steered') promptCount++
+    return outcome
+  },
+  cancel(sessionId, expectedTurn) {
+    const outcome = source.cancel(sessionId, expectedTurn)
+    if (outcome.status === 'cancelled' || outcome.status === 'cancelledQueueRemaining') cancelCount++
+    return outcome
+  },
+})
+let bridgeStopped = false
+const stats = () => ({
+  metadataReads,
+  navigationCount,
+  activationCount,
+  createCount,
+  promptCount,
+  cancelCount,
+  hostStopped: ctx.fiber.state === FiberState.DISPOSED || ctx.fiber.state === FiberState.UNLOADING,
+  bridgeStopped,
+  selected,
+  sessionCount: ctx.sessions.list().length,
+})
+const controlPath = join(directory, 'control.sock')
+const controls = createServer((socket) => {
+  socket.setTimeout(2000, () => socket.destroy())
+  let buffer = ''
+  socket.on('data', (data) => {
+    buffer += data.toString()
+    if (buffer.length > 65536) { socket.destroy(); return }
+    if (!buffer.includes('\n')) return
+    const request = JSON.parse(buffer.slice(0, buffer.indexOf('\n'))) as { op: string; sessionId?: string; turn?: number }
+    void (async () => {
+      if (request.op === 'pending-pulse') {
+        const agent = agents.get('dsh-a')
+        if (agent === undefined) throw new Error('fixture agent missing')
+        const answerApproval = ctx.on('approval/request', () => Promise.resolve('allowed-once'))
+        await ctx.approval.request({ agent, toolName: 'fixture' })
+        answerApproval()
+        const answerQuestion = ctx.on('user-questions/request', () => Promise.resolve({ answers: [] }))
+        await ctx.userQuestions.ask({ agent, questions: [{ id: 'fixture', question: 'Synthetic only' }] })
+        answerQuestion()
+      } else if (request.op === 'advance-turn') {
+        const id = request.sessionId ?? 'dsh-a'
+        const session = ctx.sessions.get(SessionId(id))
+        const agent = agents.get(id)
+        if (session === undefined || agent === undefined) throw new Error('fixture session missing')
+        const nextTurn = request.turn ?? 2
+        const current = ctx.sessionProjections.cachedTurnAndQueueOf(session)?.currentTurn ?? null
+        if (current !== null) {
+          session.append('turn/end', { turn: current, reason: { kind: 'completed' } })
+        }
+        ;(agent as { status: string }).status = 'running'
+        session.append('turn/start', { turn: nextTurn })
+        ctx.emit('agent/status', { agent, status: 'running' })
+      } else if (request.op === 'unprovable-turn') {
+        const id = request.sessionId ?? 'dsh-b'
+        const session = ctx.sessions.get(SessionId(id))
+        const agent = agents.get(id)
+        if (session === undefined || agent === undefined) throw new Error('fixture session missing')
+        const current = ctx.sessionProjections.cachedTurnAndQueueOf(session)?.currentTurn ?? null
+        if (current !== null) {
+          session.append('turn/end', { turn: current, reason: { kind: 'completed' } })
+        }
+        ;(agent as { status: string }).status = 'running'
+        ctx.emit('agent/status', { agent, status: 'running' })
+      } else if (request.op === 'delete') {
+        const id = request.sessionId ?? 'dsh-a'
+        deleted.add(id)
+        agents.delete(id)
+      } else if (request.op === 'rotate') {
+        identities.set(request.sessionId ?? 'dsh-a', {})
+      } else if (request.op === 'stop-bridge') {
+        await bridge.close(); bridgeStopped = true
+      } else if (request.op !== 'stats') throw new Error('unknown control')
+      socket.end(`${JSON.stringify(stats())}\n`)
+    })().catch(() => socket.end('{"error":"fixture-control"}\n'))
+  })
+  socket.on('error', () => {})
+})
+await new Promise<void>(resolve => controls.listen(controlPath, resolve))
+await chmod(controlPath, 0o600)
+console.log(`GRANT_PATH=${bridge.grantPath}`)
+console.log(`CONTROL_PATH=${controlPath}`)
+let stopping: Promise<void> | undefined
+const stop = () => stopping ??= (async () => {
+  await bridge.close()
+  await new Promise<void>(resolve => controls.close(() =>{  resolve() }))
+  await rm(controlPath, { force: true })
+  await ctx.fiber.dispose()
+})()
+const timer = setTimeout(() => { void stop() }, ttl * 1000)
+for (const signal of ['SIGTERM', 'SIGINT'] as const) process.once(signal, () => { clearTimeout(timer); void stop() })
