+import { randomUUID } from 'node:crypto'
+import { connect } from 'node:net'
+import { chmod, mkdtemp, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { afterEach, expect, it } from 'vitest'
+import { startMicroInputBridge, startOptionalMicroInputBridge, type MicroInputRow, type MicroInputHost } from '../src/micro-input.ts'
+
+interface Reply {
+  status: string
+  cursor: number
+  rows: MicroInputRow[]
+  changes: { sequence: number; row: MicroInputRow }[]
+  unavailableSessionIds: string[]
+}
+const cleanup: (() => Promise<void>)[] = []
+afterEach(async () => { for (const stop of cleanup.splice(0).reverse()) await stop() })
+async function fixture() {
+  const directory = await mkdtemp(join(process.env.MI_DSH_TEST_ROOT ?? '/tmp', 'mi-dsh-'))
+  await chmod(directory, 0o700)
+  cleanup.push(() => rm(directory, { recursive: true, force: true }))
+  let reads = 0, navigations = 0, observations = 0
+  let identity = {}, row: MicroInputRow = { sessionId: 'a', workspaceId: 'w', title: '', active: true, running: true, pendingInput: 0 }
+  let changed: (id: string) => void = () => {}
+  let navigate: MicroInputHost['navigate'] = async id => id
+  const bridge = await startMicroInputBridge({ directory, sessionIds: ['a', 'cold'] }, {
+    read(id) { reads++; return id === 'a' ? { row, identity } : undefined },
+    observe(listener) { observations++; changed = listener; return () => { observations--; changed = () => {} } },
+    navigate: (id, signal) => { navigations++; return navigate(id, signal) },
+  })
+  cleanup.push(() => bridge.close())
+  let subscriptionId = randomUUID()
+  const request = async (op: string, extra: object = {}) => {
+    const body = { version: 1, id: randomUUID(), hostId: bridge.grant.hostId, generation: 1,
+      token: bridge.grant.token, subscriptionId, op, ...extra }
+    return await new Promise<Reply>((resolve, reject) => {
+      const socket = connect(bridge.grant.socketPath)
+      let data = ''
+      socket.on('connect', () => socket.write(`${JSON.stringify(body)}\n`))
+      socket.on('data', (chunk) => { data += chunk.toString() })
+      socket.on('end', () => { try { resolve(JSON.parse(data) as Reply) } catch (error) { reject(error instanceof Error ? error : new Error(String(error))) } })
+      socket.on('error', reject)
+    })
+  }
+  return { bridge, request, stats: () => ({ reads, navigations, observations }),
+    replace: () => { identity = {} },
+    pulse: (pendingInput: number) => { row = { ...row, pendingInput }; changed('a') },
+    navigate: (next: MicroInputHost['navigate']) => { navigate = next },
+    renew: () => { const old = subscriptionId; subscriptionId = randomUUID(); return old },
+  }
+}
+
+it('authenticates before any metadata read or subscription and refuses activating subscribe', async () => {
+  const test = await fixture()
+  expect((await test.request('subscribe', { token: 'invalid', activate: false })).status).toBe('denied')
+  expect((await test.request('subscribe', { activate: true })).status).toBe('denied')
+  expect(test.stats()).toEqual({ reads: 0, navigations: 0, observations: 0 })
+  const baseline = await test.request('subscribe', { activate: false })
+  expect(baseline.status).toBe('ok')
+  expect(baseline.rows).toHaveLength(1)
+  expect(baseline.unavailableSessionIds).toEqual(['cold'])
+  expect(test.stats().navigations).toBe(0)
+})
+
+it('retains pending-only pulses between polls while running remains unchanged', async () => {
+  const test = await fixture()
+  const first = await test.request('subscribe', { activate: false })
+  test.pulse(1); test.pulse(0)
+  const next = await test.request('read', { after: first.cursor })
+  expect(next.changes.map(item => item.row.pendingInput)).toEqual([1, 0])
+  expect(next.changes.every(item => item.row.running)).toBe(true)
+})
+
+it('rejects old subscription close and a late open after replacement', async () => {
+  const test = await fixture()
+  await test.request('subscribe', { activate: false })
+  let settle!: (id: string) => void
+  test.navigate(() => new Promise((resolve) => { settle = resolve }))
+  const opening = test.request('open', { sessionId: 'a', workspaceId: 'w' })
+  while (test.stats().navigations === 0) await new Promise(resolve => setTimeout(resolve, 1))
+  await test.request('close')
+  const old = test.renew()
+  await test.request('subscribe', { activate: false })
+  expect((await test.request('subscribe', { subscriptionId: old, activate: false })).status).toBe('stale')
+  expect((await test.request('close', { subscriptionId: old })).status).toBe('stale')
+  settle('a')
+  expect((await opening).status).toBe('stale')
+  expect(test.stats().observations).toBe(1)
+  expect((await test.request('read', { after: 0 })).status).toBe('ok')
+})
+
+it('requires selected-ID readback and the current workspace before confirmation', async () => {
+  const test = await fixture()
+  await test.request('subscribe', { activate: false })
+  expect((await test.request('open', { sessionId: 'a', workspaceId: 'other' })).status).toBe('stale')
+  expect(test.stats().navigations).toBe(0)
+  test.navigate(async () => 'other')
+  expect((await test.request('open', { sessionId: 'a', workspaceId: 'w' })).status).toBe('unconfirmed')
+  test.navigate(async () => 'a')
+  expect(await test.request('open', { sessionId: 'a', workspaceId: 'w' })).toMatchObject({ status: 'confirmed', selected: 'a' })
+})
+
+it('rejects same-ID owner replacement and explicitly reports journal overflow', async () => {
+  const test = await fixture()
+  const baseline = await test.request('subscribe', { activate: false })
+  for (let index = 0; index < 1025; index++) test.pulse(index % 2 + 1)
+  expect((await test.request('read', { after: baseline.cursor })).status).toBe('gap')
+  test.replace()
+  expect((await test.request('open', { sessionId: 'a', workspaceId: 'w' })).status).toBe('stale')
+})
+
+it('closing the bridge owns only its listener and endpoint', async () => {
+  const test = await fixture()
+  await test.request('subscribe', { activate: false })
+  await test.request('close')
+  expect(test.stats().observations).toBe(0)
+  expect((await test.request('read', { after: 0 })).status).toBe('denied')
+  expect((await test.request('subscribe', { activate: false })).rows).toHaveLength(1)
+})
+
+
+it('isolates optional bridge setup failure from its Host', async () => {
+  let reads = 0
+  const host: MicroInputHost = {
+    read: () => { reads++; return undefined },
+    observe: () => () => {},
+    navigate: () => Promise.resolve(undefined),
+  }
+  await expect(startOptionalMicroInputBridge('/missing-micro-input-config', host)).resolves.toBeUndefined()
+  expect(reads).toBe(0)
+  const next = await fixture()
+  expect((await next.request('subscribe', { activate: false })).status).toBe('ok')
+})
