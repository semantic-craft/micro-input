--- /dev/null
+++ b/apps/desktop-host/tests/micro-input.spec.ts
@@ -0,0 +1,312 @@
+import { randomUUID } from 'node:crypto'
+import { connect } from 'node:net'
+import { chmod, mkdtemp, rm } from 'node:fs/promises'
+import { join } from 'node:path'
+import { afterEach, expect, it } from 'vitest'
+import { startMicroInputBridge, startOptionalMicroInputBridge, type MicroInputRow, type MicroInputHost } from '../src/micro-input.ts'
+
+interface Reply {
+  status: string
+  cursor: number
+  rows: MicroInputRow[]
+  changes: { sequence: number; row: MicroInputRow }[]
+  unavailableSessionIds: string[]
+  selected?: string
+  sessionId?: string
+  workspaceId?: string
+  requestId?: string
+  delivery?: string
+  expectedTurn?: number
+  currentTurn?: number | null
+  queuedCount?: number
+  reasonCode?: string
+  duplicate?: boolean
+}
+const cleanup: (() => Promise<void>)[] = []
+afterEach(async () => { for (const stop of cleanup.splice(0).reverse()) await stop() })
+async function fixture(withAtomicCancel = true) {
+  const directory = await mkdtemp(join(process.env.MI_DSH_TEST_ROOT ?? '/tmp', 'mi-dsh-'))
+  await chmod(directory, 0o700)
+  cleanup.push(() => rm(directory, { recursive: true, force: true }))
+  let reads = 0, navigations = 0, observations = 0, creates = 0, prompts = 0, cancels = 0
+  let selected: string | undefined
+  const identities = new Map<string, object>([['a', {}], ['b', {}]])
+  const state = new Map<string, MicroInputRow>([
+    ['a', { sessionId: 'a', workspaceId: 'w', title: 'Session A', active: true, running: true, pendingInput: 0, currentTurn: 1, queuedCount: 0 }],
+    ['b', { sessionId: 'b', workspaceId: 'w-b', title: 'Session B', active: true, running: true, pendingInput: 0, currentTurn: 1, queuedCount: 0 }],
+  ])
+  let changed: (id: string) => void = () => {}
+  let navigate: MicroInputHost['navigate'] = async (id) => { selected = id; return id }
+  const host: MicroInputHost = {
+    read(id) {
+      reads++
+      const row = state.get(id)
+      return row === undefined ? undefined : { row, identity: identities.get(id)! }
+    },
+    observe(listener) { observations++; changed = listener; return () => { observations--; changed = () => {} } },
+    navigate: (id, signal) => { navigations++; return navigate(id, signal) },
+    selected: () => selected,
+    async create(workspaceId) {
+      creates++
+      const createdId = `created-${creates}`
+      identities.set(createdId, {})
+      state.set(createdId, {
+        sessionId: createdId,
+        workspaceId,
+        title: createdId,
+        active: true,
+        running: false,
+        pendingInput: 0,
+        currentTurn: null,
+        queuedCount: 0,
+      })
+      changed(createdId)
+      return createdId
+    },
+    async prompt(sessionId, mode) {
+      prompts++
+      const row = state.get(sessionId)
+      if (row === undefined) return { status: 'unavailable', reasonCode: 'session.notFound' }
+      if (mode === 'steer' && (!row.running || row.currentTurn === null)) {
+        return { status: 'unavailable', reasonCode: 'session.steerUnavailable' }
+      }
+      const next = { ...row, queuedCount: row.queuedCount + 1 }
+      state.set(sessionId, next)
+      changed(sessionId)
+      return {
+        status: mode === 'steer' ? 'steered' : 'queued',
+        delivery: mode,
+        currentTurn: next.currentTurn,
+        queuedCount: next.queuedCount,
+      }
+    },
+    ...(withAtomicCancel ? {
+      cancel(sessionId, expectedTurn) {
+        const row = state.get(sessionId)
+        if (row === undefined) return { status: 'unavailable', reasonCode: 'session.notFound' }
+        if (row.running && row.currentTurn === null) {
+          return { status: 'denied', reasonCode: 'guard.unprovableTurnAtomicity' }
+        }
+        if (!row.running || row.currentTurn === null) {
+          return { status: 'noop', reasonCode: 'guard.notRunning', currentTurn: null, queuedCount: row.queuedCount }
+        }
+        if (row.currentTurn !== expectedTurn) {
+          return { status: 'noop', reasonCode: 'guard.turnChanged', currentTurn: row.currentTurn, queuedCount: row.queuedCount }
+        }
+        cancels++
+        const next: MicroInputRow = { ...row, running: false, currentTurn: null }
+        state.set(sessionId, next)
+        changed(sessionId)
+        return next.queuedCount > 0
+          ? { status: 'cancelledQueueRemaining', currentTurn: null, queuedCount: next.queuedCount }
+          : { status: 'cancelled', currentTurn: null, queuedCount: 0 }
+      },
+    } : {}),
+  }
+  const bridge = await startMicroInputBridge({ directory, sessionIds: ['a', 'b', 'cold'] }, host)
+  cleanup.push(() => bridge.close())
+  let subscriptionId = randomUUID()
+  const request = async (op: string, extra: object = {}) => {
+    const body = { version: 1, id: randomUUID(), hostId: bridge.grant.hostId, generation: 1,
+      token: bridge.grant.token, subscriptionId, op, ...extra }
+    return await new Promise<Reply>((resolve, reject) => {
+      const socket = connect(bridge.grant.socketPath)
+      let data = ''
+      socket.on('connect', () => socket.write(`${JSON.stringify(body)}\n`))
+      socket.on('data', (chunk) => { data += chunk.toString() })
+      socket.on('end', () => { try { resolve(JSON.parse(data) as Reply) } catch (error) { reject(error instanceof Error ? error : new Error(String(error))) } })
+      socket.on('error', reject)
+    })
+  }
+  return {
+    bridge,
+    request,
+    stats: () => ({ reads, navigations, observations, creates, prompts, cancels }),
+    replace: () => { identities.set('a', {}) },
+    pulse: (pendingInput: number) => {
+      const row = state.get('a')!
+      state.set('a', { ...row, pendingInput })
+      changed('a')
+    },
+    setTurn: (id: string, currentTurn: number | null, running = currentTurn !== null) => {
+      const row = state.get(id)!
+      state.set(id, { ...row, currentTurn, running })
+      changed(id)
+    },
+    select: (id: string | undefined) => { selected = id },
+    navigate: (next: MicroInputHost['navigate']) => { navigate = next },
+    renew: () => { const old = subscriptionId; subscriptionId = randomUUID(); return old },
+  }
