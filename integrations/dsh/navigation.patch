+++ b/apps/desktop-host/tests/micro-input-host.spec.ts
@@ -0,0 +1,141 @@
+import { Context, FiberState } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SessionTitleService from '@deepseek-ai/dsh-session-title'
+import { ToolCallId, createToolResultMessage } from '@deepseek-ai/dsh-llm'
+import ApprovalService, { type ApprovalOutcome } from '@deepseek-ai/dsh-user-approval'
+import UserQuestionService from '@deepseek-ai/dsh-user-questions'
+import { afterEach, expect, it, vi } from 'vitest'
+import { microInputHost } from '../src/micro-input-host.ts'
+import { startOptionalMicroInputBridge } from '../src/micro-input.ts'
+
+const contexts: Context[] = []
+afterEach(async () => { for (const ctx of contexts.splice(0)) await ctx.fiber.dispose() })
+async function fixture(late = false, titleFirst = false) {
+  const ctx = new Context(); contexts.push(ctx)
+  await ctx.plugin(SessionStore)
+  const early = late ? ctx.sessions.create(SessionId('s')) : undefined
+  if (early !== undefined) early.append('turn/start', { turn: 1 })
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(ApprovalService)
+  const titleConfig = { fallbackMaxWords: 8, fallbackMaxBytes: 64, maxTitleBytes: 256 }
+  if (titleFirst) await ctx.plugin(SessionTitleService, titleConfig)
+  await ctx.plugin(UserQuestionService)
+  if (!titleFirst) await ctx.plugin(SessionTitleService, titleConfig)
+  const session = early ?? ctx.sessions.create(SessionId('s'))
+  if (!late) session.append('turn/start', { turn: 1 })
+  const agent = { id: session.id, session, status: 'running', inbox: { nextStep: [], nextTurn: [] } } as unknown as Agent
+  const agents = new Map<string, Agent>([[session.id, agent]])
+  const workspace = { id: 'w', sessionIds: [session.id] }
+  ctx.provide('agents', { get: (id: string) => agents.get(id), roots: () => [...agents.values()] } as never)
+  ctx.provide('workspaceRegistry', { list: () => [workspace] } as never)
+  const source = microInputHost(ctx, () => Promise.resolve(undefined))
+  return { ctx, session, agent, workspace, source }
+}
+
+it('bootstraps existing approval and observes settlement without an Agent status transition or history read', async () => {
+  const test = await fixture()
+  const started = Promise.withResolvers<undefined>()
+  let settle!: (outcome: ApprovalOutcome) => void
+  test.ctx.on('approval/request', () => new Promise<ApprovalOutcome>((resolve) => { settle = resolve; started.resolve(undefined) }))
+  const pending = test.ctx.approval.request({ agent: test.agent, toolName: 'synthetic' })
+  await started.promise
+  const snapshot = vi.spyOn(test.session, 'snapshotEvents').mockImplementation(() => { throw new Error('body traversal') })
+  const event = vi.spyOn(test.session, 'eventAt').mockImplementation(() => { throw new Error('body traversal') })
+  expect(test.source.read('s')?.row).toMatchObject({ pendingInput: 1, currentTurn: 1, queuedCount: 0 })
+  expect(test.source.read('cold')).toBeUndefined()
+  snapshot.mockRestore(); event.mockRestore()
+  const changes: number[] = []
+  const stop = test.source.observe(() => { changes.push(test.source.read('s')?.row.pendingInput ?? -1) })
+  settle('allowed-once')
+  await pending
+  expect(changes).toContain(0)
+  expect(test.source.read('s')?.row.running).toBe(true)
+  stop()
+})
+
+it('reports an unmaterialized loaded Session unavailable without traversing history', async () => {
+  const test = await fixture(true)
+  const snapshot = vi.spyOn(test.session, 'snapshotEvents').mockImplementation(() => { throw new Error('body traversal') })
+  const event = vi.spyOn(test.session, 'eventAt').mockImplementation(() => { throw new Error('body traversal') })
+  expect(test.source.read('s')).toBeUndefined()
+  expect(snapshot).not.toHaveBeenCalled()
+  expect(event).not.toHaveBeenCalled()
+  snapshot.mockRestore(); event.mockRestore()
+})
+
+it('optional bridge failure leaves the original Host and Session usable', async () => {
+  const test = await fixture()
+  const initial = test.ctx.fiber.state
+  expect(await startOptionalMicroInputBridge('/absent-config', test.source)).toBeUndefined()
+  expect(test.ctx.fiber.state).toBe(initial)
+  expect(test.ctx.fiber.state).not.toBe(FiberState.DISPOSED)
+  expect(test.ctx.sessions.get(test.session.id)).toBe(test.session)
+  expect(test.source.read('s')?.row.sessionId).toBe('s')
+})
+
+it.each([true, false])('observes complete projection cuts with title-first=%s', async (titleFirst) => {
+  const test = await fixture(false, titleFirst)
+  test.session.append('session/title', { title: 'Synthetic', messageSeqs: [], source: { kind: 'user' } })
+  const rows: { pendingInput: number; title: string }[] = []
+  const stop = test.source.observe(() => {
+    const row = test.source.read('s')?.row
+    if (row !== undefined) rows.push(row)
+  })
+  test.session.append('step/start', { turn: 1, step: 1 })
+  test.session.append('request/header', { reason: 'initial', header: {
+    config: { provider: 'synthetic', model: 'synthetic' }, tools: [{
+      name: 'ask_user_question', description: 'Synthetic',
+      parameters: { type: 'object', properties: { questions: { type: 'array' }, timeout: { type: 'integer' } } },
+    }],
+  } })
+  const callId = ToolCallId('synthetic-question')
+  test.session.append('tool/call', { turn: 1, step: 1, callId, name: 'ask_user_question',
+    arguments: JSON.stringify({ questions: [{ id: 'q', question: 'Synthetic' }] }),
+  })
+  test.session.append('tool/result', { turn: 1, step: 1,
+    message: createToolResultMessage({ callId, content: [{ type: 'text', text: 'cancelled' }], isError: true }),
+  }, { surfaceOp: 'append' })
+  expect(rows.map(row => row.pendingInput)).toContain(1)
+  expect(rows.at(-1)?.pendingInput).toBe(0)
+  expect(rows.every(row => row.title === 'Synthetic')).toBe(true)
+  stop()
+})
+
+it('executes create, prompt queue/steer deduplication, and atomic turn-checked cancel without history reads', async () => {
+  const test = await fixture()
+  const signal = new AbortController().signal
+  const snapshot = vi.spyOn(test.session, 'snapshotEvents').mockImplementation(() => { throw new Error('body traversal') })
+  const event = vi.spyOn(test.session, 'eventAt').mockImplementation(() => { throw new Error('body traversal') })
+
+  const createdId = await test.source.create('w', signal)
+  expect(createdId).toBe('dsh-created-1')
+  expect(test.source.read('dsh-created-1')?.row).toMatchObject({
+    sessionId: 'dsh-created-1', workspaceId: 'w', active: true, running: false, currentTurn: null, queuedCount: 0,
+  })
+
+  const steered = await test.source.prompt('s', 'steer', 'steer step', 'req-1', signal)
+  expect(steered).toEqual({ status: 'steered', delivery: 'steer', currentTurn: 1, queuedCount: 1 })
+  const duplicateSteer = await test.source.prompt('s', 'steer', 'steer step', 'req-1', signal)
+  expect(duplicateSteer).toEqual({ status: 'steered', delivery: 'steer', currentTurn: 1, queuedCount: 1 })
+
+  const queued = await test.source.prompt('s', 'queue', 'next turn task', 'req-2', signal)
+  expect(queued).toEqual({ status: 'queued', delivery: 'queue', currentTurn: 1, queuedCount: 2 })
+  expect(test.source.read('s')?.row).toMatchObject({ currentTurn: 1, queuedCount: 2 })
+
+  // Advance to turn 2 and verify old Stop(expectedTurn=1) does zero cancellation
+  test.session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+  test.session.append('turn/start', { turn: 2 })
+  expect(test.source.cancel('s', 1)).toEqual({
+    status: 'noop', reasonCode: 'guard.turnChanged', currentTurn: 2, queuedCount: 2,
+  })
+  expect(test.source.read('s')?.row).toMatchObject({ running: true, currentTurn: 2, queuedCount: 2 })
+
+  // Matching expectedTurn=2 cancels turn 2 and reports cancelledQueueRemaining
+  expect(test.source.cancel('s', 2)).toEqual({
+    status: 'cancelledQueueRemaining', currentTurn: null, queuedCount: 2,
+  })
+  expect(test.source.read('s')?.row).toMatchObject({ running: false, currentTurn: null, queuedCount: 2 })
+  snapshot.mockRestore(); event.mockRestore()
+})
diff --git a/apps/desktop-host/tests/micro-input.spec.ts b/apps/desktop-host/tests/micro-input.spec.ts
