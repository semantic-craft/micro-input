+import assert from "node:assert/strict";
+import { mkdir, readFile, rmdir } from "node:fs/promises";
+import { resolve, join } from "node:path";
+import { startMicroInputSocket } from "../packages/desktop/src/main/micro-input/socket.ts";
+import { focusConfirmedMicroInputWindow } from "../packages/desktop/src/main/micro-input/confirmation.ts";
+import type {
+  MicroInputRequest,
+  MicroInputResponse,
+} from "../packages/shared/src/micro-input/contract.ts";
+
+const directory = resolve(process.argv[2]!);
+await mkdir(directory, { mode: 0o700 });
+const options = {
+  directory,
+  scopes: [{ workspacePath: "/fixture" }],
+  dispatch: async (): Promise<MicroInputResponse> => {
+    throw new Error("unused");
+  },
+};
+let one: Awaited<ReturnType<typeof startMicroInputSocket>> | undefined;
+let two: Awaited<ReturnType<typeof startMicroInputSocket>> | undefined;
+try {
+  one = await startMicroInputSocket(options);
+  await assert.rejects(startMicroInputSocket(options));
+  const closing = one.dispose();
+  const contender = startMicroInputSocket(options).catch(() => undefined);
+  await closing;
+  two = (await contender) ?? (await startMicroInputSocket(options));
+  await one.dispose();
+  assert.equal(
+    JSON.parse(await readFile(join(directory, "zcode-grant.json"), "utf8")).instanceId,
+    two.grant.instanceId,
+  );
+} finally {
+  await one?.dispose();
+  await two?.dispose();
+  await rmdir(directory);
+}
+const request: MicroInputRequest = {
+  version: 1,
+  id: "1",
+  instanceId: "fixture",
+  generation: 1,
+  token: "fixture",
+  op: "open",
+  scope: { workspacePath: "/a" },
+  target: { workspacePath: "/a", taskId: "t" },
+};
+const response: MicroInputResponse = {
+  version: 1,
+  id: "1",
+  instanceId: "fixture",
+  generation: 1,
+  status: "confirmed",
+  selected: request.target,
+};
+const effects: string[] = [];
+const window = {
+  isDestroyed: () => false,
+  isMinimized: () => true,
+  restore: () => {
+    effects.push("restore");
+  },
+  show: () => {
+    effects.push("show");
+  },
+  focus: () => {
+    effects.push("focus");
+  },
+};
+assert.equal(focusConfirmedMicroInputWindow(request, response, window), true);
+assert.deepEqual(effects, ["restore", "show", "focus"]);
+effects.length = 0;
+assert.equal(
+  focusConfirmedMicroInputWindow(request, { ...response, generation: 2 }, window),
+  false,
+);
+assert.equal(
+  focusConfirmedMicroInputWindow(
+    request,
+    { ...response, selected: { workspacePath: "/b", taskId: "t" } },
+    window,
+  ),
+  false,
+);
+assert.equal(
+  focusConfirmedMicroInputWindow(request, { ...response, status: "unconfirmed" }, window),
+  false,
+);
+assert.deepEqual(effects, []);
+console.log("socket ownership interleaving and exact confirmed window focus: PASS");
diff --git a/scripts/micro-input-fixture.ts b/scripts/micro-input-fixture.ts
