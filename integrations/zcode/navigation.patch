+++ b/packages/shared/src/micro-input/contract.ts
@@ -0,0 +1,240 @@
+import { z } from "zod";
+
+const identifier = z
+  .string()
+  .min(1)
+  .max(4096)
+  .refine((value) => value.trim() === value && !value.includes("\0"));
+const promptText = z
+  .string()
+  .min(1)
+  .max(32768)
+  .refine((value) => value.trim().length > 0 && !value.includes("\0"));
+const deliverySchema = z.enum(["startNow", "queue", "guide"]);
+export const microInputScopeSchema = z
+  .object({
+    workspacePath: identifier,
+    workspaceIdentity: identifier.optional(),
+    sourceServerId: identifier.optional(),
+    remoteSessionId: identifier.optional(),
+  })
+  .strict();
+export const microInputAddressSchema = microInputScopeSchema.extend({ taskId: identifier });
+export const microInputRequestSchema = z
+  .object({
+    version: z.literal(1),
+    id: identifier,
+    token: identifier,
+    instanceId: identifier,
+    generation: z.number().int().positive().safe(),
+    op: z.enum(["list", "open", "create", "send", "stop", "query"]),
+    scope: microInputScopeSchema,
+    target: microInputAddressSchema.optional(),
+    commandId: identifier.optional(),
+    clientId: identifier.optional(),
+    sessionId: identifier.optional(),
+    text: promptText.optional(),
+    requestedDelivery: deliverySchema.optional(),
+    executionId: identifier.optional(),
+  })
+  .strict()
+  .refine((request) => {
+    switch (request.op) {
+      case "list":
+        return (
+          request.target === undefined &&
+          request.commandId === undefined &&
+          request.clientId === undefined &&
+          request.sessionId === undefined &&
+          request.text === undefined &&
+          request.requestedDelivery === undefined &&
+          request.executionId === undefined
+        );
+      case "open":
+        return (
+          request.target !== undefined &&
+          request.commandId === undefined &&
+          request.clientId === undefined &&
+          request.sessionId === undefined &&
+          request.text === undefined &&
+          request.requestedDelivery === undefined &&
+          request.executionId === undefined
+        );
+      case "create":
+        return (
+          request.target === undefined &&
+          request.commandId !== undefined &&
+          request.clientId !== undefined &&
+          request.requestedDelivery === undefined &&
+          request.executionId === undefined
+        );
+      case "send":
+        return (
+          request.target !== undefined &&
+          request.commandId !== undefined &&
+          request.clientId !== undefined &&
+          request.sessionId === undefined &&
+          request.text !== undefined &&
+          request.executionId === undefined
+        );
+      case "stop":
+        return (
+          request.target !== undefined &&
+          request.commandId !== undefined &&
+          request.clientId !== undefined &&
+          request.sessionId === undefined &&
+          request.text === undefined &&
+          request.requestedDelivery === undefined &&
+          request.executionId !== undefined
+        );
+      case "query":
+        return (
+          request.commandId !== undefined &&
+          request.sessionId === undefined &&
+          request.text === undefined &&
+          request.requestedDelivery === undefined &&
+          request.executionId === undefined
+        );
+    }
+  });
+export const microInputGrantSchema = z
+  .object({
+    version: z.literal(1),
+    socketPath: identifier,
+    token: identifier,
+    instanceId: identifier,
+    generation: z.number().int().positive().safe(),
+    scopes: z.array(microInputScopeSchema).min(1).max(64),
+  })
+  .strict();
+export type MicroInputScope = z.infer<typeof microInputScopeSchema>;
+export type MicroInputAddress = z.infer<typeof microInputAddressSchema>;
+export type MicroInputRequest = z.infer<typeof microInputRequestSchema>;
+export type MicroInputGrant = z.infer<typeof microInputGrantSchema>;
+export type MicroInputDelivery = z.infer<typeof deliverySchema>;
+export type MicroInputStatus =
+  | "ok"
+  | "confirmed"
+  | "started"
+  | "queued"
+  | "steered"
+  | "stopped"
+  | "noop"
+  | "unknown"
+  | "denied"
+  | "stale"
+  | "unavailable"
+  | "unconfirmed";
+export interface MicroInputRow {
+  address: MicroInputAddress;
+  title: string;
+  liveStatus: string;
+  executionId?: string;
+}
+export interface MicroInputResponse {
+  version: 1;
+  id: string;
+  instanceId: string;
+  generation: number;
+  status: MicroInputStatus;
+  rows?: MicroInputRow[];
+  selected?: MicroInputAddress | null;
+  commandId?: string;
+  duplicate?: boolean;
+  delivery?: MicroInputDelivery;
+  executionId?: string;
+  reasonCode?: string;
+}
+export type MicroInputCommandEnvelope =
+  | {
+      commandId: string;
+      clientId: string;
+      sessionId: null;
+      type: "createSession";
+      payload: {
+        workspaceId: string;
+        sessionId?: string;
+        firstInput?: { text: string };
+      };
+      issuedAt: number;
+    }
+  | {
+      commandId: string;
+      clientId: string;
+      sessionId: string;
+      type: "sendText";
+      payload: {
+        text: string;
+        requestedDelivery?: MicroInputDelivery;
+      };
+      issuedAt: number;
+    }
+  | {
+      commandId: string;
+      clientId: string;
+      sessionId: string;
+      type: "stop";
+      payload: {
+        expectedForegroundExecutionId: string;
+      };
+      issuedAt: number;
+    };
+export interface MicroInputCommandAck {
+  commandId: string;
+  status: "accepted" | "noop" | "duplicate" | "stale" | "rejected" | "failed";
+  reasonCode?: string;
+  result?:
+    | {
+        type: "createSession";
+        sessionId: string;
+        input?: {
+          delivery: MicroInputDelivery;
+          inputId: string;
+        };
+      }
+    | {
+        type: "inputAccepted";
+        delivery: MicroInputDelivery;
+        inputId: string;
+      };
+}
+export function sameMicroInputScope(a: MicroInputScope, b: MicroInputScope): boolean {
+  return (
+    a.workspacePath === b.workspacePath &&
+    a.workspaceIdentity === b.workspaceIdentity &&
+    a.sourceServerId === b.sourceServerId &&
+    a.remoteSessionId === b.remoteSessionId
+  );
+}
+export function sameMicroInputAddress(a: MicroInputAddress | null, b: MicroInputAddress): boolean {
+  return a !== null && sameMicroInputScope(a, b) && a.taskId === b.taskId;
+}
+export function authorizeMicroInput(
+  raw: unknown,
+  grant: MicroInputGrant,
+): MicroInputRequest | null {
+  const parsed = microInputRequestSchema.safeParse(raw);
+  if (!parsed.success) return null;
+  const request = parsed.data;
+  if (
+    request.token !== grant.token ||
+    !grant.scopes.some((scope) => sameMicroInputScope(scope, request.scope)) ||
+    (request.target && !sameMicroInputScope(request.target, request.scope))
+  )
+    return null;
+  return request;
+}
+export interface MicroInputRendererBridge {
+  listen(
+    handler: (
+      request: MicroInputRequest,
+      grant: MicroInputGrant,
+      isCurrent: () => boolean,
+    ) => Promise<MicroInputResponse>,
+  ): () => void;
+}
+declare global {
+  interface Window {
+    microInputNavigation?: MicroInputRendererBridge;
+  }
+}
