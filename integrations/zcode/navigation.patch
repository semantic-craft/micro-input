diff --git a/packages/desktop/src/main/micro-input/CONTRACT.md b/packages/desktop/src/main/micro-input/CONTRACT.md
new file mode 100644
index 00000000..7aac8585
--- /dev/null
+++ b/packages/desktop/src/main/micro-input/CONTRACT.md
@@ -0,0 +1,3 @@
+# Micro Input navigation
+
+Owns the private Unix socket and one renderer capability. Explicit scoped configuration enables the bridge; default startup does nothing. Renderer replacement, cancellation and window closure revoke in-flight requests and remove socket/grant files. An occupied socket is never removed or taken over. Window focus activates only when `open`, `create`, or reconciled `create` confirms the exact selected workspace/session address.
diff --git a/packages/desktop/src/main/micro-input/confirmation.ts b/packages/desktop/src/main/micro-input/confirmation.ts
new file mode 100644
index 00000000..9467e52a
--- /dev/null
+++ b/packages/desktop/src/main/micro-input/confirmation.ts
@@ -0,0 +1,38 @@
+import {
+  sameMicroInputAddress,
+  sameMicroInputScope,
+  type MicroInputRequest,
+  type MicroInputResponse,
+} from "@zcode/shared";
+
+export function focusConfirmedMicroInputWindow(
+  request: MicroInputRequest,
+  response: MicroInputResponse,
+  window: {
+    isDestroyed(): boolean;
+    isMinimized(): boolean;
+    restore(): void;
+    show(): void;
+    focus(): void;
+  },
+): boolean {
+  const selectedMatches =
+    request.op === "open"
+      ? Boolean(request.target && sameMicroInputAddress(response.selected ?? null, request.target))
+      : request.op === "create" || (request.op === "query" && !request.target)
+        ? Boolean(response.selected && sameMicroInputScope(response.selected, request.scope))
+        : false;
+  if (
+    response.status !== "confirmed" ||
+    !selectedMatches ||
+    response.id !== request.id ||
+    response.instanceId !== request.instanceId ||
+    response.generation !== request.generation ||
+    window.isDestroyed()
+  )
+    return false;
+  if (window.isMinimized()) window.restore();
+  window.show();
+  window.focus();
+  return true;
+}
