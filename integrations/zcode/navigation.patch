index 00000000..5721fe20
--- /dev/null
+++ b/packages/desktop/src/main/micro-input/electronBridge.ts
@@ -0,0 +1,135 @@
+import { focusConfirmedMicroInputWindow } from "./confirmation.js";
+import { ipcMain, type BrowserWindow } from "electron";
+import { lstat, readFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import { join, isAbsolute } from "node:path";
+import { z } from "zod";
+import {
+  microInputScopeSchema,
+  type MicroInputRequest,
+  type MicroInputResponse,
+} from "@zcode/shared";
+import { startMicroInputSocket } from "./socket.js";
+
+const configSchema = z
+  .object({
+    scopes: z.array(microInputScopeSchema).min(1).max(64),
+    directory: z.string().optional(),
+  })
+  .strict();
+let claimed = false;
+export function installMicroInputBridge(win: BrowserWindow): void {
+  const configPath = process.env.MI_ZCODE_BRIDGE_CONFIG;
+  if (!configPath || claimed || !isAbsolute(configPath)) return;
+  claimed = true;
+  let server: Awaited<ReturnType<typeof startMicroInputSocket>> | undefined;
+  let generation = 0;
+  let closed = false;
+  const pending = new Map<
+    string,
+    { resolve: (value: MicroInputResponse) => void; reject: () => void }
+  >();
+  let lifecycle = Promise.resolve();
+  const invalidate = () => {
+    generation++;
+    for (const request of pending.values()) request.reject();
+    pending.clear();
+    lifecycle = lifecycle.then(async () => {
+      await server?.dispose();
+      server = undefined;
+    });
+  };
+  const ready = (event: Electron.IpcMainEvent) => {
+    if (event.sender !== win.webContents || closed) return;
+    invalidate();
+    const captured = generation;
+    lifecycle = lifecycle
+      .then(async () => {
+        if (closed || generation !== captured) return;
+        const stat = await lstat(configPath);
+        if (
+          !stat.isFile() ||
+          stat.isSymbolicLink() ||
+          stat.uid !== process.getuid?.() ||
+          (stat.mode & 0o077) !== 0 ||
+          stat.size > 65536
+        )
+          return;
+        const config = configSchema.parse(JSON.parse(await readFile(configPath, "utf8")));
+        if (closed || generation !== captured) return;
+        server = await startMicroInputSocket({
+          directory:
+            config.directory ?? join(homedir(), "Library", "Application Support", "MicroInput"),
+          scopes: config.scopes,
+          dispatch: (request, grant, signal) =>
+            new Promise((resolve, reject) => {
+              if (closed || generation !== captured || signal.aborted || pending.has(request.id)) {
+                reject();
+                return;
+              }
+              const cleanup = () => {
+                pending.delete(request.id);
+                signal.removeEventListener("abort", cancel);
+              };
+              const cancel = () => {
+                cleanup();
+                if (!win.isDestroyed()) win.webContents.send("micro-input:cancel", request.id);
+                reject();
+              };
+              pending.set(request.id, {
+                resolve: (result) => {
+                  cleanup();
+                  resolve(result);
+                },
+                reject: cancel,
+              });
+              signal.addEventListener("abort", cancel, { once: true });
+              win.webContents.send("micro-input:request", request, grant);
+            }),
+        });
+      })
+      .catch(() => {});
+  };
+  const reply = (
+    event: Electron.IpcMainEvent,
+    request: MicroInputRequest,
+    response: MicroInputResponse,
+  ) => {
+    if (
+      event.sender !== win.webContents ||
+      !server ||
+      closed ||
+      response.instanceId !== server.grant.instanceId ||
+      response.generation !== server.grant.generation ||
+      response.id !== request.id ||
+      response.version !== 1
+    )
+      return;
+    const active = pending.get(request.id);
+    if (!active) return;
+    if (
+      response.status === "confirmed" &&
+      !focusConfirmedMicroInputWindow(request, response, win)
+    ) {
+      active.resolve({
+        version: 1,
+        id: request.id,
+        instanceId: response.instanceId,
+        generation: response.generation,
+        status: "unconfirmed",
+      });
+      return;
+    }
+    active.resolve(response);
+  };
+  ipcMain.on("micro-input:ready", ready);
+  ipcMain.on("micro-input:reply", reply);
+  win.webContents.on("did-start-navigation", invalidate);
+  win.webContents.on("render-process-gone", invalidate);
+  win.once("closed", () => {
+    closed = true;
+    invalidate();
+    ipcMain.removeListener("micro-input:ready", ready);
+    ipcMain.removeListener("micro-input:reply", reply);
+  });
+}
