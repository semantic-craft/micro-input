diff --git a/packages/desktop/src/main/micro-input/socket.ts b/packages/desktop/src/main/micro-input/socket.ts
new file mode 100644
index 00000000..422f12dd
--- /dev/null
+++ b/packages/desktop/src/main/micro-input/socket.ts
@@ -0,0 +1,148 @@
+import { createServer, type Socket } from "node:net";
+import { chmod, lstat, mkdir, open, rename, unlink, rmdir } from "node:fs/promises";
+import { join } from "node:path";
+import { randomBytes, randomUUID } from "node:crypto";
+import {
+  authorizeMicroInput,
+  type MicroInputGrant,
+  type MicroInputRequest,
+  type MicroInputResponse,
+  type MicroInputScope,
+} from "@zcode/shared";
+
+export async function startMicroInputSocket(options: {
+  directory: string;
+  scopes: MicroInputScope[];
+  dispatch: (
+    request: MicroInputRequest,
+    grant: MicroInputGrant,
+    signal: AbortSignal,
+  ) => Promise<MicroInputResponse>;
+}) {
+  await mkdir(options.directory, { recursive: true, mode: 0o700 });
+  const directoryStat = await lstat(options.directory);
+  if (
+    !directoryStat.isDirectory() ||
+    directoryStat.isSymbolicLink() ||
+    directoryStat.uid !== process.getuid?.() ||
+    (directoryStat.mode & 0o077) !== 0
+  )
+    throw new Error("private bridge directory required");
+  const grant: MicroInputGrant = {
+    version: 1,
+    socketPath: join(options.directory, "zcode.sock"),
+    token: randomBytes(32).toString("hex"),
+    instanceId: randomUUID(),
+    generation: 1,
+    scopes: options.scopes,
+  };
+  if (Buffer.byteLength(grant.socketPath) > 100) throw new Error("bridge socket path too long");
+  const ownerPath = join(options.directory, ".zcode-owner");
+  await mkdir(ownerPath, { mode: 0o700 });
+  const clients = new Set<Socket>();
+  let disposed = false;
+  const server = createServer((socket) => {
+    clients.add(socket);
+    const abort = new AbortController();
+    let buffer = Buffer.alloc(0);
+    let accepted = false;
+    socket.setTimeout(2000, () => socket.destroy());
+    socket.on("error", () => {});
+    socket.once("close", () => {
+      clients.delete(socket);
+      abort.abort();
+    });
+    socket.on("data", (data) => {
+      if (accepted) {
+        socket.destroy();
+        return;
+      }
+      buffer = Buffer.concat([buffer, typeof data === "string" ? Buffer.from(data) : data]);
+      if (buffer.length > 65536) {
+        socket.destroy();
+        return;
+      }
+      const end = buffer.indexOf(10);
+      if (end < 0) return;
+      accepted = true;
+      if (end !== buffer.length - 1) {
+        socket.destroy();
+        return;
+      }
+      let raw: unknown;
+      try {
+        raw = JSON.parse(buffer.subarray(0, end).toString("utf8"));
+      } catch {
+        socket.destroy();
+        return;
+      }
+      const request = authorizeMicroInput(raw, grant);
+      const response = (status: MicroInputResponse["status"]): MicroInputResponse => ({
+        version: 1,
+        id: request?.id ?? "invalid",
+        instanceId: grant.instanceId,
+        generation: grant.generation,
+        status,
+      });
+      void (async () => {
+        let result = response("denied");
+        if (request) {
+          if (request.instanceId !== grant.instanceId || request.generation !== grant.generation)
+            result = response("stale");
+          else if (!disposed) {
+            try {
+              result = await options.dispatch(request, grant, abort.signal);
+            } catch {
+              result = response("unavailable");
+            }
+          }
+        }
+        if (disposed || abort.signal.aborted) return;
+        const output = JSON.stringify(result) + "\n";
+        if (Buffer.byteLength(output) > 1048576)
+          socket.end(JSON.stringify(response("unavailable")) + "\n");
+        else socket.end(output);
+      })();
+    });
+  });
+  try {
+    await new Promise<void>((resolve, reject) => {
+      server.once("error", reject);
+      server.listen(grant.socketPath, () => {
+        server.removeListener("error", reject);
+        resolve();
+      });
+    });
+  } catch (error) {
+    await rmdir(ownerPath);
+    throw error;
+  }
+  server.on("error", () => {});
+  const grantPath = join(options.directory, "zcode-grant.json");
+  try {
+    await chmod(grant.socketPath, 0o600);
+    const temporary = join(options.directory, `.grant-${randomUUID()}`);
+    const file = await open(temporary, "wx", 0o600);
+    try {
+      await file.writeFile(JSON.stringify(grant));
+    } finally {
+      await file.close();
+    }
+    await rename(temporary, grantPath);
+  } catch (error) {
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+    await rmdir(ownerPath);
+    throw error;
+  }
+  return {
+    grant,
+    async dispose() {
+      if (disposed) return;
+      disposed = true;
+      for (const client of clients) client.destroy();
+      await unlink(grantPath).catch(() => {});
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+      await rmdir(ownerPath);
+    },
+  };
+}
