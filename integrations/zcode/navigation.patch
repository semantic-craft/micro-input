--- /dev/null
+++ b/scripts/micro-input-fixture.ts
@@ -0,0 +1,385 @@
+import { createServer } from "node:net";
+import { chmod, mkdir, writeFile, unlink } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { startMicroInputSocket } from "../packages/desktop/src/main/micro-input/socket.ts";
+import { createMicroInputNavigation } from "../packages/ui/src/app-shell/micro-input/navigation.ts";
+import {
+  sameMicroInputScope,
+  type MicroInputCommandAck,
+  type MicroInputDelivery,
+  type MicroInputRow,
+} from "../packages/shared/src/micro-input/contract.ts";
+
+const { values } = parseArgs({
+  options: { directory: { type: "string" }, ttl: { type: "string", default: "120" } },
+});
+if (!values.directory) throw new Error("--directory required");
+const directory = resolve(values.directory);
+await mkdir(directory, { recursive: true, mode: 0o700 });
+const scopes = [
+  { workspacePath: "/synthetic/workspace-a" },
+  { workspacePath: "/synthetic/workspace-b" },
+];
+let rows: MicroInputRow[] = [];
+const { createTabStore } = await import("../packages/ui/src/store/tabStore.ts");
+const { useZCodeSessionStore } = await import("../packages/ui/src/store/zcodeSessionStore.ts");
+const { createMicroInputSelection } =
+  await import("../packages/ui/src/app-shell/micro-input/selection.ts");
+const tabs = createTabStore(null);
+for (const scope of scopes) tabs.getState().addTab(scope.workspacePath);
+let sourceGeneration = "source-1";
+let connected = true;
+let metadataReads = 0;
+let navigationCount = 0;
+let deleteDuringOpen = false;
+let rotateDuringOpen = false;
+let createCount = 0;
+let sendCount = 0;
+let stopCount = 0;
+let queryCount = 0;
+let delayNextCommandMs = 0;
+let holdNextCommandUnknown = false;
+const routingModeByTaskKey = new Map<string, "guide" | "queue">();
+const commandInbox = new Map<string, MicroInputCommandAck>();
+const heldUnknownCommands = new Map<string, MicroInputCommandAck>();
+const sentByTaskKey: Record<
+  string,
+  Array<{ commandId: string; textByteLen: number; delivery: MicroInputDelivery }>
+> = {};
+const stoppedByTaskKey: Record<string, string[]> = {};
+const commandIdsSeen: string[] = [];
+
+const taskKey = (workspacePath: string, taskId: string) => `${workspacePath}#${taskId}`;
+
+const reset = () => {
+  rows = scopes.map((scope) => ({
+    address: { ...scope, taskId: "same-task-id" },
+    title: "Same task",
+    liveStatus: "idle",
+  }));
+  for (const scope of scopes)
+    useZCodeSessionStore.getState().setActiveTaskId(scope.workspacePath, null);
+  connected = true;
+  metadataReads = 0;
+  navigationCount = 0;
+  deleteDuringOpen = false;
+  rotateDuringOpen = false;
+  createCount = 0;
+  sendCount = 0;
+  stopCount = 0;
+  queryCount = 0;
+  delayNextCommandMs = 0;
+  holdNextCommandUnknown = false;
+  routingModeByTaskKey.clear();
+  commandInbox.clear();
+  heldUnknownCommands.clear();
+  for (const key of Object.keys(sentByTaskKey)) delete sentByTaskKey[key];
+  for (const key of Object.keys(stoppedByTaskKey)) delete stoppedByTaskKey[key];
+  commandIdsSeen.length = 0;
+};
+reset();
+const selection = createMicroInputSelection(tabs, () => {
+  navigationCount++;
+});
+const handler = createMicroInputNavigation({
+  ...selection,
+  readIndex: async (scope) => {
+    metadataReads++;
+    if (!connected) throw new Error("offline");
+    return {
+      sourceGeneration,
+      rows: rows.filter((row) => sameMicroInputScope(row.address, scope)),
+    };
+  },
+  exists: async (address) => {
+    metadataReads++;
+    const exists = rows.some(
+      (row) => sameMicroInputScope(row.address, address) && row.address.taskId === address.taskId,
+    );
+    if (deleteDuringOpen) rows = rows.filter((row) => !sameMicroInputScope(row.address, address));
+    if (rotateDuringOpen) sourceGeneration += "-next";
+    return exists;
+  },
+  current: (scope) => {
+    const current = selection.current(scope);
+    return connected && current ? () => connected && current() : null;
+  },
+  sendCommand: async (scope, envelope) => {
+    if (!connected) throw new Error("offline");
+    commandIdsSeen.push(envelope.commandId);
+    const inboxKey = `${scope.workspacePath}:${envelope.sessionId ?? "null"}:${envelope.commandId}`;
+    const existing = commandInbox.get(inboxKey);
+    if (existing) {
+      return { ...existing, status: "duplicate" };
+    }
+    let ack: MicroInputCommandAck;
+    if (envelope.type === "createSession") {
+      createCount++;
+      const sessionId = envelope.payload.sessionId ?? `created-session-${createCount}`;
+      const liveStatus = envelope.payload.firstInput ? "running" : "idle";
+      const executionId = envelope.payload.firstInput ? `exec-create-${createCount}` : undefined;
+      if (
+        !rows.some(
+          (row) => sameMicroInputScope(row.address, scope) && row.address.taskId === sessionId,
+        )
+      ) {
+        rows.push({
+          address: { ...scope, taskId: sessionId },
+          title: `Created ${createCount}`,
+          liveStatus,
+          ...(executionId ? { executionId } : {}),
+        });
+      }
+      if (envelope.payload.firstInput) {
+        const key = taskKey(scope.workspacePath, sessionId);
+        sentByTaskKey[key] ??= [];
+        sentByTaskKey[key]!.push({
+          commandId: envelope.commandId,
+          textByteLen: Buffer.byteLength(envelope.payload.firstInput.text, "utf8"),
+          delivery: "startNow",
+        });
+      }
+      ack = {
+        commandId: envelope.commandId,
+        status: "accepted",
+        result: {
+          type: "createSession",
+          sessionId,
+          ...(envelope.payload.firstInput
+            ? { input: { delivery: "startNow", inputId: envelope.commandId } }
+            : {}),
+        },
+      };
+    } else if (envelope.type === "sendText") {
+      sendCount++;
+      const row = rows.find(
+        (candidate) =>
+          sameMicroInputScope(candidate.address, scope) &&
+          candidate.address.taskId === envelope.sessionId,
+      );
+      if (!row) {
+        return {
+          commandId: envelope.commandId,
+          status: "rejected",
+          reasonCode: "guard.sessionNotFound",
+        };
+      }
+      const key = taskKey(scope.workspacePath, envelope.sessionId);
+      const routingMode = routingModeByTaskKey.get(key) ?? "guide";
+      const requested = envelope.payload.requestedDelivery;
+      let delivery: MicroInputDelivery;
+      if (row.liveStatus === "running") {
+        if (requested === "guide" && routingMode === "guide") {
+          delivery = "guide";
+        } else if (requested === "startNow") {
+          delivery = "startNow";
+          row.executionId = `exec-preempt-${sendCount}`;
+        } else {
+          delivery = "queue";
+        }
+      } else {
+        delivery = "startNow";
+        row.liveStatus = "running";
+        row.executionId = row.executionId ?? `exec-turn-${sendCount}`;
+      }
+      sentByTaskKey[key] ??= [];
+      sentByTaskKey[key]!.push({
+        commandId: envelope.commandId,
+        textByteLen: Buffer.byteLength(envelope.payload.text, "utf8"),
+        delivery,
+      });
+      ack = {
+        commandId: envelope.commandId,
+        status: "accepted",
+        result: {
+          type: "inputAccepted",
+          delivery,
+          inputId: envelope.commandId,
+        },
+      };
+    } else {
+      stopCount++;
+      const row = rows.find(
+        (candidate) =>
+          sameMicroInputScope(candidate.address, scope) &&
+          candidate.address.taskId === envelope.sessionId,
+      );
+      if (
+        !row ||
+        row.liveStatus !== "running" ||
+        !row.executionId ||
+        row.executionId !== envelope.payload.expectedForegroundExecutionId
+      ) {
+        ack = {
+          commandId: envelope.commandId,
+          status: "noop",
+          reasonCode: "guard.stopTargetChanged",
+        };
+      } else {
+        const key = taskKey(scope.workspacePath, envelope.sessionId);
+        stoppedByTaskKey[key] ??= [];
+        stoppedByTaskKey[key]!.push(row.executionId);
+        row.liveStatus = "completed";
+        delete row.executionId;
+        ack = {
+          commandId: envelope.commandId,
+          status: "accepted",
+        };
+      }
+    }
+    if (holdNextCommandUnknown) {
+      holdNextCommandUnknown = false;
+      heldUnknownCommands.set(inboxKey, ack);
+    } else {
+      commandInbox.set(inboxKey, ack);
+    }
+    if (delayNextCommandMs > 0) {
+      const waitMs = delayNextCommandMs;
+      delayNextCommandMs = 0;
+      await new Promise((resolve) => setTimeout(resolve, waitMs));
+    }
+    return ack;
+  },
+  queryCommand: async (scope, sessionId, commandId) => {
+    if (!connected) throw new Error("offline");
+    queryCount++;
+    const inboxKey = `${scope.workspacePath}:${sessionId ?? "null"}:${commandId}`;
+    const nullKey = `${scope.workspacePath}:null:${commandId}`;
+    return commandInbox.get(inboxKey) ?? commandInbox.get(nullKey) ?? "unknown";
+  },
+});
+const socket = await startMicroInputSocket({
+  directory,
+  scopes,
+  dispatch: (request, grant, signal) => handler(request, grant, () => !signal.aborted),
+});
+const controlPath = join(directory, "control.sock");
+const control = createServer((client) => {
+  let data = "";
+  client.setTimeout(2000, () => client.destroy());
+  client.on("error", () => {});
+  client.on("data", (chunk) => {
+    data += chunk.toString("utf8");
+    if (data.length > 65536) {
+      client.destroy();
+      return;
+    }
+    if (!data.endsWith("\n")) return;
+    void (async () => {
+      try {
+        const command = JSON.parse(data);
+        switch (command.op) {
+          case "delete":
+            rows = rows.filter(
+              (row) =>
+                row.address.workspacePath !== (command.workspacePath ?? scopes[0]!.workspacePath),
+            );
+            break;
+          case "rotate":
+            socket.grant.generation++;
+            await writeFile(join(directory, "zcode-grant.json"), JSON.stringify(socket.grant), {
+              mode: 0o600,
+            });
+            break;
+          case "replace-source":
+            sourceGeneration += "-next";
+            break;
+          case "disconnect":
+            connected = false;
+            break;
+          case "reset":
+            reset();
+            break;
+          case "delete-during-open":
+            deleteDuringOpen = true;
+            break;
+          case "rotate-during-open":
+            rotateDuringOpen = true;
+            break;
+          case "set-task-state": {
+            const workspacePath = command.workspacePath ?? scopes[0]!.workspacePath;
+            const taskId = command.taskId ?? "same-task-id";
+            const existing = rows.find(
+              (row) => row.address.workspacePath === workspacePath && row.address.taskId === taskId,
+            );
+            if (existing) {
+              if (typeof command.liveStatus === "string") existing.liveStatus = command.liveStatus;
+              if (typeof command.executionId === "string" && command.executionId.length > 0) {
+                existing.executionId = command.executionId;
+              } else if (command.executionId === null) {
+                delete existing.executionId;
+              }
+            } else {
+              rows.push({
+                address: { workspacePath, taskId },
+                title: command.title ?? taskId,
+                liveStatus: command.liveStatus ?? "idle",
+                ...(typeof command.executionId === "string" && command.executionId.length > 0
+                  ? { executionId: command.executionId }
+                  : {}),
+              });
+            }
+            if (command.routingMode === "guide" || command.routingMode === "queue") {
+              routingModeByTaskKey.set(taskKey(workspacePath, taskId), command.routingMode);
+            }
+            break;
+          }
+          case "delay-next-command":
+            delayNextCommandMs = Number(command.delayMs ?? 250);
+            holdNextCommandUnknown = Boolean(command.holdUnknown);
+            break;
+          case "settle-held-commands":
+            for (const [key, ack] of heldUnknownCommands) {
+              commandInbox.set(key, ack);
+            }
+            heldUnknownCommands.clear();
+            break;
+          case "stats":
+            break;
+          default:
+            client.end(JSON.stringify({ error: "unknown" }) + "\n");
+            return;
+        }
+        client.end(
+          JSON.stringify({
+            metadataReads,
+            navigationCount,
+            selected: selection.selected(scopes[0]!) ?? selection.selected(scopes[1]!),
+            connected,
+            sourceGeneration,
+            createCount,
+            sendCount,
+            stopCount,
+            queryCount,
+            sentByTaskKey,
+            stoppedByTaskKey,
+            commandIdsSeen,
+            rows,
+          }) + "\n",
+        );
+      } catch {
+        client.destroy();
+      }
+    })();
+  });
+});
+await new Promise<void>((resolve, reject) => {
+  control.once("error", reject);
+  control.listen(controlPath, resolve);
+});
+await chmod(controlPath, 0o600);
+console.log(`GRANT_PATH=${join(directory, "zcode-grant.json")}`);
+console.log(`CONTROL_PATH=${controlPath}`);
+let closing = false;
+const close = async () => {
+  if (closing) return;
+  closing = true;
+  await socket.dispose();
+  control.close();
+  await unlink(controlPath).catch(() => {});
+  process.exit(0);
+};
+process.once("SIGTERM", () => void close());
+process.once("SIGINT", () => void close());
+setTimeout(() => void close(), Math.min(600, Math.max(1, Number(values.ttl))) * 1000).unref();
diff --git a/scripts/micro-input-host-boundary.mjs b/scripts/micro-input-host-boundary.mjs
