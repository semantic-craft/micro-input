--- /dev/null
+++ b/scripts/micro-input-fixture.ts
@@ -0,0 +1,164 @@
+import { createServer } from "node:net";
+import { chmod, mkdir, writeFile, unlink } from "node:fs/promises";
+import { join, resolve } from "node:path";
+import { parseArgs } from "node:util";
+import { startMicroInputSocket } from "../packages/desktop/src/main/micro-input/socket.ts";
+import { createMicroInputNavigation } from "../packages/ui/src/app-shell/micro-input/navigation.ts";
+import {
+  sameMicroInputScope,
+  type MicroInputRow,
+} from "../packages/shared/src/micro-input/contract.ts";
+
+const { values } = parseArgs({
+  options: { directory: { type: "string" }, ttl: { type: "string", default: "120" } },
+});
+if (!values.directory) throw new Error("--directory required");
+const directory = resolve(values.directory);
+await mkdir(directory, { recursive: true, mode: 0o700 });
+const scopes = [
+  { workspacePath: "/synthetic/workspace-a" },
+  { workspacePath: "/synthetic/workspace-b" },
+];
+let rows: MicroInputRow[] = [];
+const { createTabStore } = await import("../packages/ui/src/store/tabStore.ts");
+const { useZCodeSessionStore } = await import("../packages/ui/src/store/zcodeSessionStore.ts");
+const { createMicroInputSelection } =
+  await import("../packages/ui/src/app-shell/micro-input/selection.ts");
+const tabs = createTabStore(null);
+for (const scope of scopes) tabs.getState().addTab(scope.workspacePath);
+let sourceGeneration = "source-1";
+let connected = true;
+let metadataReads = 0;
+let navigationCount = 0;
+let deleteDuringOpen = false;
+let rotateDuringOpen = false;
+const reset = () => {
+  rows = scopes.map((scope) => ({
+    address: { ...scope, taskId: "same-task-id" },
+    title: "Same task",
+    liveStatus: "idle",
+  }));
+  for (const scope of scopes)
+    useZCodeSessionStore.getState().setActiveTaskId(scope.workspacePath, null);
+  connected = true;
+  metadataReads = 0;
+  navigationCount = 0;
+  deleteDuringOpen = false;
+  rotateDuringOpen = false;
+};
+reset();
+const selection = createMicroInputSelection(tabs, () => {
+  navigationCount++;
+});
+const handler = createMicroInputNavigation({
+  ...selection,
+  readIndex: async (scope) => {
+    metadataReads++;
+    if (!connected) throw new Error("offline");
+    return {
+      sourceGeneration,
+      rows: rows.filter((row) => sameMicroInputScope(row.address, scope)),
+    };
+  },
+  exists: async (address) => {
+    metadataReads++;
+    const exists = rows.some(
+      (row) => sameMicroInputScope(row.address, address) && row.address.taskId === address.taskId,
+    );
+    if (deleteDuringOpen) rows = rows.filter((row) => !sameMicroInputScope(row.address, address));
+    if (rotateDuringOpen) sourceGeneration += "-next";
+    return exists;
+  },
+  current: (scope) => {
+    const current = selection.current(scope);
+    return connected && current ? () => connected && current() : null;
+  },
+});
+const socket = await startMicroInputSocket({
+  directory,
+  scopes,
+  dispatch: (request, grant, signal) => handler(request, grant, () => !signal.aborted),
+});
+const controlPath = join(directory, "control.sock");
+const control = createServer((client) => {
+  let data = "";
+  client.setTimeout(2000, () => client.destroy());
+  client.on("error", () => {});
+  client.on("data", (chunk) => {
+    data += chunk.toString("utf8");
+    if (data.length > 65536) {
+      client.destroy();
+      return;
+    }
+    if (!data.endsWith("\n")) return;
+    void (async () => {
+      try {
+        const command = JSON.parse(data);
+        switch (command.op) {
+          case "delete":
+            rows = rows.filter(
+              (row) =>
+                row.address.workspacePath !== (command.workspacePath ?? scopes[0]!.workspacePath),
+            );
+            break;
+          case "rotate":
+            socket.grant.generation++;
+            await writeFile(join(directory, "zcode-grant.json"), JSON.stringify(socket.grant), {
+              mode: 0o600,
+            });
