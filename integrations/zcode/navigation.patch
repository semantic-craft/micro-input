+    ipcRenderer.on("micro-input:request", listener);
+    ipcRenderer.send("micro-input:ready");
+    return () => { current = false; ipcRenderer.removeListener("micro-input:cancel", cancel); ipcRenderer.removeListener("micro-input:request", listener); };
+  },
+});
