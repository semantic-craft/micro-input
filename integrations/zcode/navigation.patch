@@ -0,0 +1,94 @@
+import {
+  authorizeMicroInput,
+  sameMicroInputAddress,
+  sameMicroInputScope,
+  type MicroInputAddress,
+  type MicroInputGrant,
+  type MicroInputRequest,
+  type MicroInputResponse,
+  type MicroInputRow,
+  type MicroInputScope,
+} from "@zcode/shared";
+
+export function createMicroInputNavigation(ports: {
+  readIndex: (
+    scope: MicroInputScope,
+  ) => Promise<{ sourceGeneration: string; rows: MicroInputRow[] }>;
+  exists: (address: MicroInputAddress) => Promise<boolean>;
+  current: (scope: MicroInputScope) => (() => boolean) | null;
+  select: (address: MicroInputAddress) => boolean;
+  selected: (scope: MicroInputScope) => MicroInputAddress | null;
+}) {
+  const sources = new Map<string, string>();
+  let inFlight = false;
+  return async (
+    raw: MicroInputRequest,
+    grant: MicroInputGrant,
+    isCurrent: () => boolean,
+  ): Promise<MicroInputResponse> => {
+    const request = authorizeMicroInput(raw, grant);
+    const base = {
+      version: 1 as const,
+      id: raw.id,
+      instanceId: grant.instanceId,
+      generation: grant.generation,
+    };
+    if (!request) return { ...base, status: "denied" };
+    if (
+      request.instanceId !== grant.instanceId ||
+      request.generation !== grant.generation ||
+      !isCurrent()
+    )
+      return { ...base, status: "stale" };
+    if (inFlight) return { ...base, status: "unavailable" };
+    const current = ports.current(request.scope);
+    if (!current) return { ...base, status: "unavailable" };
+    const valid = () => isCurrent() && current();
+    const key = JSON.stringify([
+      request.scope.workspacePath,
+      request.scope.workspaceIdentity,
+      request.scope.sourceServerId,
+      request.scope.remoteSessionId,
+    ]);
+    const expected = sources.get(key);
+    if (request.op === "open" && expected === undefined) return { ...base, status: "stale" };
+    inFlight = true;
+    try {
+      const index = await ports.readIndex(request.scope);
+      if (!valid() || (expected !== undefined && expected !== index.sourceGeneration))
+        return { ...base, status: "stale" };
+      if (
+        index.rows.length > 4096 ||
+        index.rows.some((row) => !sameMicroInputScope(row.address, request.scope))
+      )
+        return { ...base, status: "unavailable" };
+      if (request.op === "list") {
+        sources.set(key, index.sourceGeneration);
+        const selected = ports.selected(request.scope);
+        return {
+          ...base,
+          status: "ok",
+          rows: index.rows,
+          selected: selected && sameMicroInputScope(selected, request.scope) ? selected : null,
+        };
+      }
+      const target = request.target;
+      if (!target || !index.rows.some((row) => sameMicroInputAddress(row.address, target)))
+        return { ...base, status: "unavailable" };
+      if (!(await ports.exists(target)) || !valid()) return { ...base, status: "unavailable" };
+      const finalIndex = await ports.readIndex(request.scope);
+      if (!valid() || finalIndex.sourceGeneration !== expected) return { ...base, status: "stale" };
+      if (!finalIndex.rows.some((row) => sameMicroInputAddress(row.address, target)))
+        return { ...base, status: "unavailable" };
+      if (!ports.select(target)) return { ...base, status: "unavailable" };
+      const selected = ports.selected(request.scope);
+      return sameMicroInputAddress(selected, target)
+        ? { ...base, status: "confirmed", selected }
+        : { ...base, status: "unconfirmed" };
+    } catch {
+      return { ...base, status: "unavailable" };
+    } finally {
+      inFlight = false;
+    }
+  };
+}
