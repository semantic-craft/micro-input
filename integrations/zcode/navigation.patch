new file mode 100644
index 00000000..ec59dcad
--- /dev/null
+++ b/packages/shared/src/micro-input/contract.ts
@@ -0,0 +1,106 @@
+import { z } from "zod";
+
+const identifier = z
+  .string()
+  .min(1)
+  .max(4096)
+  .refine((value) => value.trim() === value && !value.includes("\0"));
+export const microInputScopeSchema = z
+  .object({
+    workspacePath: identifier,
+    workspaceIdentity: identifier.optional(),
+    sourceServerId: identifier.optional(),
+    remoteSessionId: identifier.optional(),
+  })
+  .strict();
+export const microInputAddressSchema = microInputScopeSchema.extend({ taskId: identifier });
+export const microInputRequestSchema = z
+  .object({
+    version: z.literal(1),
+    id: identifier,
+    token: identifier,
+    instanceId: identifier,
+    generation: z.number().int().positive().safe(),
+    op: z.enum(["list", "open"]),
+    scope: microInputScopeSchema,
+    target: microInputAddressSchema.optional(),
+  })
+  .strict()
+  .refine((request) =>
+    request.op === "open" ? request.target !== undefined : request.target === undefined,
+  );
+export const microInputGrantSchema = z
+  .object({
+    version: z.literal(1),
+    socketPath: identifier,
+    token: identifier,
+    instanceId: identifier,
+    generation: z.number().int().positive().safe(),
+    scopes: z.array(microInputScopeSchema).min(1).max(64),
+  })
+  .strict();
+export type MicroInputScope = z.infer<typeof microInputScopeSchema>;
+export type MicroInputAddress = z.infer<typeof microInputAddressSchema>;
+export type MicroInputRequest = z.infer<typeof microInputRequestSchema>;
+export type MicroInputGrant = z.infer<typeof microInputGrantSchema>;
+export type MicroInputStatus =
+  | "ok"
+  | "confirmed"
+  | "denied"
+  | "stale"
+  | "unavailable"
+  | "unconfirmed";
+export interface MicroInputRow {
+  address: MicroInputAddress;
+  title: string;
+  liveStatus: string;
+}
+export interface MicroInputResponse {
+  version: 1;
+  id: string;
+  instanceId: string;
+  generation: number;
+  status: MicroInputStatus;
+  rows?: MicroInputRow[];
+  selected?: MicroInputAddress | null;
+}
+export function sameMicroInputScope(a: MicroInputScope, b: MicroInputScope): boolean {
+  return (
+    a.workspacePath === b.workspacePath &&
+    a.workspaceIdentity === b.workspaceIdentity &&
+    a.sourceServerId === b.sourceServerId &&
+    a.remoteSessionId === b.remoteSessionId
+  );
+}
+export function sameMicroInputAddress(a: MicroInputAddress | null, b: MicroInputAddress): boolean {
+  return a !== null && sameMicroInputScope(a, b) && a.taskId === b.taskId;
+}
+export function authorizeMicroInput(
+  raw: unknown,
+  grant: MicroInputGrant,
+): MicroInputRequest | null {
+  const parsed = microInputRequestSchema.safeParse(raw);
+  if (!parsed.success) return null;
+  const request = parsed.data;
+  if (
+    request.token !== grant.token ||
+    !grant.scopes.some((scope) => sameMicroInputScope(scope, request.scope)) ||
+    (request.target && !sameMicroInputScope(request.target, request.scope))
+  )
+    return null;
+  return request;
+}
+export interface MicroInputRendererBridge {
+  listen(
+    handler: (
+      request: MicroInputRequest,
+      grant: MicroInputGrant,
+      isCurrent: () => boolean,
+    ) => Promise<MicroInputResponse>,
+  ): () => void;
+}
+declare global {
+  interface Window {
+    microInputNavigation?: MicroInputRendererBridge;
+  }
+}
