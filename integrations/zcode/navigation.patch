@@ -0,0 +1,331 @@
+import {
+  authorizeMicroInput,
+  sameMicroInputAddress,
+  sameMicroInputScope,
+  type MicroInputAddress,
+  type MicroInputCommandAck,
+  type MicroInputCommandEnvelope,
+  type MicroInputGrant,
+  type MicroInputRequest,
+  type MicroInputResponse,
+  type MicroInputRow,
+  type MicroInputScope,
+} from "@zcode/shared";
+
+export function createMicroInputNavigation(ports: {
+  readIndex: (
+    scope: MicroInputScope,
+  ) => Promise<{ sourceGeneration: string; rows: MicroInputRow[] }>;
+  exists: (address: MicroInputAddress) => Promise<boolean>;
+  current: (scope: MicroInputScope) => (() => boolean) | null;
+  select: (address: MicroInputAddress) => boolean;
+  selected: (scope: MicroInputScope) => MicroInputAddress | null;
+  sendCommand?: (
+    scope: MicroInputScope,
+    envelope: MicroInputCommandEnvelope,
+  ) => Promise<MicroInputCommandAck>;
+  queryCommand?: (
+    scope: MicroInputScope,
+    sessionId: string | null,
+    commandId: string,
+  ) => Promise<MicroInputCommandAck | "unknown">;
+}) {
+  const sources = new Map<string, string>();
+  let inFlight = false;
+  return async (
+    raw: MicroInputRequest,
+    grant: MicroInputGrant,
+    isCurrent: () => boolean,
+  ): Promise<MicroInputResponse> => {
+    const request = authorizeMicroInput(raw, grant);
+    const base = {
+      version: 1 as const,
+      id: raw.id,
+      instanceId: grant.instanceId,
+      generation: grant.generation,
+    };
+    if (!request) return { ...base, status: "denied" };
+    if (
+      request.instanceId !== grant.instanceId ||
+      request.generation !== grant.generation ||
+      !isCurrent()
+    )
+      return { ...base, status: "stale" };
+    if (inFlight) return { ...base, status: "unavailable" };
+    const current = ports.current(request.scope);
+    if (!current) return { ...base, status: "unavailable" };
+    const valid = () => isCurrent() && current();
+    const key = JSON.stringify([
+      request.scope.workspacePath,
+      request.scope.workspaceIdentity,
+      request.scope.sourceServerId,
+      request.scope.remoteSessionId,
+    ]);
+    const expected = sources.get(key);
+    if (request.op !== "list" && expected === undefined) return { ...base, status: "stale" };
+    inFlight = true;
+    try {
+      const index = await ports.readIndex(request.scope);
+      if (!valid() || (expected !== undefined && expected !== index.sourceGeneration))
+        return { ...base, status: "stale" };
+      if (
+        index.rows.length > 4096 ||
+        index.rows.some((row) => !sameMicroInputScope(row.address, request.scope))
+      )
+        return { ...base, status: "unavailable" };
+      const confirmTarget = async (
+        target: MicroInputAddress,
+        checkInitialIndex: boolean,
+      ): Promise<MicroInputAddress | "stale" | "unavailable" | "unconfirmed"> => {
+        if (checkInitialIndex && !index.rows.some((row) => sameMicroInputAddress(row.address, target)))
+          return "unavailable";
+        if (!(await ports.exists(target)) || !valid()) return "unavailable";
+        const finalIndex = await ports.readIndex(request.scope);
+        if (!valid() || finalIndex.sourceGeneration !== expected) return "stale";
+        if (!finalIndex.rows.some((row) => sameMicroInputAddress(row.address, target)))
+          return "unavailable";
+        if (!ports.select(target)) return "unavailable";
+        const selected = ports.selected(request.scope);
+        return sameMicroInputAddress(selected, target) && selected ? selected : "unconfirmed";
+      };
+      if (request.op === "list") {
+        sources.set(key, index.sourceGeneration);
+        const selected = ports.selected(request.scope);
+        return {
+          ...base,
+          status: "ok",
+          rows: index.rows,
+          selected: selected && sameMicroInputScope(selected, request.scope) ? selected : null,
+        };
+      }
+      if (request.op === "open") {
+        const target = request.target!;
+        const outcome = await confirmTarget(target, true);
+        if (typeof outcome === "string") return { ...base, status: outcome };
+        return { ...base, status: "confirmed", selected: outcome };
+      }
+      if (request.op === "create") {
+        if (!ports.sendCommand) return { ...base, status: "unavailable" };
+        const workspaceId = request.scope.workspaceIdentity?.trim() || request.scope.workspacePath;
+        const ack = await ports.sendCommand(request.scope, {
+          commandId: request.commandId!,
+          clientId: request.clientId!,
+          sessionId: null,
+          type: "createSession",
+          payload: {
+            workspaceId,
+            ...(request.sessionId ? { sessionId: request.sessionId } : {}),
+            ...(request.text ? { firstInput: { text: request.text } } : {}),
+          },
+          issuedAt: Date.now(),
+        });
+        if (!valid()) return { ...base, status: "stale" };
+        if (
+          (ack.status !== "accepted" && ack.status !== "duplicate") ||
+          ack.result?.type !== "createSession"
+        ) {
+          return {
+            ...base,
+            status: "unconfirmed",
+            commandId: request.commandId,
+            ...(ack.reasonCode ? { reasonCode: ack.reasonCode } : {}),
+          };
+        }
+        const createdAddress: MicroInputAddress = {
+          ...request.scope,
+          taskId: ack.result.sessionId,
+        };
+        const outcome = await confirmTarget(createdAddress, false);
+        if (typeof outcome === "string")
+          return { ...base, status: outcome, commandId: request.commandId };
+        return {
+          ...base,
+          status: "confirmed",
+          selected: outcome,
+          commandId: request.commandId,
+          duplicate: ack.status === "duplicate",
+          ...(ack.result.input ? { delivery: ack.result.input.delivery } : {}),
+        };
+      }
+      if (request.op === "send") {
+        const target = request.target!;
+        if (!ports.sendCommand) return { ...base, status: "unavailable" };
+        if (!sameMicroInputAddress(ports.selected(request.scope), target))
+          return { ...base, status: "unconfirmed", commandId: request.commandId };
+        if (!index.rows.some((row) => sameMicroInputAddress(row.address, target)))
+          return { ...base, status: "unavailable" };
+        if (!(await ports.exists(target)) || !valid()) return { ...base, status: "unavailable" };
+        if (!sameMicroInputAddress(ports.selected(request.scope), target))
+          return { ...base, status: "unconfirmed", commandId: request.commandId };
+        const ack = await ports.sendCommand(request.scope, {
+          commandId: request.commandId!,
+          clientId: request.clientId!,
+          sessionId: target.taskId,
+          type: "sendText",
+          payload: {
+            text: request.text!,
+            ...(request.requestedDelivery ? { requestedDelivery: request.requestedDelivery } : {}),
+          },
+          issuedAt: Date.now(),
+        });
+        if (!valid()) return { ...base, status: "stale" };
+        if (
+          (ack.status !== "accepted" && ack.status !== "duplicate") ||
+          ack.result?.type !== "inputAccepted"
+        ) {
+          return {
+            ...base,
+            status: "unconfirmed",
+            commandId: request.commandId,
+            ...(ack.reasonCode ? { reasonCode: ack.reasonCode } : {}),
+          };
+        }
+        const delivery = ack.result.delivery;
+        const refreshed = await ports.readIndex(request.scope);
+        const executionId = refreshed.rows.find((row) =>
+          sameMicroInputAddress(row.address, target),
+        )?.executionId;
+        return {
+          ...base,
+          status: delivery === "guide" ? "steered" : delivery === "queue" ? "queued" : "started",
+          selected: target,
+          commandId: request.commandId,
+          duplicate: ack.status === "duplicate",
+          delivery,
+          ...(executionId ? { executionId } : {}),
+        };
+      }
+      if (request.op === "stop") {
+        const target = request.target!;
+        if (!ports.sendCommand) return { ...base, status: "unavailable" };
+        if (!sameMicroInputAddress(ports.selected(request.scope), target))
+          return { ...base, status: "unconfirmed", commandId: request.commandId };
+        if (!index.rows.some((row) => sameMicroInputAddress(row.address, target)))
+          return { ...base, status: "unavailable" };
+        if (!(await ports.exists(target)) || !valid()) return { ...base, status: "unavailable" };
+        if (!sameMicroInputAddress(ports.selected(request.scope), target))
+          return { ...base, status: "unconfirmed", commandId: request.commandId };
+        const ack = await ports.sendCommand(request.scope, {
+          commandId: request.commandId!,
+          clientId: request.clientId!,
+          sessionId: target.taskId,
+          type: "stop",
+          payload: {
+            expectedForegroundExecutionId: request.executionId!,
+          },
+          issuedAt: Date.now(),
+        });
+        if (!valid()) return { ...base, status: "stale" };
+        if (ack.status === "noop") {
+          return {
+            ...base,
+            status: "noop",
+            selected: target,
+            commandId: request.commandId,
+            executionId: request.executionId,
+            ...(ack.reasonCode ? { reasonCode: ack.reasonCode } : {}),
+          };
+        }
+        if (ack.status !== "accepted" && ack.status !== "duplicate") {
+          return {
+            ...base,
+            status: "unconfirmed",
+            commandId: request.commandId,
+            ...(ack.reasonCode ? { reasonCode: ack.reasonCode } : {}),
+          };
+        }
+        return {
+          ...base,
+          status: "stopped",
+          selected: target,
+          commandId: request.commandId,
+          duplicate: ack.status === "duplicate",
+          executionId: request.executionId,
+        };
+      }
+      if (!ports.queryCommand) return { ...base, status: "unavailable" };
+      const target = request.target ?? null;
+      const queried = await ports.queryCommand(
+        request.scope,
+        target?.taskId ?? null,
+        request.commandId!,
+      );
+      if (!valid()) return { ...base, status: "stale" };
+      if (queried === "unknown") {
+        return { ...base, status: "unknown", commandId: request.commandId };
+      }
+      if (queried.result?.type === "createSession") {
+        if (queried.status !== "accepted" && queried.status !== "duplicate") {
+          return {
+            ...base,
+            status: "unconfirmed",
+            commandId: request.commandId,
+            ...(queried.reasonCode ? { reasonCode: queried.reasonCode } : {}),
+          };
+        }
+        const createdAddress: MicroInputAddress = {
+          ...request.scope,
+          taskId: queried.result.sessionId,
+        };
+        const outcome = await confirmTarget(createdAddress, false);
+        if (typeof outcome === "string")
+          return { ...base, status: outcome, commandId: request.commandId };
+        return {
+          ...base,
+          status: "confirmed",
+          selected: outcome,
+          commandId: request.commandId,
+          duplicate: true,
+          ...(queried.result.input ? { delivery: queried.result.input.delivery } : {}),
+        };
+      }
+      if (queried.result?.type === "inputAccepted") {
+        if (queried.status !== "accepted" && queried.status !== "duplicate") {
+          return {
+            ...base,
+            status: "unconfirmed",
+            commandId: request.commandId,
+            ...(queried.reasonCode ? { reasonCode: queried.reasonCode } : {}),
+          };
+        }
+        const delivery = queried.result.delivery;
+        return {
+          ...base,
+          status: delivery === "guide" ? "steered" : delivery === "queue" ? "queued" : "started",
+          selected: target,
+          commandId: request.commandId,
+          duplicate: true,
+          delivery,
+        };
+      }
+      if (queried.status === "noop") {
+        return {
+          ...base,
+          status: "noop",
+          selected: target,
+          commandId: request.commandId,
+          ...(queried.reasonCode ? { reasonCode: queried.reasonCode } : {}),
+        };
+      }
+      if (queried.status === "accepted" || queried.status === "duplicate") {
+        return {
+          ...base,
+          status: "stopped",
+          selected: target,
+          commandId: request.commandId,
+          duplicate: true,
+        };
+      }
+      return {
+        ...base,
+        status: "unconfirmed",
+        commandId: request.commandId,
+        ...(queried.reasonCode ? { reasonCode: queried.reasonCode } : {}),
+      };
+    } catch {
+      return { ...base, status: "unavailable" };
+    } finally {
+      inFlight = false;
+    }
+  };
+}
diff --git a/packages/ui/src/app-shell/micro-input/selection.ts b/packages/ui/src/app-shell/micro-input/selection.ts
new file mode 100644
index 00000000..cdbc9f4d
--- /dev/null
+++ b/packages/ui/src/app-shell/micro-input/selection.ts
@@ -0,0 +1,76 @@
+import { sameMicroInputScope, type MicroInputAddress, type MicroInputScope } from "@zcode/shared";
+import { isWorkspaceTab, type TabStore } from "@/store/tabStore.js";
+import { useZCodeSessionStore } from "@/store/zcodeSessionStore.js";
+import {
+  getRemoteWorkspaceSession,
+  useRemoteWorkspaceSessionStore,
+} from "@/store/remoteWorkspaceSessionStore.js";
+
+export function createMicroInputSelection(tabs: TabStore, onNavigate: () => void) {
+  const scopeOf = (
+    tab: ReturnType<typeof tabs.getState>["tabs"][number],
+  ): MicroInputScope | null => {
+    if (!isWorkspaceTab(tab)) return null;
+    const remote = tab.remoteSessionId ? getRemoteWorkspaceSession(tab.remoteSessionId) : null;
+    return {
+      workspacePath: tab.workspacePath,
+      ...(tab.workspaceIdentity ? { workspaceIdentity: tab.workspaceIdentity } : {}),
+      ...(tab.remoteSessionId ? { remoteSessionId: tab.remoteSessionId } : {}),
+      ...(remote?.sourceServerId ? { sourceServerId: remote.sourceServerId } : {}),
+    };
+  };
+  const findTab = (scope: MicroInputScope) => {
+    const matches = tabs.getState().tabs.filter((tab) => {
+      const candidate = scopeOf(tab);
+      return candidate && sameMicroInputScope(candidate, scope);
+    });
+    return matches.length === 1 && isWorkspaceTab(matches[0]!) ? matches[0] : null;
+  };
+  const selected = (authorizedScope: MicroInputScope): MicroInputAddress | null => {
+    const tab = tabs
+      .getState()
+      .tabs.find((candidate) => candidate.id === tabs.getState().activeTabId);
+    if (!tab || !isWorkspaceTab(tab)) return null;
+    const scope = scopeOf(tab);
+    if (!scope || !sameMicroInputScope(scope, authorizedScope)) return null;
+    const taskId =
+      useZCodeSessionStore.getState().workspaces[tab.workspaceIdentity?.trim() || tab.workspacePath]
+        ?.activeTaskId;
+    return scope && taskId ? { ...scope, taskId } : null;
+  };
+  return {
+    current: (scope: MicroInputScope) => {
+      const tab = findTab(scope);
+      if (!tab) return null;
+      const remote = scope.remoteSessionId
+        ? getRemoteWorkspaceSession(scope.remoteSessionId)
+        : null;
+      if ((scope.remoteSessionId && !remote) || (scope.sourceServerId && !scope.remoteSessionId))
+        return null;
+      const overlay = () =>
+        useRemoteWorkspaceSessionStore.getState().connectionOverlayByWorkspaceKey[
+          scope.workspaceIdentity || scope.workspacePath
+        ];
+      if (overlay()) return null;
+      return () =>
+        findTab(scope)?.id === tab.id &&
+        !overlay() &&
+        (!scope.remoteSessionId || getRemoteWorkspaceSession(scope.remoteSessionId) === remote);
+    },
+    select: (address: MicroInputAddress) => {
+      const tab = findTab(address);
+      if (!tab) return false;
+      const state = useZCodeSessionStore
+        .getState()
+        .getWorkspaceState(address.workspacePath, address.workspaceIdentity);
+      if (state.modelSwitchPending || state.modelSwitchStage !== "idle") return false;
+      tabs.getState().activateTab(tab.id);
+      useZCodeSessionStore
+        .getState()
+        .setActiveTaskId(address.workspacePath, address.taskId, address.workspaceIdentity);
+      onNavigate();
+      return true;
+    },
+    selected,
+  };
+}
diff --git a/packages/ui/src/app-shell/micro-input/useNavigation.ts b/packages/ui/src/app-shell/micro-input/useNavigation.ts
