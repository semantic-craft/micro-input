@@ -0,0 +1,76 @@
+import { sameMicroInputScope, type MicroInputAddress, type MicroInputScope } from "@zcode/shared";
+import { isWorkspaceTab, type TabStore } from "@/store/tabStore.js";
+import { useZCodeSessionStore } from "@/store/zcodeSessionStore.js";
+import {
+  getRemoteWorkspaceSession,
+  useRemoteWorkspaceSessionStore,
+} from "@/store/remoteWorkspaceSessionStore.js";
+
+export function createMicroInputSelection(tabs: TabStore, onNavigate: () => void) {
+  const scopeOf = (
+    tab: ReturnType<typeof tabs.getState>["tabs"][number],
+  ): MicroInputScope | null => {
+    if (!isWorkspaceTab(tab)) return null;
+    const remote = tab.remoteSessionId ? getRemoteWorkspaceSession(tab.remoteSessionId) : null;
+    return {
+      workspacePath: tab.workspacePath,
+      ...(tab.workspaceIdentity ? { workspaceIdentity: tab.workspaceIdentity } : {}),
+      ...(tab.remoteSessionId ? { remoteSessionId: tab.remoteSessionId } : {}),
+      ...(remote?.sourceServerId ? { sourceServerId: remote.sourceServerId } : {}),
+    };
+  };
+  const findTab = (scope: MicroInputScope) => {
+    const matches = tabs.getState().tabs.filter((tab) => {
+      const candidate = scopeOf(tab);
+      return candidate && sameMicroInputScope(candidate, scope);
+    });
+    return matches.length === 1 && isWorkspaceTab(matches[0]!) ? matches[0] : null;
+  };
+  const selected = (authorizedScope: MicroInputScope): MicroInputAddress | null => {
+    const tab = tabs
+      .getState()
+      .tabs.find((candidate) => candidate.id === tabs.getState().activeTabId);
+    if (!tab || !isWorkspaceTab(tab)) return null;
+    const scope = scopeOf(tab);
+    if (!scope || !sameMicroInputScope(scope, authorizedScope)) return null;
+    const taskId =
+      useZCodeSessionStore.getState().workspaces[tab.workspaceIdentity?.trim() || tab.workspacePath]
+        ?.activeTaskId;
+    return scope && taskId ? { ...scope, taskId } : null;
+  };
+  return {
+    current: (scope: MicroInputScope) => {
+      const tab = findTab(scope);
+      if (!tab) return null;
+      const remote = scope.remoteSessionId
+        ? getRemoteWorkspaceSession(scope.remoteSessionId)
+        : null;
+      if ((scope.remoteSessionId && !remote) || (scope.sourceServerId && !scope.remoteSessionId))
+        return null;
+      const overlay = () =>
+        useRemoteWorkspaceSessionStore.getState().connectionOverlayByWorkspaceKey[
+          scope.workspaceIdentity || scope.workspacePath
+        ];
+      if (overlay()) return null;
+      return () =>
+        findTab(scope)?.id === tab.id &&
+        !overlay() &&
+        (!scope.remoteSessionId || getRemoteWorkspaceSession(scope.remoteSessionId) === remote);
+    },
+    select: (address: MicroInputAddress) => {
+      const tab = findTab(address);
+      if (!tab) return false;
+      const state = useZCodeSessionStore
+        .getState()
+        .getWorkspaceState(address.workspacePath, address.workspaceIdentity);
+      if (state.modelSwitchPending || state.modelSwitchStage !== "idle") return false;
+      tabs.getState().activateTab(tab.id);
+      useZCodeSessionStore
+        .getState()
+        .setActiveTaskId(address.workspacePath, address.taskId, address.workspaceIdentity);
+      onNavigate();
+      return true;
+    },
+    selected,
+  };
+}
