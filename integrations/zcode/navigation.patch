--- /dev/null
+++ b/scripts/micro-input-host-boundary.mjs
@@ -0,0 +1,287 @@
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { createWindowHostControllerRuntime } from "../packages/desktop/src/host/windowHostControllerService.ts";
+
+const scope = { kind: "local", workspacePath: "/synthetic/workspace" };
+let status = "completed";
+let activeExecutionId = "exec-initial";
+const meta = () => ({
+  taskId: "task",
+  workspacePath: scope.workspacePath,
+  title: "Same task",
+  status,
+  createdAt: 1,
+  updatedAt: 2,
+  lastAssistantPreview: "PRIVATE_PREVIEW",
+  lastError: { message: "PRIVATE_ERROR" },
+});
+let exists = true;
+const commandInbox = new Map();
+let createSessionCalls = 0;
+let sendTextCalls = 0;
+let stopCalls = 0;
+let routingMode = "guide";
+
+const taskService = {
+  listTasks: async () => (exists ? [meta()] : []),
+  listPinnedTasks: async () => [],
+  listArchivedTasks: async () => [],
+  getTaskMeta: async ({ taskId }) => (exists && taskId === "task" ? meta() : null),
+  readBotTopicExecution: async ({ taskId }) =>
+    exists && taskId === "task" && status === "running" && activeExecutionId
+      ? { executionId: activeExecutionId }
+      : undefined,
+};
+const agentService = {
+  onDynamicSessionsIndexFrame: () => () => ({ dispose() {} }),
+  onAgentRuntimeRestarted: () => ({ dispose() {} }),
+  subscribeSessionsIndexV4: async () => ({
+    ack: { subscriptionId: "sub-1", mode: "snapshot", logEpoch: "epoch-1" },
+  }),
+  resyncSessionsIndexV4: async () => ({
+    ack: { subscriptionId: "sub-1", mode: "snapshot", logEpoch: "epoch-1" },
+  }),
+  unsubscribeSessionsIndexV4: async () => {},
+  sendConversationCommandV4: async ({ envelope }) => {
+    const key = `${envelope.sessionId ?? "null"}:${envelope.commandId}`;
+    if (commandInbox.has(key)) {
+      const cached = commandInbox.get(key);
+      return { ...cached, status: "duplicate" };
+    }
+    if (envelope.type === "createSession") {
+      createSessionCalls++;
+      const sessionId = envelope.payload.sessionId ?? `created-${createSessionCalls}`;
+      const ack = {
+        commandId: envelope.commandId,
+        sessionId: null,
+        status: "accepted",
+        result: {
+          type: "createSession",
+          sessionId,
+          ...(envelope.payload.firstInput
+            ? { input: { delivery: "startNow", inputId: envelope.commandId } }
+            : {}),
+        },
+      };
+      commandInbox.set(key, ack);
+      return ack;
+    }
+    if (envelope.type === "sendText") {
+      sendTextCalls++;
+      const requested = envelope.payload.requestedDelivery;
+      const delivery =
+        status === "running"
+          ? requested === "guide" && routingMode === "guide"
+            ? "guide"
+            : requested === "startNow"
+              ? "startNow"
+              : "queue"
+          : "startNow";
+      const ack = {
+        commandId: envelope.commandId,
+        sessionId: envelope.sessionId,
+        status: "accepted",
+        result: {
+          type: "inputAccepted",
+          delivery,
+          inputId: envelope.commandId,
+        },
+      };
+      commandInbox.set(key, ack);
+      return ack;
+    }
+    if (envelope.type === "stop") {
+      stopCalls++;
+      if (
+        status !== "running" ||
+        envelope.payload.expectedForegroundExecutionId !== activeExecutionId
+      ) {
+        const noopAck = {
+          commandId: envelope.commandId,
+          sessionId: envelope.sessionId,
+          status: "noop",
+          reasonCode: "guard.stopTargetChanged",
+        };
+        commandInbox.set(key, noopAck);
+        return noopAck;
+      }
+      status = "completed";
+      activeExecutionId = "";
+      const ack = {
+        commandId: envelope.commandId,
+        sessionId: envelope.sessionId,
+        status: "accepted",
+      };
+      commandInbox.set(key, ack);
+      return ack;
+    }
+    throw new Error("unexpected command");
+  },
+  queryConversationCommandsV4: async ({ commands }) => ({
+    results: commands.map(({ sessionId, commandId }) => {
+      const key = `${sessionId ?? "null"}:${commandId}`;
+      return {
+        key: { sessionId, commandId },
+        result: commandInbox.get(key) ?? "unknown",
+      };
+    }),
+  }),
+};
+
+const controller = createWindowHostControllerRuntime({
+  createId: randomUUID,
+  readHostTaskList: async () => {
+    throw new Error("unscoped read forbidden");
+  },
+  resolveSource: (target) =>
+    target.workspacePath === scope.workspacePath
+      ? { scope, taskService, agentService, sourceAvailability: "online" }
+      : null,
+});
+try {
+  const result = await controller.service.readMicroInputIndex({
+    scope: { workspacePath: scope.workspacePath },
+  });
+  assert.deepEqual(result.rows, [
+    {
+      address: { workspacePath: scope.workspacePath, taskId: "task" },
+      title: "Same task",
+      liveStatus: "completed",
+    },
+  ]);
+  assert.equal(JSON.stringify(result).includes("PRIVATE"), false);
+
+  // Create draft session bound to workspace and read back new ID
+  const createAck = await controller.service.sendMicroInputCommand({
+    scope: { workspacePath: scope.workspacePath },
+    envelope: {
+      commandId: "cmd-create-1",
+      clientId: "mi-client",
+      sessionId: null,
+      type: "createSession",
+      payload: { workspaceId: scope.workspacePath, sessionId: "draft-1" },
+      issuedAt: 1,
+    },
+  });
+  assert.equal(createAck.status, "accepted");
+  assert.equal(createAck.result?.type, "createSession");
+  assert.equal(createAck.result?.sessionId, "draft-1");
+  assert.equal(
+    await controller.service.hasMicroInputTask({
+      address: { workspacePath: scope.workspacePath, taskId: "draft-1" },
+    }),
+    true,
+  );
+  // Duplicate create command does not create a second session
+  const duplicateCreateAck = await controller.service.sendMicroInputCommand({
+    scope: { workspacePath: scope.workspacePath },
+    envelope: {
+      commandId: "cmd-create-1",
+      clientId: "mi-client",
+      sessionId: null,
+      type: "createSession",
+      payload: { workspaceId: scope.workspacePath, sessionId: "draft-1" },
+      issuedAt: 1,
+    },
+  });
+  assert.equal(duplicateCreateAck.status, "duplicate");
+  assert.equal(createSessionCalls, 1);
+
+  // Running session projects executionId and distinguishes guide (steering) vs queue
+  status = "running";
+  activeExecutionId = "exec-run-2";
+  routingMode = "guide";
+  const steerAck = await controller.service.sendMicroInputCommand({
+    scope: { workspacePath: scope.workspacePath },
+    envelope: {
+      commandId: "cmd-steer-1",
+      clientId: "mi-client",
+      sessionId: "task",
+      type: "sendText",
+      payload: { text: "steer in flight", requestedDelivery: "guide" },
+      issuedAt: 2,
+    },
+  });
+  assert.equal(steerAck.status, "accepted");
+  assert.equal(steerAck.result?.type, "inputAccepted");
+  assert.equal(steerAck.result?.delivery, "guide");
+  assert.equal(createSessionCalls, 1);
+
+  // Queue fallback when guide is not admitted as steering
+  routingMode = "queue";
+  const queueAck = await controller.service.sendMicroInputCommand({
+    scope: { workspacePath: scope.workspacePath },
+    envelope: {
+      commandId: "cmd-queue-1",
+      clientId: "mi-client",
+      sessionId: "task",
+      type: "sendText",
+      payload: { text: "fallback to queue", requestedDelivery: "guide" },
+      issuedAt: 3,
+    },
+  });
+  assert.equal(queueAck.status, "accepted");
+  assert.equal(queueAck.result?.type, "inputAccepted");
+  assert.equal(queueAck.result?.delivery, "queue");
+
+  // Late stop with stale executionId returns noop without stopping activeExecutionId
+  const lateStopAck = await controller.service.sendMicroInputCommand({
+    scope: { workspacePath: scope.workspacePath },
+    envelope: {
+      commandId: "cmd-stop-stale",
+      clientId: "mi-client",
+      sessionId: "task",
+      type: "stop",
+      payload: { expectedForegroundExecutionId: "exec-old-1" },
+      issuedAt: 4,
+    },
+  });
+  assert.equal(lateStopAck.status, "noop");
+  assert.equal(lateStopAck.reasonCode, "guard.stopTargetChanged");
+  assert.equal(status, "running");
+
+  // Stop with current executionId stops the active execution
+  const validStopAck = await controller.service.sendMicroInputCommand({
+    scope: { workspacePath: scope.workspacePath },
+    envelope: {
+      commandId: "cmd-stop-current",
+      clientId: "mi-client",
+      sessionId: "task",
+      type: "stop",
+      payload: { expectedForegroundExecutionId: "exec-run-2" },
+      issuedAt: 5,
+    },
+  });
+  assert.equal(validStopAck.status, "accepted");
+  assert.equal(status, "completed");
+
+  // Query command reconciliation
+  assert.equal(
+    await controller.service.queryMicroInputCommand({
+      scope: { workspacePath: scope.workspacePath },
+      sessionId: "task",
+      commandId: "cmd-unseen",
+    }),
+    "unknown",
+  );
+  const reconciledSteer = await controller.service.queryMicroInputCommand({
+    scope: { workspacePath: scope.workspacePath },
+    sessionId: "task",
+    commandId: "cmd-steer-1",
+  });
+  assert.notEqual(reconciledSteer, "unknown");
+  if (reconciledSteer !== "unknown") {
+    assert.equal(reconciledSteer.result?.type, "inputAccepted");
+    if (reconciledSteer.result?.type === "inputAccepted") {
+      assert.equal(reconciledSteer.result.delivery, "guide");
+    }
+  }
+
+  const target = { address: { workspacePath: scope.workspacePath, taskId: "task" } };
+  assert.equal(await controller.service.hasMicroInputTask(target), true);
+  exists = false;
+  assert.equal(await controller.service.hasMicroInputTask(target), false);
+} finally {
+  controller.dispose();
+}
+console.log("Host metadata projection, v4 command idempotency, steering and stop boundary: PASS");
