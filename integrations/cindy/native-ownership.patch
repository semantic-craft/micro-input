diff --git a/apps/desktop/src/main/worklouder-codex/WorkLouderOwnershipFence.ts b/apps/desktop/src/main/worklouder-codex/WorkLouderOwnershipFence.ts
new file mode 100644
index 00000000..722d63f1
--- /dev/null
+++ b/apps/desktop/src/main/worklouder-codex/WorkLouderOwnershipFence.ts
@@ -0,0 +1,21 @@
+export class WorkLouderOwnershipFence {
+  suspended = false;
+  generation = 0;
+
+  wrapInput<T>(consume: (value: T) => void): (value: T) => void {
+    const generation = this.generation;
+    return (value) => {
+      if (!this.suspended && generation === this.generation) consume(value);
+    };
+  }
+
+  async change(generation: number, suspended: boolean, drain: () => Promise<void>): Promise<boolean> {
+    if (!Number.isSafeInteger(generation) || generation < this.generation) return false;
+    this.generation = generation;
+    this.suspended = suspended;
+    try {
+      if (suspended) await drain();
+    } catch { return false; }
+    return this.generation === generation && this.suspended === suspended;
+  }
+}
