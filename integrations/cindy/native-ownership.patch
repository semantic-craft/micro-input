new file mode 100644
index 00000000..33edd684
--- /dev/null
+++ b/scripts/micro-input-navigation-fixture.ts
@@ -0,0 +1,286 @@
+import { randomUUID } from 'node:crypto';
+import { chmod, mkdir, writeFile } from 'node:fs/promises';
+import net from 'node:net';
+import path from 'node:path';
+import { parseArgs } from 'node:util';
+import {
+  createCindyMicroInputNavigation,
+  hashCindyOwnerScopeKey,
+  startCindyMicroInputNavigationBridge,
+  type CindyMicroInputRow,
+} from '../apps/desktop/src/main/worklouder-codex/microInputNavigation.js';
+
+async function main() {
+  const { values } = parseArgs({
+    options: {
+      directory: { type: 'string' },
+      evidence: { type: 'string' },
+      timeout: { type: 'string', default: '90' },
+    },
+  });
+  if (!values.directory || !values.evidence) {
+    throw new Error('--directory and --evidence required');
+  }
+  const directory = path.resolve(values.directory);
+  const evidencePath = path.resolve(values.evidence);
+  const controlPath = path.join(directory, 'cindy.control');
+  const ttl = Number(values.timeout);
+  if (
+    !Number.isFinite(ttl) ||
+    ttl < 1 ||
+    ttl > 300 ||
+    Buffer.byteLength(controlPath) >= 104
+  ) {
+    throw new Error('invalid fixture limits');
+  }
+
+  let ownerScope = 'cindy-account:owner-1';
+  let sourceGeneration = '1';
+  let activeSessionId: string | null = 'cindy-alpha-1';
+  let deliveryMode: 'confirmed' | 'delivered' | 'unconfirmed' = 'confirmed';
+  let metadataReads = 0;
+  let unauthorizedMetadataReads = 0;
+  const deepLinkLog: Array<{
+    sessionId: string;
+    workspacePath: string;
+    deepLink: string;
+    mode: string;
+  }> = [];
+
+  const tasks = new Map<string, CindyMicroInputRow>([
+    [
+      '/Users/test/CindyAlpha::cindy-alpha-1',
+      {
+        address: { workspacePath: '/Users/test/CindyAlpha', sessionId: 'cindy-alpha-1' },
+        title: 'Duplicate Task Title',
+        phase: 'running',
+        attention: false,
+        pinned: true,
+      },
+    ],
+    [
+      '/Users/test/CindyAlpha::cindy-alpha-2',
+      {
+        address: { workspacePath: '/Users/test/CindyAlpha', sessionId: 'cindy-alpha-2' },
+        title: 'Duplicate Task Title',
+        phase: 'needs-interaction',
+        attention: true,
+        pinned: false,
+      },
+    ],
+    [
+      '/Users/test/CindyBeta::cindy-beta-1',
+      {
+        address: { workspacePath: '/Users/test/CindyBeta', sessionId: 'cindy-beta-1' },
+        title: 'Duplicate Task Title',
+        phase: 'idle',
+        attention: false,
+        pinned: false,
+      },
+    ],
+    [
+      '/Users/test/CindySecret::cindy-secret-1',
+      {
+        address: { workspacePath: '/Users/test/CindySecret', sessionId: 'cindy-secret-1' },
+        title: 'Out Of Scope Task',
+        phase: 'error',
+        attention: true,
+        pinned: true,
+      },
+    ],
+  ]);
+
+  const scopes = [
+    { workspacePath: '/Users/test/CindyAlpha' },
+    { workspacePath: '/Users/test/CindyBeta' },
+  ];
+
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  await chmod(directory, 0o700);
+  await mkdir(path.dirname(evidencePath), { recursive: true, mode: 0o700 });
+
+  const dispatch = createCindyMicroInputNavigation({
+    currentOwnerEpoch: () => hashCindyOwnerScopeKey(ownerScope),
+    readIndex: async (scope) => {
+      metadataReads += 1;
+      if (!scopes.some((s) => s.workspacePath === scope.workspacePath)) {
+        unauthorizedMetadataReads += 1;
+      }
+      return {
+        ownerEpoch: hashCindyOwnerScopeKey(ownerScope),
+        sourceGeneration,
+        rows: [...tasks.values()].filter(
+          (row) => row.address.workspacePath === scope.workspacePath,
+        ),
+      };
+    },
+    exists: async (address) => tasks.has(`${address.workspacePath}::${address.sessionId}`),
+    selected: (scope) => {
+      if (!activeSessionId) return null;
+      const key = `${scope.workspacePath}::${activeSessionId}`;
+      return tasks.has(key)
+        ? { workspacePath: scope.workspacePath, sessionId: activeSessionId }
+        : null;
+    },
+    deliverSessionDeepLink: async (target, deepLink) => {
+      deepLinkLog.push({
+        sessionId: target.sessionId,
+        workspacePath: target.workspacePath,
+        deepLink,
+        mode: deliveryMode,
+      });
+      if (deliveryMode === 'confirmed') {
+        activeSessionId = target.sessionId;
+        return { status: 'confirmed' as const, selected: target };
+      }
+      if (deliveryMode === 'delivered') {
+        return { status: 'delivered' as const };
+      }
+      return { status: 'unconfirmed' as const, selected: null };
+    },
+    focusWindow: () => true,
+  });
+
+  const bridge = await startCindyMicroInputNavigationBridge({
+    directory,
+    scopes,
+    ownerEpoch: hashCindyOwnerScopeKey(ownerScope)!,
+    dispatch: (raw, grant, signal) => dispatch(raw, grant, () => !signal.aborted),
+  });
+
+  async function writeReceipt() {
+    await writeFile(
+      evidencePath,
+      `${JSON.stringify(
+        {
+          native_source: 'CindyMicroInputNavigationBridge',
+          transport: 'real-unix-socket',
+          local_agent_api_relaxed: false,
+          plugin_tasks_api_relaxed: false,
+          metadata_reads: metadataReads,
+          unauthorized_metadata_reads: unauthorizedMetadataReads,
+          deep_link_dispatches: deepLinkLog,
+          native_install: 'NOT_RUN',
+          physical: 'NOT_RUN',
+        },
+        null,
+        2,
+      )}\n`,
+      { mode: 0o600 },
+    );
+  }
+
+  await writeReceipt();
+
+  const sockets = new Set<net.Socket>();
+  const control = net.createServer((socket) => {
+    sockets.add(socket);
+    socket.once('close', () => sockets.delete(socket));
+    const timer = setTimeout(() => socket.destroy(), 1_000);
+    timer.unref();
+    socket.once('close', () => clearTimeout(timer));
+    socket.on('error', () => socket.destroy());
+    let data = '';
+    let handled = false;
+    socket.on('data', async (chunk) => {
+      if (handled) return;
+      data += chunk.toString('utf8');
+      if (Buffer.byteLength(data) > 4_096) {
+        socket.destroy();
+        return;
+      }
+      if (!data.endsWith('\n')) return;
+      handled = true;
+      try {
+        const cmd = JSON.parse(data) as {
+          cmd?: string;
+          mode?: 'confirmed' | 'delivered' | 'unconfirmed';
+          workspacePath?: string;
+          sessionId?: string;
+          ownerScope?: string;
+          sourceGeneration?: string;
+        };
+        if (cmd.cmd === 'set-mode' && cmd.mode) {
+          deliveryMode = cmd.mode;
+          await writeReceipt();
+          socket.end(`${JSON.stringify({ ok: true, mode: deliveryMode })}\n`);
+          return;
+        }
+        if (cmd.cmd === 'remove-task' && cmd.workspacePath && cmd.sessionId) {
+          tasks.delete(`${cmd.workspacePath}::${cmd.sessionId}`);
+          if (activeSessionId === cmd.sessionId) activeSessionId = null;
+          await writeReceipt();
+          socket.end(`${JSON.stringify({ ok: true, sourceGeneration })}\n`);
+          return;
+        }
+        if (cmd.cmd === 'rotate-account') {
+          ownerScope = cmd.ownerScope ?? `cindy-account:${randomUUID()}`;
+          sourceGeneration = cmd.sourceGeneration ?? String(Number(sourceGeneration) + 1);
+          activeSessionId = null;
+          const nextOwnerEpoch = hashCindyOwnerScopeKey(ownerScope)!;
+          await bridge.rotateGrant({ ownerEpoch: nextOwnerEpoch, bumpGeneration: true });
+          await writeReceipt();
+          socket.end(
+            `${JSON.stringify({
+              ok: true,
+              generation: bridge.grant.generation,
+              ownerEpoch: nextOwnerEpoch,
+              sourceGeneration,
+            })}\n`,
+          );
+          return;
+        }
+        if (cmd.cmd === 'status') {
+          await writeReceipt();
+          socket.end(
+            `${JSON.stringify({
+              ok: true,
+              metadataReads,
+              unauthorizedMetadataReads,
+              deepLinkDispatches: deepLinkLog.length,
+            })}\n`,
+          );
+          return;
+        }
+        socket.destroy();
+      } catch {
+        socket.destroy();
+      }
+    });
+  });
+
+  await new Promise<void>((resolve, reject) => {
+    control.once('error', reject);
+    control.listen(controlPath, resolve);
+  });
+  await chmod(controlPath, 0o600);
+  console.log(
+    JSON.stringify({
+      ready: true,
+      directory,
+      socket: bridge.grant.socketPath,
+      grant: bridge.grantPath,
+      control: controlPath,
+      evidence: evidencePath,
+    }),
+  );
+
+  let closing = false;
+  async function close() {
+    if (closing) return;
+    closing = true;
+    clearTimeout(deadline);
+    for (const socket of sockets) socket.destroy();
+    await bridge.dispose();
+    await new Promise<void>((resolve) => control.close(() => resolve()));
+    await writeReceipt();
+  }
+  const deadline = setTimeout(() => void close(), ttl * 1000);
+  process.once('SIGTERM', () => void close());
+  process.once('SIGINT', () => void close());
+}
+
+void main().catch((error: unknown) => {
+  console.error(error);
+  process.exitCode = 1;
+});
