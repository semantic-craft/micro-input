+// Integration contract: ACK must follow the actual pending utility RPC and reject superseded completion.
+describe('Work Louder utility ownership fence', () => {
+  it('does not relabel an old SDK callback after native ownership returns', async () => {
+    const gate = new WorkLouderOwnershipFence();
