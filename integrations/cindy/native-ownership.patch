+    const oldCallback = gate.wrapInput(consume);
+    oldCallback('initial');
+    await gate.change(1, true, async () => undefined);
+    await gate.change(2, false, async () => undefined);
+    oldCallback('queued-before-transfer');
+    gate.wrapInput(consume)('current');
+    expect(consume.mock.calls).toEqual([['initial'], ['current']]);
+  });
+
+  it('stops admission before waiting and rejects an old delayed drain', async () => {
+    const gate = new WorkLouderOwnershipFence();
+    let finish!: () => void;
+    const old = gate.change(1, true, () => new Promise((resolve) => { finish = resolve; }));
+    expect(gate.suspended).toBe(true);
