+const sink = { update() {}, setAgentKeyPressHandler() {}, setDeviceActivityHandler() {}, setConnectionStatusHandler() {},
+  setHidInputHandler(handler: typeof hid) { hid = handler; }, async dispose() {} };
+const controller = new WorkLouderCodexLightingController(sink, () => { count++; }, undefined, (action) => {
+  if ((action.type === 'voice' && action.phase === 'press') || action.type === 'command') count++;
+});
+const settings = createWorkLouderCodexDefaultSettings();
+settings.layout.encoderMode = 'conversation-scroll';
+controller.applySettings(settings);
+await controller.resumeTaskSlots();
+await mkdir(path.dirname(evidence), { recursive: true, mode: 0o700 });
+const bridge = await startMicroInputOwnershipBridge({ socketPath, readNativeActive: () => !suspended,
+  hooks: { stillFenced: () => suspended,
+    async quiesce() { suspended = true; controller.setOwnershipSuspended(true); return { inputDrained: true, pttDrained: true, lightingDrained: true }; },
+    async resume() { await controller.resumeOwnership(); suspended = false; return true; },
+  } });
+async function receipt() {
+  await writeFile(evidence, JSON.stringify({ native_source: 'WorkLouderCodexLightingController', transport: 'real-unix-socket',
+    backend: 'synthetic-sink', native_install: 'NOT_RUN', physical: 'NOT_RUN', events: rows }, null, 2) + '\n', { mode: 0o600 });
+}
+const sockets = new Set<net.Socket>();
+const control = net.createServer((socket) => {
+  sockets.add(socket); socket.once('close', () => sockets.delete(socket));
+  const timeout = setTimeout(() => socket.destroy(), 1000); timeout.unref();
+  socket.once('close', () => clearTimeout(timeout)); socket.on('error', () => socket.destroy());
+  let data = ''; let handled = false;
+  socket.on('data', async (chunk) => {
+    if (handled) return;
+    data += chunk.toString('utf8');
+    if (Buffer.byteLength(data) > 4096) { socket.destroy(); return; }
+    if (!data.endsWith('\n')) return;
+    handled = true;
+    try {
+      const value: unknown = JSON.parse(data);
+      if (!value || typeof value !== 'object') throw new Error('invalid command');
+      if ('cmd' in value && value.cmd === 'disconnect') {
+        await bridge.close(); disconnected = true;
+        socket.end(JSON.stringify({ disconnected: true, nativeFenced: suspended }) + '\n'); return;
+      }
+      if ('cmd' in value && value.cmd === 'status') {
+        socket.end(JSON.stringify({ nativeFenced: suspended, disconnected }) + '\n'); return;
+      }
+      if (!('eventId' in value) || typeof value.eventId !== 'string' || value.eventId.length > 128
+        || !('control' in value) || (value.control !== 'wide' && value.control !== 'encoder')) throw new Error('invalid event');
+      const prior = events.get(value.eventId);
+      if (prior) { socket.end(JSON.stringify(prior) + '\n'); return; }
+      const before = count;
+      if (value.control === 'wide') {
+        hid?.({ key: 'ACT10', act: 1 }); hid?.({ key: 'ACT11', act: 1 });
+        hid?.({ key: 'ACT10', act: 0 }); hid?.({ key: 'ACT11', act: 0 });
+      } else hid?.({ key: 'ENC_CW', act: 2 });
+      const row = { eventId: value.eventId, control: value.control, nativeBusinessActions: count - before,
+        state: suspended ? 'released' : 'native', disconnected };
+      rows.push(row); events.set(value.eventId, row); await receipt();
+      socket.end(JSON.stringify(row) + '\n');
+    } catch { socket.destroy(); }
+  });
+});
+await new Promise<void>((resolve, reject) => { control.once('error', reject); control.listen(`${socketPath}.control`, resolve); });
+await chmod(`${socketPath}.control`, 0o600);
+console.log(JSON.stringify({ ready: true, socket: socketPath, control: `${socketPath}.control`, evidence }));
+let closing = false;
+async function close() {
+  if (closing) return; closing = true;
+  clearTimeout(deadline);
+  for (const socket of sockets) socket.destroy();
+  await bridge.close();
+  await new Promise<void>((resolve) => control.close(() => resolve()));
+  await controller.dispose(); await receipt();
+}
+const deadline = setTimeout(() => void close(), ttl * 1000);
+process.once('SIGTERM', () => void close()); process.once('SIGINT', () => void close());
+
+}
+void main().catch((error: unknown) => { console.error(error); process.exitCode = 1; });
