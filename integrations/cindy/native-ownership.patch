+++ b/apps/desktop/src/renderer/lib/workLouderCodexOwnership.ts
@@ -0,0 +1,67 @@
+export type HardwareVoiceOwner = { quiesce(): Promise<boolean>; resume(): void };
+
+export function createWorkLouderRendererOwnership() {
+  let enabled = false;
+  let generation = -1;
+  let unconfirmedInput = false;
+  const pending = new Set<Promise<unknown>>();
+  const voices = new Set<HardwareVoiceOwner>();
+  let voiceGeneration = 0;
+  function track<T>(operation: Promise<T>): Promise<T> {
+    pending.add(operation);
+    void operation.then(() => pending.delete(operation), () => pending.delete(operation));
+    return operation;
+  }
+  return {
+    admitted: (expected: number) => enabled && generation === expected,
+    track,
+    markUnconfirmedInput() { unconfirmedInput = true; },
+    registerVoice(voice: HardwareVoiceOwner) {
+      voices.add(voice);
+      voiceGeneration += 1;
+      if (!enabled) void voice.quiesce();
+      else voice.resume();
+      return () => {
+        void voice.quiesce().then((stopped) => { if (stopped && voices.delete(voice)) voiceGeneration += 1; });
+      };
+    },
+    async setState(next: { generation: number; enabled: boolean }): Promise<{ pttDrained: boolean; inputDrained: boolean }> {
+      if (next.generation < generation) return { pttDrained: false, inputDrained: false };
+      generation = next.generation;
+      enabled = next.enabled;
+      if (enabled) {
+        for (const voice of voices) voice.resume();
+        return { pttDrained: false, inputDrained: false };
+      }
+      const checkedVoices = voiceGeneration;
+      const stopped = await Promise.all([...voices].map((voice) => voice.quiesce().catch(() => false)));
+      await Promise.allSettled([...pending]);
+      const current = generation === next.generation && !enabled;
+      return { pttDrained: current && voiceGeneration === checkedVoices && stopped.every(Boolean), inputDrained: current && pending.size === 0 && !unconfirmedInput };
+    },
+  };
+}
+
+export const workLouderRendererOwnership = createWorkLouderRendererOwnership();
+
+export function createPassiveHardwareVoiceOwner(
+  readIdle: () => boolean,
+  trackPending: (operation: Promise<unknown>) => void,
+) {
+  let enabled = false;
+  const pending = new Set<Promise<unknown>>();
+  return {
+    track<T>(operation: Promise<T>): Promise<T> {
+      pending.add(operation);
+      trackPending(operation);
+      void operation.then(() => pending.delete(operation), () => pending.delete(operation));
+      return operation;
+    },
+    async quiesce(): Promise<boolean> {
+      enabled = false;
+      await Promise.allSettled([...pending]);
+      return !enabled && pending.size === 0 && readIdle();
+    },
+    resume() { enabled = true; },
+  };
+}
