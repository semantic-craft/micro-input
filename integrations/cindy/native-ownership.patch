+test('a late native drain cannot release a newer client generation and failed drain keeps fence', async (t) => {
+  const dir = await mkdtemp(path.join(testRoot, 'race-'));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  const socketPath = path.join(dir, 'owner.sock');
+  let finish; let entered;
+  const started = new Promise((resolve) => { entered = resolve; });
+  const handler = createMicroInputOwnershipCoordinator(socketPath, () => false, {
+    quiesce: () => { entered(); return new Promise((resolve) => { finish = resolve; }); },
+    resume: async () => true,
+  });
+  const q = request({ desiredOwner: 'micro-input' });
+  const old = handler(q); await started;
+  const newer = handler({ ...q, desiredOwner: 'native', generation: 2, microDrained: false });
+  finish({ inputDrained: true, pttDrained: true, lightingDrained: true });
+  assert.equal((await old).state, 'unknown');
+  assert.equal((await newer).reason, 'micro_drain_unconfirmed');
+  assert.notEqual(readMicroInputOwnershipFence(socketPath), null);
+});
