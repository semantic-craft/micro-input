+test('release renewal preserves generation and does not restart drains or reject a later client after return', async (t) => {
+  const dir = await mkdtemp(path.join(testRoot, 'renew-'));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  let drains = 0;
+  let fenced = false;
+  const handler = createMicroInputOwnershipCoordinator(path.join(dir, 'owner.sock'), () => !fenced, {
+    quiesce: async () => { drains++; fenced = true; return { inputDrained: true, pttDrained: true, lightingDrained: true }; },
+    resume: async () => { fenced = false; return true; },
+    stillFenced: () => fenced,
+  });
+  const q = request({ desiredOwner: 'micro-input' });
+  const first = await handler(q);
+  const renewed = await handler({ ...q, requestId: randomUUID(), microDrained: false });
+  assert.equal(renewed.state, 'released');
+  assert.equal(renewed.nativeGeneration, first.nativeGeneration); assert.equal(drains, 1);
+  assert.equal((await handler({ ...q, generation: 2, desiredOwner: 'native' })).state, 'native');
+  assert.equal((await handler(q)).state, 'unknown');
+  const next = await handler(request({ desiredOwner: 'micro-input' }));
+  assert.equal(next.state, 'released'); assert.equal(drains, 2);
+});
