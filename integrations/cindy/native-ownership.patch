+  .min(1)
+  .max(4096)
+  .refine((value) => value.trim() === value && !value.includes('\0'));
+
+export const cindyMicroInputScopeSchema = z.strictObject({
+  workspacePath: identifier,
+});
+
+export const cindyMicroInputAddressSchema = cindyMicroInputScopeSchema.extend({
+  sessionId: identifier,
+});
+
+export const cindyMicroInputTaskPhaseSchema = z.enum([
+  'idle',
+  'running',
+  'needs-interaction',
+  'completed',
+  'error',
+]);
+
+export const cindyMicroInputRowSchema = z.strictObject({
+  address: cindyMicroInputAddressSchema,
+  title: z.string().max(4096),
+  phase: cindyMicroInputTaskPhaseSchema,
+  attention: z.boolean(),
+  pinned: z.boolean(),
+});
+
+export const cindyMicroInputGrantSchema = z.strictObject({
+  version: z.literal(1),
+  socketPath: identifier,
+  token: identifier,
+  instanceId: identifier,
+  generation: z.number().int().positive().safe(),
+  ownerEpoch: identifier,
+  scopes: z.array(cindyMicroInputScopeSchema).min(1).max(64),
+});
+
+export const cindyMicroInputRequestSchema = z
+  .strictObject({
+    version: z.literal(1),
+    id: identifier,
+    token: identifier,
+    instanceId: identifier,
+    generation: z.number().int().positive().safe(),
+    ownerEpoch: identifier,
+    op: z.enum(['list', 'open']),
+    scope: cindyMicroInputScopeSchema,
+    target: cindyMicroInputAddressSchema.optional(),
+  })
+  .refine((request) =>
+    request.op === 'open' ? request.target !== undefined : request.target === undefined,
+  );
+
