+// Integration tier: the production UDS endpoint must never turn a missing drain ACK into release.
+// Existing controller unit tests do not cover this new cross-process protocol boundary.
+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import { chmod, lstat, mkdir, mkdtemp, rm } from 'node:fs/promises';
+import net from 'node:net';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import path from 'node:path';
+import { test } from 'node:test';
+import { createMicroInputOwnershipCoordinator, readMicroInputOwnershipFence, startMicroInputOwnershipBridge } from '../apps/desktop/src/main/worklouder-codex/microInputOwnership.ts';
+
+const testRoot = path.resolve(process.env.MI_OWNERSHIP_TEST_ROOT ?? '../socket-tests');
+await mkdir(testRoot, { recursive: true, mode: 0o700 });
+const request = (overrides = {}) => ({ version: 1, requestId: randomUUID(), clientInstance: randomUUID(),
+  generation: 1, desiredOwner: 'native', microDrained: true, ...overrides });
+
+async function exchange(socketPath, value) {
+  return await new Promise((resolve, reject) => {
+    const socket = net.createConnection(socketPath);
+    let bytes = '';
+    socket.setEncoding('utf8');
+    socket.on('connect', () => socket.write(typeof value === 'string' ? value : `${JSON.stringify(value)}\n`));
+    socket.on('data', (data) => { bytes += data; });
+    socket.once('end', () => resolve(bytes ? JSON.parse(bytes) : null));
+    socket.once('error', reject);
+    socket.once('close', () => { if (!bytes) resolve(null); });
+  });
+}
+
+async function fixture(t, readNativeActive = () => true, hooks = undefined) {
+  const dir = await mkdtemp(path.join(testRoot, 'run-'));
+  const socketPath = path.join(dir, 'owner.sock');
+  const server = await startMicroInputOwnershipBridge({ socketPath, readNativeActive, hooks });
+  t.after(async () => { await server.close(); await rm(dir, { recursive: true, force: true }); });
+  return { socketPath, server };
+}
+
+test('active native handshake echoes request identity and updates generation from real reader state', async (t) => {
+  let active = true;
+  const { socketPath } = await fixture(t, () => active);
+  const q = request();
+  const first = await exchange(socketPath, q);
+  assert.equal(first.state, 'native');
+  for (const key of ['version', 'requestId', 'clientInstance', 'generation']) assert.equal(first[key], q[key]);
+  active = false;
+  const second = await exchange(socketPath, request());
+  assert.equal(second.state, 'unknown');
+  assert.equal(second.nativeInstance, first.nativeInstance);
+  assert.ok(second.nativeGeneration > first.nativeGeneration);
+  assert.equal(second.reason, 'native_state_unconfirmed');
+  assert.equal((await lstat(socketPath)).mode & 0o777, 0o600);
+});
+
+test('release request never claims drained or releases; duplicate requests remain harmless', async (t) => {
+  const { socketPath } = await fixture(t);
+  const q = request({ desiredOwner: 'micro-input' });
+  for (let i = 0; i < 2; i++) {
+    const result = await exchange(socketPath, q);
+    assert.equal(result.state, 'unknown');
+    assert.equal(result.reason, 'release_drain_unavailable');
+    assert.deepEqual(result.capabilities, []);
+    for (const key of ['inputDrained', 'pttDrained', 'lightingDrained']) assert.equal(result[key], false);
+  }
+});
+
+test('malformed, oversized, multiplexed and unknown-version requests never read native state', async (t) => {
+  let reads = 0;
+  const { socketPath } = await fixture(t, () => { reads++; return true; });
+  for (const q of [request({ version: 2 }), request({ generation: -1 }), request({ generation: 1.5 }),
+    request({ clientInstance: 'not-a-uuid' }), request({ unrecognized: true }), 'x'.repeat(4_097),
+    `${JSON.stringify(request())}\n${JSON.stringify(request())}\n`]) {
+    assert.equal(await exchange(socketPath, q), null);
+  }
+  assert.equal(reads, 0);
+});
+
+test('second bridge cannot replace a live endpoint; close removes endpoint and restart changes identity', async (t) => {
+  const { socketPath, server } = await fixture(t);
+  const first = await exchange(socketPath, request());
+  await assert.rejects(startMicroInputOwnershipBridge({ socketPath, readNativeActive: () => false }), { code: 'EADDRINUSE' });
+  assert.equal((await exchange(socketPath, request())).nativeInstance, first.nativeInstance);
+  await server.close();
+  await assert.rejects(lstat(socketPath), { code: 'ENOENT' });
+  const second = await startMicroInputOwnershipBridge({ socketPath, readNativeActive: () => true });
+  t.after(() => second.close());
+  assert.notEqual((await exchange(socketPath, request())).nativeInstance, first.nativeInstance);
+});
+
+test('untrusted writable endpoint directory is rejected before opening socket', async (t) => {
+  const dir = await mkdtemp(path.join(testRoot, 'untrusted-'));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  await chmod(dir, 0o777);
+  await assert.rejects(startMicroInputOwnershipBridge({ socketPath: path.join(dir, 'owner.sock'), readNativeActive: () => true }),
+    /ownership_endpoint_directory_untrusted/);
+});
+
+
+test('only completed native drains grant release; owner fence survives restart and blocks foreign takeover', async (t) => {
+  let nativeActive = true;
+  let resumed = 0;
+  const hooks = { quiesce: async () => { nativeActive = false; return { inputDrained: true, pttDrained: true, lightingDrained: true }; },
+    resume: async () => { resumed++; nativeActive = true; return true; } };
+  const { socketPath, server } = await fixture(t, () => nativeActive, hooks);
+  const q = request({ desiredOwner: 'micro-input' });
+  const released = await exchange(socketPath, q);
+  assert.equal(released.state, 'released');
+  assert.deepEqual(released.capabilities, ['fenced-release-v1']);
+  assert.deepEqual(readMicroInputOwnershipFence(socketPath), { clientInstance: q.clientInstance, generation: q.generation });
+  assert.equal((await lstat(`${socketPath}.fence`)).mode & 0o777, 0o600);
+  const unconfirmed = await exchange(socketPath, { ...q, requestId: randomUUID(), desiredOwner: 'native', microDrained: false, generation: 2 });
+  assert.equal(unconfirmed.state, 'unknown'); assert.equal(resumed, 0);
+  await server.close();
+  const restarted = await startMicroInputOwnershipBridge({ socketPath, readNativeActive: () => nativeActive, hooks });
+  t.after(() => restarted.close());
+  const foreign = await exchange(socketPath, request({ desiredOwner: 'native', generation: 3 }));
+  assert.equal(foreign.state, 'unknown'); assert.equal(resumed, 0);
+  const native = await exchange(socketPath, { ...q, requestId: randomUUID(), desiredOwner: 'native', microDrained: true, generation: 3 });
+  assert.equal(native.state, 'native'); assert.equal(resumed, 1);
+  assert.equal(readMicroInputOwnershipFence(socketPath), null);
+});
