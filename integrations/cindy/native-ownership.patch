+
+export interface MicroInputScopedCindyTaskRow {
+  sessionId: string;
+  workspacePath: string;
+  title: string | null;
+  updatedAt: number;
+  userSendAt: number | null;
+  pinnedAt: number | null;
+}
+
+/**
+ * Reads only active, non-hidden, non-worker tasks whose canonical workspace path
+ * (`COALESCE(projectDir, workingDir)`) is explicitly in `allowedWorkspaces`.
+ * Never reads message bodies, summaries, or credentials.
+ */
+export async function listMicroInputScopedCindyTasks(
+  allowedWorkspaces: readonly string[],
+  db: DbClient['drizzle'] = getDbClient().drizzle,
+): Promise<MicroInputScopedCindyTaskRow[]> {
+  if (allowedWorkspaces.length === 0) return [];
+  const workspaceExpr = sql<string>`COALESCE(${sessions.projectDir}, ${sessions.workingDir})`;
+  const rows = await db
+    .select({
+      sessionId: sessions.id,
+      workspacePath: workspaceExpr,
+      title: sessions.title,
+      updatedAt: sessions.updatedAt,
+      userSendAt: sessions.userSendAt,
+      pinnedAt: sessions.pinnedAt,
+    })
+    .from(sessions)
+    .where(
+      and(
+        eq(sessions.status, 'active'),
+        isNull(sessions.hiddenAt),
+        inArray(sessions.source, DESKTOP_TASK_LIST_SESSION_SOURCES),
+        or(isNull(sessions.orcaRole), ne(sessions.orcaRole, 'worker')),
+        inArray(workspaceExpr, [...allowedWorkspaces]),
+      ),
+    )
+    .orderBy(desc(sql`COALESCE(${sessions.userSendAt}, ${sessions.updatedAt})`), desc(sessions.id))
+    .limit(TASK_OPTION_LIMIT);
+
+  return rows.filter(
+    (row) => typeof row.workspacePath === 'string' && row.workspacePath.length > 0,
+  );
+}
+
+/** Checks whether a specific task exists and remains active/visible in the exact workspace. */
+export async function hasMicroInputScopedCindyTask(
+  address: { workspacePath: string; sessionId: string },
+  db: DbClient['drizzle'] = getDbClient().drizzle,
+): Promise<boolean> {
+  const workspaceExpr = sql<string>`COALESCE(${sessions.projectDir}, ${sessions.workingDir})`;
+  const rows = await db
+    .select({ id: sessions.id })
+    .from(sessions)
+    .where(
+      and(
+        eq(sessions.id, address.sessionId),
+        eq(sessions.status, 'active'),
+        isNull(sessions.hiddenAt),
+        inArray(sessions.source, DESKTOP_TASK_LIST_SESSION_SOURCES),
+        or(isNull(sessions.orcaRole), ne(sessions.orcaRole, 'worker')),
+        eq(workspaceExpr, address.workspacePath),
+      ),
+    )
+    .limit(1);
+  return rows.length === 1;
+}
