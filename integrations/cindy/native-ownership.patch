+test('a crashed owned socket remains unknown and keeps its persistent owner fence', async (t) => {
+  const dir = await mkdtemp(path.join(testRoot, 'crash-'));
+  t.after(() => rm(dir, { recursive: true, force: true }));
+  const socketPath = path.join(dir, 'owner.sock');
+  const fenceHandler = createMicroInputOwnershipCoordinator(socketPath, () => false, {
+    quiesce: async () => ({ inputDrained: true, pttDrained: true, lightingDrained: true }),
+    resume: async () => false,
+  });
+  const owner = request({ desiredOwner: 'micro-input' });
+  assert.equal((await fenceHandler(owner)).state, 'released');
+  const originalFence = readMicroInputOwnershipFence(socketPath);
+  const child = spawn(process.execPath, ['-e', `const net=require('net'),fs=require('fs');const s=net.createServer();s.listen(process.argv[1],()=>{fs.chmodSync(process.argv[1],0o600);process.stdout.write('ready')});setTimeout(()=>process.exit(),5000)`, socketPath], { stdio: ['ignore', 'pipe', 'pipe'] });
+  t.after(() => child.kill('SIGKILL'));
+  await once(child.stdout, 'data');
+  const exited = once(child, 'exit'); child.kill('SIGKILL'); await exited;
+  assert.equal((await lstat(socketPath)).isSocket(), true);
+  await assert.rejects(startMicroInputOwnershipBridge({ socketPath, readNativeActive: () => false }), { code: 'EADDRINUSE' });
+  assert.equal((await lstat(socketPath)).isSocket(), true);
+  assert.deepEqual(readMicroInputOwnershipFence(socketPath), originalFence);
+});
