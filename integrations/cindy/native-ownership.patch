+export type CindyMicroInputScope = z.infer<typeof cindyMicroInputScopeSchema>;
+export type CindyMicroInputAddress = z.infer<typeof cindyMicroInputAddressSchema>;
+export type CindyMicroInputTaskPhase = z.infer<typeof cindyMicroInputTaskPhaseSchema>;
+export type CindyMicroInputRow = z.infer<typeof cindyMicroInputRowSchema>;
+export type CindyMicroInputGrant = z.infer<typeof cindyMicroInputGrantSchema>;
+export type CindyMicroInputRequest = z.infer<typeof cindyMicroInputRequestSchema>;
+export type CindyMicroInputConfig = z.infer<typeof cindyMicroInputConfigSchema>;
+export type CindyMicroInputStatus =
+  | 'ok'
+  | 'delivered'
+  | 'confirmed'
+  | 'denied'
+  | 'stale'
+  | 'unavailable'
+  | 'unconfirmed';
