+    finish(); expect(await old).toBe(false);
+    expect(await gate.change(1, false, async () => undefined)).toBe(false);
+    expect(gate.suspended).toBe(true);
+    expect(await gate.change(3, false, async () => undefined)).toBe(true);
+    expect(gate.suspended).toBe(false);
+  });
+  it('does not turn failed drain into release', async () => {
