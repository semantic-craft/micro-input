#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent


def exchange(path, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as peer:
        peer.settimeout(4)
        peer.connect(str(path))
        peer.sendall(json.dumps(request).encode("utf-8") + b"\n")
        data = b""
        while b"\n" not in data:
            chunk = peer.recv(65536)
            if not chunk or len(data) + len(chunk) > 1048576:
                raise ValueError("invalid bridge response")
            data += chunk
        return json.loads(data.split(b"\n", 1)[0].decode("utf-8"))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--skip-build", action="store_true")
    args = parser.parse_args()

    env = dict(os.environ, MI_AUTO_HOST_READY="0")
    static_out = ROOT / ".scratch/antigravity-status/installed-static.json"
    subprocess.run(
        [sys.executable, str(ROOT / "scripts/verify-antigravity-installed-static"), "--output", str(static_out)],
        cwd=ROOT,
        env=env,
        check=True,
    )
    static_receipt = json.loads(static_out.read_text(encoding="utf-8"))
    if static_receipt.get("status") != "PASS":
        raise ValueError("installed static verification did not pass")

    run = ROOT / ".scratch" / ("ag-" + uuid.uuid4().hex[:8])
    run.mkdir(mode=0o700, parents=True)
    ws_alpha = str(run / "ws-alpha")
    ws_beta = str(run / "ws-beta")
    Path(ws_alpha).mkdir(mode=0o700)
    Path(ws_beta).mkdir(mode=0o700)

    canary_transcript = run / "canary-transcript.jsonl"
    canary_transcript.write_text('{"secret":"never-read-me"}\n', encoding="utf-8")
    os.chmod(canary_transcript, 0o000)

    canary_token = run / "canary-token.json"
    canary_token.write_text('{"csrfToken":"never-read-token","oauthToken":"secret"}\n', encoding="utf-8")
    os.chmod(canary_token, 0o000)

    bridge_script = ROOT / "integrations/antigravity/hooks-bridge.py"
    grant_path = run / "antigravity-grant.json"
    control_path = run / "control.sock"
    log = (run / "bridge.log").open("w", encoding="utf-8")
    process = None
    try:
        if not args.skip_build:
            subprocess.run(["scripts/build", "--synthetic"], cwd=ROOT, env=env, check=True)
        process = subprocess.Popen(
            [
                sys.executable,
                str(bridge_script),
                "serve",
                "--directory",
                str(run),
                "--instance-id",
                "ag-paired-instance",
                "--generation",
                "1",
                "--workspace",
                ws_alpha,
                "--workspace",
                ws_beta,
                "--ttl",
                "120",
            ],
            cwd=ROOT,
            env=env,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        for _ in range(400):
            if grant_path.exists() and control_path.exists():
                break
            if process.poll() is not None:
                raise ValueError("antigravity bridge exited before ready")
            time.sleep(0.02)
        else:
            raise ValueError("antigravity bridge did not become ready")

        grant = json.loads(grant_path.read_text(encoding="utf-8"))
        subscription_id = str(uuid.uuid4())

        def request(op="subscribe", **extra):
            nonlocal subscription_id
            if op == "subscribe":
                subscription_id = str(uuid.uuid4())
            return dict(
                version=1,
                id=str(uuid.uuid4()),
                token=grant["token"],
                instanceId=grant["instanceId"],
                generation=grant["generation"],
                subscriptionId=subscription_id,
                op=op,
                **extra,
            )

        def stats():
            return exchange(control_path, {"op": "stats"})

        def assert_zero_read_rejection(raw, expected_status=("denied", "stale")):
            before = stats()
            reply = exchange(grant["socketPath"], raw)
            after = stats()
            if reply.get("status") not in expected_status or "rows" in reply or "changes" in reply:
                raise ValueError(f"unauthorized request leaked metadata: {reply}")
            if before["metadataReads"] != after["metadataReads"]:
                raise ValueError("unauthorized request incremented metadataReads")

        def emit_hook(event_name, payload, strict=True):
            receipt_path = run / f"emit-{uuid.uuid4().hex[:8]}.json"
            cmd = [
                sys.executable,
                str(bridge_script),
                "emit",
                "--socket",
                grant["socketPath"],
                "--token",
                grant["token"],
                "--instance-id",
                grant["instanceId"],
                "--generation",
                str(grant["generation"]),
                "--event",
                event_name,
                "--receipt-file",
                str(receipt_path),
            ]
            if strict:
                cmd.append("--strict")
            proc = subprocess.run(
                cmd,
                input=json.dumps(payload),
                text=True,
                capture_output=True,
                cwd=ROOT,
                env=env,
                check=True,
            )
            stdout_obj = json.loads(proc.stdout.strip())
            expected_stdout = {"decision": "allow"} if event_name in ("PreInvocation", "PreToolUse") else {}
            if stdout_obj != expected_stdout:
                raise ValueError(f"unexpected hook stdout for {event_name}: {stdout_obj}")
            return json.loads(receipt_path.read_text(encoding="utf-8"))

        assert_zero_read_rejection({"version": 1, "op": "subscribe", "activate": False})
        bad_token = request(activate=False)
        bad_token["token"] = "unauthorized-" * 4
        assert_zero_read_rejection(bad_token, ("denied",))
        bad_instance = request(activate=False)
        bad_instance["instanceId"] = "other-instance"
        assert_zero_read_rejection(bad_instance, ("stale",))
        assert_zero_read_rejection(request(activate=True), ("denied",))

        forbidden_req = request(activate=False)
        forbidden_req["transcriptPath"] = str(canary_transcript)
        assert_zero_read_rejection(forbidden_req, ("denied",))

        forbidden_token_req = request(activate=False)
        forbidden_token_req["csrfToken"] = str(canary_token)
        assert_zero_read_rejection(forbidden_token_req, ("denied",))

        def emit_catalog(entries_payload, strict=True):
            receipt_path = run / f"catalog-{uuid.uuid4().hex[:8]}.json"
            cmd = [
                sys.executable,
                str(bridge_script),
                "catalog",
                "--socket",
                grant["socketPath"],
                "--token",
                grant["token"],
                "--instance-id",
                grant["instanceId"],
                "--generation",
                str(grant["generation"]),
                "--receipt-file",
                str(receipt_path),
            ]
            if strict:
                cmd.append("--strict")
            subprocess.run(
                cmd,
                input=json.dumps(entries_payload),
                text=True,
                capture_output=True,
                cwd=ROOT,
                env=env,
                check=True,
            )
            return json.loads(receipt_path.read_text(encoding="utf-8"))

        catalog_seed_reply = emit_catalog(
            {
                "entries": [
                    {
                        "conversationId": "conv-alpha",
                        "workspaceUris": [f"file://{ws_alpha}"],
                        "summary": "Shared Investigation",
                        "projectId": "proj-alpha",
                        "modelName": "gemini-2.5-pro",
                        "phase": "idle",
                        "lastEventType": "SessionStart",
                        "transcriptPath": str(canary_transcript),
                        "csrfToken": str(canary_token),
                    },
                    {
                        "conversationId": "conv-beta",
                        "workspaceUris": [f"file://{ws_beta}"],
                        "summary": "Shared Investigation",
                        "projectId": "proj-beta",
                        "modelName": "gemini-2.5-flash",
                        "phase": "idle",
                        "lastEventType": "SessionStart",
                        "transcriptPath": str(canary_transcript),
                        "csrfToken": str(canary_token),
                    },
                ]
            }
        )
        if catalog_seed_reply.get("status") != "ok" or catalog_seed_reply.get("seeded") != 2:
            raise ValueError(f"catalog seed failed: {catalog_seed_reply}")

        unauth_ws = emit_hook(
            "SessionStart",
            {
                "conversationId": "conv-outside",
                "workspacePaths": ["/unauthorized/workspace"],
                "transcriptPath": str(canary_transcript),
                "modelName": "gemini-2.5-pro",
            },
            strict=False,
        )
        if unauth_ws.get("status") != "denied":
            raise ValueError("unauthorized workspace was not denied")

        tool_payload = {
            "conversationId": "conv-alpha",
            "workspacePaths": [ws_alpha],
            "transcriptPath": str(canary_transcript),
            "lastUserInput": "sensitive user prompt body",
            "modelName": "gemini-2.5-pro",
            "invocationNum": 1,
            "stepIdx": 2,
            "executionNum": 1,
            "toolCall": {"name": "run_command", "args": {"CommandLine": "echo secret"}},
        }
        r1 = emit_hook("PreToolUse", tool_payload)
        r2 = emit_hook("PreToolUse", tool_payload)
        if r1.get("status") != "ok" or r2.get("status") != "duplicate" or r1.get("cursor") != r2.get("cursor"):
            raise ValueError(f"duplicate hook event was not deduplicated: {r1} vs {r2}")

        stop_alpha_payload = {
            "conversationId": "conv-alpha",
            "workspacePaths": [ws_alpha],
            "transcriptPath": str(canary_transcript),
            "modelName": "gemini-2.5-pro",
            "terminationReason": "NO_TOOL_CALL",
            "fullyIdle": False,
        }
        s1 = emit_hook("Stop", stop_alpha_payload)
        s2 = emit_hook("Stop", stop_alpha_payload)
        if s1.get("status") != "ok" or s2.get("status") != "duplicate" or s1.get("cursor") != s2.get("cursor"):
            raise ValueError(f"duplicate Stop(fullyIdle=false) was not deduplicated: {s1} vs {s2}")
        emit_hook(
            "Stop",
            {
                "conversationId": "conv-beta",
                "workspacePaths": [ws_beta],
                "transcriptPath": str(canary_transcript),
                "modelName": "gemini-2.5-flash",
                "terminationReason": "NO_TOOL_CALL",
                "fullyIdle": True,
            },
        )

        snapshot = exchange(grant["socketPath"], request(activate=False))
        if (
            snapshot.get("status") != "ok"
            or len(snapshot.get("rows", [])) != 2
            or snapshot.get("transcriptReads") != 0
            or snapshot.get("tokenReads") != 0
        ):
            raise ValueError(f"unexpected subscribe snapshot: {snapshot}")
        active_sub = subscription_id

        bad_schema_open = request(
            "open",
            schemaVersion="missing-or-wrong-schema",
            target={"conversationId": "conv-alpha", "workspacePath": ws_alpha},
        )
        assert_zero_read_rejection(bad_schema_open, ("denied",))

        unauth_ws_open = request(
            "open",
            schemaVersion="antigravity-catalog-nav-v1",
            target={"conversationId": "conv-alpha", "workspacePath": "/unauthorized/workspace"},
        )
        assert_zero_read_rejection(unauth_ws_open, ("denied",))

        contender = request(activate=False)
        assert_zero_read_rejection(contender, ("denied",))
        subscription_id = active_sub
        if exchange(grant["socketPath"], request("close")).get("status") != "ok":
            raise ValueError("failed to close probe subscription")
        stale_close = request("close")
        assert_zero_read_rejection(stale_close, ("denied",))

        swift_result = run / "swift-result.json"
        swift_env = dict(
            env,
            MI_ANTIGRAVITY_PAIRED_GRANT=str(grant_path),
            MI_ANTIGRAVITY_PAIRED_RESULT=str(swift_result),
        )
        with (run / "swift.log").open("w", encoding="utf-8") as swift_log:
            subprocess.run(
                [
                    "swift",
                    "test",
                    "--package-path",
                    "app/MicroInput",
                    "-Xswiftc",
                    "-DMI_SYNTHETIC_BACKEND",
                    "--filter",
                    "AntigravityPairedTests",
                ],
                cwd=ROOT,
                env=swift_env,
                stdout=swift_log,
                stderr=subprocess.STDOUT,
                timeout=90,
                check=True,
            )
        swift = json.loads(swift_result.read_text(encoding="utf-8"))
        if (
            swift.get("status") != "PASS"
            or not swift.get("same_title_isolated")
            or not swift.get("open_a_confirmed")
            or not swift.get("open_b_confirmed")
            or not swift.get("create_project_bound_confirmed")
            or not swift.get("two_sessions_only_target_modified")
            or not swift.get("missing_target_zero_redirect")
            or not swift.get("running_send_queued_next_invocation")
            or not swift.get("query_reconciled_without_resend")
            or not swift.get("stop_isolated_and_stale_noop_confirmed")
            or not swift.get("model_switch_and_thinking_guard_confirmed")
            or swift.get("session_a_phase") != "backgroundActive"
            or swift.get("session_b_phase") != "completed"
            or swift.get("transcript_reads") != 0
            or swift.get("token_reads") != 0
        ):
            raise ValueError(f"Swift paired verification failed: {swift}")

        re_sub = exchange(grant["socketPath"], request(activate=False))
        if re_sub.get("status") != "ok":
            raise ValueError(f"post-Swift subscribe failed: {re_sub}")

        exchange(
            control_path,
            {
                "op": "select-override",
                "target": {"conversationId": "conv-beta", "workspacePath": ws_beta},
            },
        )
        wrong_open = exchange(
            grant["socketPath"],
            request(
                "open",
                schemaVersion="antigravity-catalog-nav-v1",
                target={"conversationId": "conv-alpha", "workspacePath": ws_alpha},
            ),
        )
        if wrong_open.get("status") != "unconfirmed":
            raise ValueError(f"wrong UI selected readback did not return unconfirmed: {wrong_open}")
        exchange(control_path, {"op": "clear-select-override"})

        confirm_alpha = exchange(
            grant["socketPath"],
            request(
                "open",
                schemaVersion="antigravity-catalog-nav-v1",
                target={"conversationId": "conv-alpha", "workspacePath": ws_alpha},
            ),
        )
        if confirm_alpha.get("status") != "ok":
            raise ValueError(f"confirm alpha failed: {confirm_alpha}")

        exchange(control_path, {"op": "set-in-flight-steer", "enabled": True})
        steered_reply = exchange(
            grant["socketPath"],
            request(
                "send",
                schemaVersion="antigravity-agentapi-v1",
                intent={
                    "requestId": "probe-steered-alpha-1",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "projectId": "proj-alpha",
                    "message": "Explicit steer on backgroundActive alpha",
                    "deliveryMode": "steer",
                },
            ),
        )
        exchange(control_path, {"op": "set-in-flight-steer", "enabled": False})
        if (
            steered_reply.get("status") != "steered"
            or steered_reply.get("delivery") != "steered"
            or steered_reply.get("inFlightSteering") is not True
            or "message" in steered_reply
        ):
            raise ValueError(f"explicit in-flight steer failed or leaked plaintext: {steered_reply}")

        stats_before_unknown = stats()
        exchange(control_path, {"op": "unknown-next-command", "enabled": True})
        unknown_reply = exchange(
            grant["socketPath"],
            request(
                "send",
                schemaVersion="antigravity-agentapi-v1",
                intent={
                    "requestId": "probe-unknown-alpha-2",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "projectId": "proj-alpha",
                    "message": "Unknown delivery test message",
                    "deliveryMode": "queue",
                },
            ),
        )
        if unknown_reply.get("status") != "unknown" or unknown_reply.get("reasonCode") != "bridge.deliveryUnconfirmed":
            raise ValueError(f"unknown-next-command did not return unknown: {unknown_reply}")
        reconciled_reply = exchange(
            grant["socketPath"],
            request(
                "query",
                schemaVersion="antigravity-agentapi-v1",
                intent={
                    "requestId": "probe-unknown-alpha-2",
                    "expectedOp": "send",
                    "conversationId": "conv-alpha",
                    "workspacePath": ws_alpha,
                    "projectId": "proj-alpha",
                },
            ),
        )
        stats_after_reconcile = stats()
        if (
            reconciled_reply.get("status") != "queued"
            or reconciled_reply.get("reconciled") is not True
            or reconciled_reply.get("duplicate") is not True
            or stats_after_reconcile["sendConfirmed"] != stats_before_unknown["sendConfirmed"] + 1
        ):
            raise ValueError(f"query reconciliation after unknown failed or resent: {reconciled_reply}")

        exchange(
            control_path,
            {
                "op": "set-pending-interaction",
                "conversationId": "conv-alpha",
                "workspacePath": ws_alpha,
                "pendingInteraction": {
                    "interactionId": "int-paired-q1",
                    "interactionType": "question",
                    "stepIndex": 4,
                    "optionIds": ["opt-1", "opt-2"],
                },
            },
        )
        exchange(
            control_path,
            {
                "op": "set-pending-interaction",
                "conversationId": "conv-beta",
                "workspacePath": ws_beta,
                "pendingInteraction": {
                    "interactionId": "int-paired-perm-beta",
                    "interactionType": "filePermission",
                    "stepIndex": 2,
                },
            },
        )
        bad_q_allow = exchange(
            grant["socketPath"],
            request(
                "resolve",
                schemaVersion="antigravity-interaction-v1",
                intent={
                    "requestId": "probe-resolve-q-bad",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "interactionId": "int-paired-q1",
                    "interactionType": "question",
                    "decision": "allow",
                },
            ),
        )
        if bad_q_allow.get("status") != "unconfirmed" or bad_q_allow.get("reasonCode") != "guard.questionCannotApproveAsPermission":
            raise ValueError(f"question approved as permission was not rejected: {bad_q_allow}")

        good_q_answer = exchange(
            grant["socketPath"],
            request(
                "resolve",
                schemaVersion="antigravity-interaction-v1",
                intent={
                    "requestId": "probe-resolve-q-ok",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "interactionId": "int-paired-q1",
                    "interactionType": "question",
                    "decision": "answer",
                    "selectedOptionIds": ["opt-1"],
                },
            ),
        )
        if (
            good_q_answer.get("status") != "resolved"
            or good_q_answer.get("delivery") != "answer"
        ):
            raise ValueError(f"valid question answer failed: {good_q_answer}")

        exchange(
            control_path,
            {
                "op": "set-pending-interaction",
                "conversationId": "conv-alpha",
                "workspacePath": ws_alpha,
                "pendingInteraction": {
                    "interactionId": "int-paired-cmd1",
                    "interactionType": "runCommand",
                    "stepIndex": 5,
                },
            },
        )
        perm_allow = exchange(
            grant["socketPath"],
            request(
                "resolve",
                schemaVersion="antigravity-interaction-v1",
                intent={
                    "requestId": "probe-resolve-cmd-1",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "interactionId": "int-paired-cmd1",
                    "interactionType": "runCommand",
                    "decision": "allow",
                },
            ),
        )
        perm_dup = exchange(
            grant["socketPath"],
            request(
                "resolve",
                schemaVersion="antigravity-interaction-v1",
                intent={
                    "requestId": "probe-resolve-cmd-1",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "interactionId": "int-paired-cmd1",
                    "interactionType": "runCommand",
                    "decision": "allow",
                },
            ),
        )
        beta_row_after_alpha_resolve = next(
            (r for r in perm_allow.get("rows", []) if r.get("conversationId") == "conv-beta"),
            {},
        )
        if (
            perm_allow.get("status") != "resolved"
            or perm_dup.get("status") != "resolved"
            or perm_dup.get("duplicate") is not True
            or (beta_row_after_alpha_resolve.get("pendingInteraction") or {}).get("interactionId") != "int-paired-perm-beta"
        ):
            raise ValueError(f"permission resolve or two-session isolation failed: {perm_allow} / {perm_dup}")

        exchange(
            control_path,
            {
                "op": "set-pending-interaction",
                "conversationId": "conv-alpha",
                "workspacePath": ws_alpha,
                "pendingInteraction": {
                    "interactionId": "int-paired-exp1",
                    "interactionType": "permission",
                    "stepIndex": 6,
                },
            },
        )
        exchange(
            control_path,
            {
                "op": "expire-pending-interaction",
                "conversationId": "conv-alpha",
                "workspacePath": ws_alpha,
                "interactionId": "int-paired-exp1",
            },
        )
        expired_resolve = exchange(
            grant["socketPath"],
            request(
                "resolve",
                schemaVersion="antigravity-interaction-v1",
                intent={
                    "requestId": "probe-resolve-exp-1",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "interactionId": "int-paired-exp1",
                    "interactionType": "permission",
                    "decision": "allow",
                },
            ),
        )
        if expired_resolve.get("status") != "noop" or expired_resolve.get("reasonCode") != "guard.interactionAlreadyResolved":
            raise ValueError(f"expired interaction resolve did not return noop: {expired_resolve}")

        exchange(
            control_path,
            {"op": "set-model-readback-override", "override": {"modelName": "gemini-2.5-pro", "thinkingLevel": "low"}},
        )
        mismatch_model = exchange(
            grant["socketPath"],
            request(
                "switch-model",
                schemaVersion="antigravity-model-config-v1",
                intent={
                    "requestId": "probe-model-mismatch-alpha",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "modelName": "gemini-2.5-pro",
                    "thinkingLevel": "high",
                },
            ),
        )
        exchange(control_path, {"op": "clear-model-readback-override"})
        if mismatch_model.get("status") != "unconfirmed" or mismatch_model.get("reasonCode") != "guard.modelReadbackMismatch":
            raise ValueError(f"model readback mismatch was not rejected: {mismatch_model}")

        raw_rpc_reply = exchange(
            grant["socketPath"],
            request("raw-rpc", method="/exa.language_server_pb.LanguageServerService/DeleteTrajectory"),
        )
        if raw_rpc_reply.get("status") != "denied" or raw_rpc_reply.get("reasonCode") != "error.unsupportedOperation":
            raise ValueError(f"arbitrary RPC was not rejected with error.unsupportedOperation: {raw_rpc_reply}")

        exchange(control_path, {"op": "set-csrf-auth", "verified": False})
        assert_zero_read_rejection(
            request(
                "stop",
                schemaVersion="antigravity-stop-v1",
                intent={
                    "requestId": "probe-stop-no-csrf",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "expectedInvocationNum": 1,
                },
            ),
            ("denied",),
        )
        exchange(control_path, {"op": "set-csrf-auth", "verified": True})

        exchange(control_path, {"op": "set-l3-schema", "stop": False, "approval": False, "modelConfig": False})
        assert_zero_read_rejection(
            request(
                "switch-model",
                schemaVersion="antigravity-model-config-v1",
                intent={
                    "requestId": "probe-model-no-schema",
                    "target": {"conversationId": "conv-alpha", "workspacePath": ws_alpha},
                    "modelName": "gemini-2.5-flash",
                    "thinkingLevel": "medium",
                },
            ),
            ("denied",),
        )
        exchange(control_path, {"op": "set-l3-schema", "stop": True, "approval": True, "modelConfig": True})

        exchange(
            control_path,
            {"op": "delete-session", "conversationId": "conv-beta", "workspacePath": ws_beta},
        )
        deleted_open = exchange(
            grant["socketPath"],
            request(
                "open",
                schemaVersion="antigravity-catalog-nav-v1",
                target={"conversationId": "conv-beta", "workspacePath": ws_beta},
            ),
        )
        if (
            deleted_open.get("status") != "unconfirmed"
            or deleted_open.get("selected") != {"conversationId": "conv-alpha", "workspacePath": ws_alpha}
        ):
            raise ValueError(f"deleted target redirected or failed unexpectedly: {deleted_open}")

        deleted_send = exchange(
            grant["socketPath"],
            request(
                "send",
                schemaVersion="antigravity-agentapi-v1",
                intent={
                    "requestId": "probe-send-deleted-beta",
                    "target": {"conversationId": "conv-beta", "workspacePath": ws_beta},
                    "projectId": "proj-beta",
                    "message": "Send to deleted session must not redirect or create",
                    "deliveryMode": "auto",
                },
            ),
        )
        if (
            deleted_send.get("status") != "unconfirmed"
            or deleted_send.get("reasonCode") != "guard.targetNotFound"
            or deleted_send.get("selected") != {"conversationId": "conv-alpha", "workspacePath": ws_alpha}
            or len(deleted_send.get("rows", [])) != 2
        ):
            raise ValueError(f"deleted target send redirected or created session: {deleted_send}")

        exchange(control_path, {"op": "set-schema-verified", "verified": False})
        assert_zero_read_rejection(
            request(
                "open",
                schemaVersion="antigravity-catalog-nav-v1",
                target={"conversationId": "conv-alpha", "workspacePath": ws_alpha},
            ),
            ("denied",),
        )
        exchange(control_path, {"op": "set-schema-verified", "verified": True})
        if exchange(grant["socketPath"], request("close")).get("status") != "ok":
            raise ValueError("failed to close navigation probe subscription")

        exchange(control_path, {"op": "disconnect"})
        disconnected_reply = exchange(grant["socketPath"], request(activate=False))
        if disconnected_reply.get("status") != "stale":
            raise ValueError(f"disconnected stream did not report stale: {disconnected_reply}")

        exchange(control_path, {"op": "reconnect"})
        reconnected = exchange(grant["socketPath"], request(activate=False))
        if reconnected.get("status") != "ok":
            raise ValueError("reconnect did not restore ok status")

        exchange(control_path, {"op": "expire-heartbeat"})
        expired_reply = exchange(grant["socketPath"], request("read", after=reconnected["cursor"]))
        if expired_reply.get("status") != "stale":
            raise ValueError(f"expired heartbeat did not report stale: {expired_reply}")

        exchange(control_path, {"op": "reconnect"})
        exchange(control_path, {"op": "gap"})
        gapped = exchange(grant["socketPath"], request("read", after=0))
        if gapped.get("status") != "gap":
            raise ValueError("forced gap did not return gap status")
        recovered_after_gap = exchange(grant["socketPath"], request("read", after=reconnected["cursor"]))
        if recovered_after_gap.get("status") != "ok":
            raise ValueError("read after gap did not recover cleanly")

        exchange(control_path, {"op": "rotate"})
        rotated = exchange(grant["socketPath"], request("read", after=reconnected["cursor"]))
        if rotated.get("status") != "stale":
            raise ValueError("rotated generation did not return stale")

        final_stats = stats()
        if (
            final_stats["transcriptReads"] != 0
            or final_stats["tokenReads"] != 0
            or final_stats["openConfirmed"] != 4
            or final_stats["createConfirmed"] != 1
            or final_stats["sendConfirmed"] != 4
            or final_stats["queryRequests"] != 2
            or final_stats["stopConfirmed"] != 1
            or final_stats["resolveConfirmed"] != 2
            or final_stats["switchModelConfirmed"] != 1
            or final_stats["arbitraryRpcRejections"] != 1
            or final_stats["duplicateCommandsDropped"] != 2
            or final_stats["duplicateEventsDropped"] != 2
            or final_stats["ingestedEvents"] != 3
            or final_stats["sessionCount"] != 2
        ):
            raise ValueError(f"unexpected final bridge stats: {final_stats}")

        result = dict(
            status="PASS",
            installed_version=static_receipt["version"],
            language_server_cl=static_receipt["build_cl"],
            bridge_sha256=hashlib.sha256(bridge_script.read_bytes()).hexdigest(),
            transport="real-unix-socket",
            sessions_verified=3,
            same_title_cross_workspace_isolated=True,
            open_confirmed_count=final_stats["openConfirmed"],
            create_confirmed_count=final_stats["createConfirmed"],
            send_confirmed_count=final_stats["sendConfirmed"],
            query_reconciled_count=final_stats["queryRequests"],
            stop_confirmed_count=final_stats["stopConfirmed"],
            resolve_confirmed_count=final_stats["resolveConfirmed"],
            switch_model_confirmed_count=final_stats["switchModelConfirmed"],
            arbitrary_rpc_rejections=final_stats["arbitraryRpcRejections"],
            duplicate_commands_dropped=final_stats["duplicateCommandsDropped"],
            create_binds_project_id="VERIFIED",
            two_sessions_only_target_modified="VERIFIED",
            missing_or_deleted_target_zero_redirect="VERIFIED",
            timeout_unknown_reconciled_without_resend="VERIFIED",
            running_send_default_delivery="NEXT_INVOCATION_QUEUED_VERIFIED",
            running_send_explicit_steer_mode="STEERED_VERIFIED",
            stop_selected_and_stale_noop="VERIFIED",
            resolve_interaction_and_question_guard="VERIFIED",
            switch_model_and_thinking_guard="VERIFIED",
            csrf_and_l3_schema_fail_closed="DENIED_VERIFIED",
            arbitrary_rpc_exposed=False,
            wrong_selected_readback="UNCONFIRMED_VERIFIED",
            deleted_target_no_redirect="VERIFIED",
            missing_schema_fail_closed="DENIED_VERIFIED",
            duplicate_events_dropped=final_stats["duplicateEventsDropped"],
            stop_fully_idle_false_phase=swift["session_a_phase"],
            stop_fully_idle_true_phase=swift["session_b_phase"],
            stream_disconnect="STALE_CONFIRMED",
            generation_rotate="STALE_CONFIRMED",
            journal_gap="GAP_CONFIRMED",
            transcript_reads=0,
            token_reads=0,
            canary_transcript_mode="0000_UNTOUCHED",
            canary_token_mode="0000_UNTOUCHED",
            native_install="NOT_RUN",
            renderer_ui="NOT_RUN",
            physical_key="NOT_RUN",
            git_sha=subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
            working_tree_changes=bool(subprocess.check_output(["git", "status", "--porcelain"], cwd=ROOT)),
        )
    except BaseException as error:
        (run / "result.json").write_text(
            json.dumps({"status": "FAIL", "failure_type": type(error).__name__, "message": str(error)}, indent=2) + "\n",
            encoding="utf-8",
        )
        raise
    finally:
        for canary in (canary_transcript, canary_token):
            try:
                os.chmod(canary, 0o600)
                canary.unlink()
            except FileNotFoundError:
                pass
        if process is not None and process.poll() is None:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
        log.close()
        if not args.skip_build:
            subprocess.run(["scripts/build"], cwd=ROOT, env=env, check=True)

    if process is None or process.poll() is None or any(
        (run / name).exists() for name in ("antigravity-grant.json", "antigravity.sock", "control.sock", "antigravity.lock")
    ):
        raise ValueError("paired fixture cleanup incomplete")
    result["cleanup_confirmed"] = True
    (run / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    print("ANTIGRAVITY_PAIRED_RESULT=" + str(run / "result.json"))


if __name__ == "__main__":
    main()
