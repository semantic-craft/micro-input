#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
export MACOSX_DEPLOYMENT_TARGET=14.0
cargo build --locked -p mi-model --bin mi
cargo build --locked -p mi-ffi
rm -f target/debug/libmi_ffi.dylib
swift build --package-path app/MicroInput
touch target/.metadata_never_index 2>/dev/null || true
bundle=target/MicroInput.app
mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
swift scripts/generate-app-icon.swift
swift scripts/verify-app-icon.swift target/AppIcon.iconset
iconutil -c icns target/AppIcon.iconset -o "$bundle/Contents/Resources/AppIcon.icns"
cp app/MicroInput/.build/debug/MicroInput "$bundle/Contents/MacOS/MicroInput"
cp app/MicroInput/Info.plist "$bundle/Contents/Info.plist"
rm -f "$bundle/Contents/Resources/live-bridge.py" "$bundle/Contents/MacOS/mi-session-navigation"
sign_id="${MI_CODESIGN_IDENTITY:-}"
if [[ -z "$sign_id" ]]; then
  sign_id="$(security find-identity -v -p codesigning 2>/dev/null | sed -n 's/.*"\(Apple Development:[^"]*\)".*/\1/p' | head -n 1 || true)"
fi
codesign --force --sign "${sign_id:--}" "$bundle"
lsreg="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [[ -x "$lsreg" ]]; then
  "$lsreg" -u "$PWD/$bundle" >/dev/null 2>&1 || true
  if [[ -d "/Applications/Micro Input.app" ]]; then
    "$lsreg" -f "/Applications/Micro Input.app" >/dev/null 2>&1 || true
  fi
fi
