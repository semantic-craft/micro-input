#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
export MACOSX_DEPLOYMENT_TARGET=14.0
features=(--no-default-features)
if [[ "${1:-}" == "--synthetic" ]]; then features=(--features synthetic-backend); fi
cargo build --locked -p mi-model --bin mi
cargo build --locked -p mi-ffi "${features[@]}"
mkdir -p target/swift-bindings app/MicroInput/Sources/MicroInputCore app/MicroInput/Sources/MicroInputCoreFFI
cargo run --locked -p mi-ffi "${features[@]}" --bin uniffi-bindgen -- generate --library target/debug/libmi_ffi.dylib --language swift --config crates/mi-ffi/uniffi.toml --out-dir target/swift-bindings
cp target/swift-bindings/MicroInputCore.swift app/MicroInput/Sources/MicroInputCore/
cp target/swift-bindings/MicroInputCoreFFI.h app/MicroInput/Sources/MicroInputCoreFFI/
cp target/swift-bindings/MicroInputCoreFFI.modulemap app/MicroInput/Sources/MicroInputCoreFFI/module.modulemap
swift_flags=(--configuration debug)
if [[ "${1:-}" == "--synthetic" ]]; then swift_flags=(-Xswiftc -DMI_SYNTHETIC_BACKEND); fi
swift build --package-path app/MicroInput "${swift_flags[@]}"
bundle=target/MicroInput.app
mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
swift scripts/generate-app-icon.swift
iconutil -c icns target/AppIcon.iconset -o "$bundle/Contents/Resources/AppIcon.icns"
cp app/MicroInput/.build/debug/MicroInput "$bundle/Contents/MacOS/"
cp app/MicroInput/Info.plist "$bundle/Contents/Info.plist"
codesign --force --sign - "$bundle"
