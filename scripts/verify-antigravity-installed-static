#!/usr/bin/env python3
import argparse
import hashlib
import io
import json
from pathlib import Path
import plistlib
import re
import struct
import subprocess
import zipfile


EXPECTED_ASAR_SHA256S = {
    "290e1b7a1caa430a0c5367c7b433e8d284e2ca5d0b305e91e5ce8ec926f43283",
    "e9b001be46c289d60e0f783e48cf5ab51fa017c71d6e1c066d59457a92eb613f",
}
EXPECTED_LS_CL = "1013060670"

ASAR_MODULES = {
    "package.json": ("version", "2.29.0"),
    "dist/languageServer.js": ("startLanguageServer", "language_server"),
    "dist/hostBridgeServer.js": ("startHostBridgeServer", "127.0.0.1"),
    "dist/preload.js": ("updaterAPI", "extensionsAPI"),
    "dist/customScheme.js": ("registerCustomSchemes", "extensionAuthorities"),
}


def verify_asar(package: Path) -> dict:
    with package.open("rb") as stream:
        asar_sha256 = hashlib.file_digest(stream, "sha256").hexdigest()
    if asar_sha256 not in EXPECTED_ASAR_SHA256S:
        raise ValueError(f"unexpected app.asar sha256: {asar_sha256}")
    with package.open("rb") as stream:
        size_pickle, header_size, payload_size, json_size = struct.unpack("<4I", stream.read(16))
        if (
            size_pickle != 4
            or header_size > 32 * 1024 * 1024
            or payload_size + 4 != header_size
            or json_size > payload_size - 4
        ):
            raise ValueError("invalid ASAR header")
        header = json.loads(stream.read(json_size))
        data_start = 8 + header_size
        package_size = package.stat().st_size
        files = []
        for name, markers in ASAR_MODULES.items():
            entry = header
            for component in name.split("/"):
                entry = entry["files"][component]
            if entry.get("unpacked") or "link" in entry:
                raise ValueError(f"module is not contained in ASAR: {name}")
            start, size = data_start + int(entry["offset"]), int(entry["size"])
            if start < data_start or size < 0 or size > 16 * 1024 * 1024 or start + size > package_size:
                raise ValueError(f"invalid ASAR module bounds: {name}")
            stream.seek(start)
            data = stream.read(size)
            digest = hashlib.sha256(data).hexdigest()
            integrity = entry.get("integrity") or {}
            if integrity.get("algorithm") != "SHA256" or digest != integrity.get("hash"):
                raise ValueError(f"ASAR module integrity mismatch: {name}")
            content = data.decode("utf-8")
            marker_map = {m: (m in content) for m in markers}
            if not all(marker_map.values()):
                raise ValueError(f"missing expected marker in {name}: {marker_map}")
            if name == "package.json":
                pkg = json.loads(content)
                if pkg.get("name") != "antigravity" or pkg.get("version") != "2.29.0":
                    raise ValueError("ASAR package.json identity mismatch")
            files.append(
                {
                    "path": name,
                    "sha256": digest,
                    "integrity_verified": True,
                    "markers": marker_map,
                }
            )
    return {"asar_sha256": asar_sha256, "files": files}


def verify_language_server_and_agentapi(ls_bin: Path) -> dict:
    if not ls_bin.is_file():
        raise ValueError(f"missing language_server binary: {ls_bin}")
    raw_bytes = ls_bin.read_bytes()
    ls_sha256 = hashlib.sha256(raw_bytes).hexdigest()
    stamp_out = subprocess.check_output([str(ls_bin), "--stamp"], text=True, timeout=10)
    match = re.search(r"Built at CL:\s*(\d+)", stamp_out)
    if not match or match.group(1) != EXPECTED_LS_CL:
        raise ValueError(f"unexpected language_server CL: {stamp_out.strip()}")
    help_out = subprocess.check_output([str(ls_bin), "agentapi", "--help"], text=True, timeout=10)
    commands = []
    for cmd in ("get-conversation-metadata", "new-conversation", "send-message"):
        if cmd not in help_out:
            raise ValueError(f"agentapi help missing command: {cmd}")
        commands.append(cmd)
    new_conv_help = subprocess.check_output(
        [str(ls_bin), "agentapi", "new-conversation", "--help"], text=True, timeout=10
    )
    send_msg_help = subprocess.check_output(
        [str(ls_bin), "agentapi", "send-message", "--help"], text=True, timeout=10
    )
    meta_help = subprocess.check_output(
        [str(ls_bin), "agentapi", "get-conversation-metadata", "--help"], text=True, timeout=10
    )
    if (
        "--model=" not in new_conv_help
        or "--title=" not in new_conv_help
        or "<recipient_id>" not in send_msg_help
        or "<content>" not in send_msg_help
        or "<conversation_id>" not in meta_help
    ):
        raise ValueError("agentapi subcommand help flags differ from expected contract")
    agentapi_explicit_steer_flag = (
        "--steer" in send_msg_help or "--delivery-strategy" in send_msg_help
    )
    if agentapi_explicit_steer_flag:
        raise ValueError("unexpected explicit steer flag in agentapi send-message help")
    required_proto_markers = (
        b"GetConversationMetadataRequest",
        b"GetConversationMetadataResponse",
        b"GetAllCascadeTrajectories",
        b"CascadeTrajectorySummary",
        b"CortexTrajectoryMetadata",
        b"CortexWorkspaceMetadata",
        b"workspace_folder_absolute_uri",
        b"x-codeium-csrf-token",
        b"SendAgentMessageRequest",
        b"SendAgentMessageResponse",
        b"NewConversationEvent",
        b"SendMessageEvent",
        b"MessageDeliveryStrategy",
        b"MESSAGE_DELIVERY_STRATEGY_NEXT_INVOCATION",
        b"MESSAGE_DELIVERY_STRATEGY_WHEN_IDLE",
        b"ANTIGRAVITY_PROJECT_ID",
    )
    proto_marker_map = {m.decode("ascii"): (m in raw_bytes) for m in required_proto_markers}
    if not all(proto_marker_map.values()):
        raise ValueError(f"language_server missing expected catalog/navigation/agentapi proto markers: {proto_marker_map}")

    stop_proto_markers = (
        b"/exa.language_server_pb.LanguageServerService/CancelCascadeInvocation",
        b"CancelCascadeInvocationRequest",
        b"CancelCascadeInvocationResponse",
        b"CancelCascadeStepsRequest",
        b'protobuf:"bytes,1,opt,name=cascade_id,json=cascadeId,proto3"',
        b'protobuf:"varint,2,opt,name=kill_background_tasks,json=killBackgroundTasks,proto3"',
        b'protobuf:"varint,3,opt,name=notify_parent,json=notifyParent,proto3,oneof"',
        b"x-codeium-csrf-token",
    )
    stop_marker_map = {m.decode("ascii"): (m in raw_bytes) for m in stop_proto_markers}
    if not all(stop_marker_map.values()):
        raise ValueError(f"language_server missing expected stop proto schema markers: {stop_marker_map}")

    approval_proto_markers = (
        b"/exa.language_server_pb.LanguageServerService/HandleCascadeUserInteraction",
        b"HandleCascadeUserInteractionRequest",
        b"HandleCascadeUserInteractionResponse",
        b"CascadeUserInteraction",
        b"PermissionInteraction",
        b"FilePermissionInteraction",
        b"CascadeRunCommandInteraction",
        b"AskQuestionInteraction",
        b"ApprovalInteraction",
        b'protobuf:"bytes,1,opt,name=trajectory_id,json=trajectoryId,proto3"',
        b'protobuf:"varint,2,opt,name=step_index,json=stepIndex,proto3"',
        b'protobuf:"bytes,5,opt,name=run_command,json=runCommand,proto3,oneof"',
        b'protobuf:"bytes,19,opt,name=file_permission,json=filePermission,proto3,oneof"',
        b'protobuf:"bytes,21,opt,name=permission,proto3,oneof"',
        b'protobuf:"bytes,22,opt,name=ask_question,json=askQuestion,proto3,oneof"',
        b'protobuf:"bytes,23,opt,name=approval_interaction,json=approvalInteraction,proto3,oneof"',
        b'protobuf:"bytes,4,rep,name=selected_option_ids,json=selectedOptionIds,proto3"',
    )
    approval_marker_map = {m.decode("ascii"): (m in raw_bytes) for m in approval_proto_markers}
    if not all(approval_marker_map.values()):
        raise ValueError(f"language_server missing expected approval/interaction proto schema markers: {approval_marker_map}")

    model_config_proto_markers = (
        b"/exa.language_server_pb.LanguageServerService/GetCascadeModelConfigs",
        b"GetCascadeModelConfigsRequest",
        b"GetCascadeModelConfigsResponse",
        b"ClientModelConfig",
        b"ModelOrAlias",
        b"CascadeConfig",
        b"CascadePlannerConfig",
        b"CascadeConversationalPlannerConfig",
        b"ThinkingLevel",
        b"THINKING_LEVEL_LOW",
        b"THINKING_LEVEL_MEDIUM",
        b"THINKING_LEVEL_HIGH",
        b'protobuf:"bytes,1,rep,name=client_model_configs,json=clientModelConfigs,proto3"',
        b'protobuf:"bytes,2,opt,name=model_or_alias,json=modelOrAlias,proto3"',
        b'protobuf:"bytes,1,opt,name=planner_config,json=plannerConfig,proto3"',
        b'protobuf:"bytes,13,opt,name=requested_model,json=requestedModel,proto3"',
        b'protobuf:"varint,19,opt,name=thinking_level,json=thinkingLevel,proto3"',
        b'protobuf:"varint,9,rep,packed,name=supported_thinking_levels,json=supportedThinkingLevels,proto3,enum=google.gca.aicode.v1main.FetchConfigResponse_ThinkingConfig_ThinkingLevel"',
    )
    model_config_marker_map = {m.decode("ascii"): (m in raw_bytes) for m in model_config_proto_markers}
    if not all(model_config_marker_map.values()):
        raise ValueError(f"language_server missing expected model/thinking proto schema markers: {model_config_marker_map}")

    jetbox_web = verify_embedded_jetbox_web(raw_bytes)

    return {
        "language_server_sha256": ls_sha256,
        "build_cl": match.group(1),
        "agentapi_commands": commands,
        "agentapi_explicit_steer_flag": agentapi_explicit_steer_flag,
        "catalog_proto_markers": proto_marker_map,
        "stop_proto_markers": stop_marker_map,
        "approval_proto_markers": approval_marker_map,
        "model_config_proto_markers": model_config_marker_map,
        "jetbox_web": jetbox_web,
    }


def verify_embedded_jetbox_web(raw_bytes: bytes) -> dict:
    eocd_sig = b"PK\x05\x06"
    eocd_pos = raw_bytes.rfind(eocd_sig)
    while eocd_pos != -1:
        eocd = raw_bytes[eocd_pos : eocd_pos + 22]
        if len(eocd) >= 22:
            _, _, _, _, _, cd_size, cd_offset, _ = struct.unpack("<4sHHHHIIH", eocd[:22])
            zip_start = eocd_pos - cd_size - cd_offset
            if 0 <= zip_start < eocd_pos and raw_bytes[zip_start : zip_start + 4] == b"PK\x03\x04":
                zip_bytes = raw_bytes[zip_start : eocd_pos + 22]
                with zipfile.ZipFile(io.BytesIO(zip_bytes)) as archive:
                    names = set(archive.namelist())
                    if {"main.js", "audio_processor.js"}.issubset(names):
                        main_js = archive.read("main.js").decode("utf-8")
                        audio_js = archive.read("audio_processor.js").decode("utf-8")
                        required_main_markers = (
                            "conversation.selectPrevious",
                            "conversation.selectNext",
                            "openConvoPicker",
                            "openNewConversation",
                            "toggleVoiceRecording",
                            "startVoiceRecording",
                            "stopVoiceRecording",
                            "Record Audio",
                            "Stop Recording",
                            "voice-start-button",
                            "voice-end-button",
                            "Start Live Chat",
                            "End Live chat",
                            "/voice/ws",
                            "jetski-voice-proto",
                            "toggleModelSelector",
                            "toggleProjectSelector",
                            "openWorkspaceSelector",
                            "toggleAuxPane",
                            "toggleBottomPane",
                            "splitConvoHorizontal",
                            "focusInput",
                        )
                        marker_map = {m: (m in main_js) for m in required_main_markers}
                        if not all(marker_map.values()):
                            raise ValueError(f"embedded jetbox_web main.js missing markers: {marker_map}")
                        if "AudioStreamingProcessor" not in audio_js:
                            raise ValueError("embedded jetbox_web audio_processor.js missing AudioStreamingProcessor")
                        return {
                            "zip_sha256": hashlib.sha256(zip_bytes).hexdigest(),
                            "main_js_sha256": hashlib.sha256(main_js.encode("utf-8")).hexdigest(),
                            "audio_processor_js_sha256": hashlib.sha256(audio_js.encode("utf-8")).hexdigest(),
                            "markers": marker_map,
                        }
        eocd_pos = raw_bytes.rfind(eocd_sig, 0, eocd_pos)
    raise ValueError("embedded jetbox_web archive not found in language_server")


def verify_sidecar_sdk(sdk_dir: Path) -> dict:
    pkg_path = sdk_dir / "package.json"
    index_path = sdk_dir / "index.mjs"
    preload_path = sdk_dir / "preload.js"
    for p in (pkg_path, index_path, preload_path):
        if not p.is_file():
            raise ValueError(f"missing sidecar_sdk file: {p}")
    pkg = json.loads(pkg_path.read_text(encoding="utf-8"))
    if pkg.get("name") != "sidecar_sdk" or pkg.get("version") != "1.0.0":
        raise ValueError("sidecar_sdk package.json version mismatch")
    index_text = index_path.read_text(encoding="utf-8")
    preload_text = preload_path.read_text(encoding="utf-8")
    required_index = (
        "ANTIGRAVITY_LS_ADDRESS",
        "ANTIGRAVITY_CSRF_TOKEN",
        "ANTIGRAVITY_SIDECAR_WEB_PORT",
        "ANTIGRAVITY_SIDECAR_UI_TOKEN",
        "ANTIGRAVITY_PROJECT_ID",
        "x-sidecar-token",
        "/_sidecar/send-message",
        "/_sidecar/new-conversation",
        "/_sidecar/get-conversation-metadata",
    )
    required_preload = (
        "X-Sidecar-Token",
        "conversationMetadata",
        "workspaceUris",
        "toggle-conversation",
        "workspace-change",
    )
    if not all(m in index_text for m in required_index):
        raise ValueError("sidecar_sdk index.mjs missing required contract markers")
    if not all(m in preload_text for m in required_preload):
        raise ValueError("sidecar_sdk preload.js missing required contract markers")
    return {
        "version": pkg["version"],
        "index_sha256": hashlib.sha256(index_text.encode("utf-8")).hexdigest(),
        "preload_sha256": hashlib.sha256(preload_text.encode("utf-8")).hexdigest(),
        "endpoints": [
            "/_sidecar/get-conversation-metadata",
            "/_sidecar/new-conversation",
            "/_sidecar/send-message",
        ],
        "ui_messages": [
            "workspace-change",
            "toggle-conversation",
        ],
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--app", type=Path, default=Path("/Applications/Antigravity.app"))
    parser.add_argument(
        "--sidecar-sdk",
        type=Path,
        default=Path.home() / ".gemini/antigravity/lib/node_modules/sidecar_sdk",
    )
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    info = plistlib.loads((args.app / "Contents/Info.plist").read_bytes())
    if (
        info.get("CFBundleIdentifier") != "com.google.antigravity"
        or info.get("CFBundleShortVersionString") != "2.29.0"
    ):
        raise ValueError("installed app is not the verified Antigravity 2.29.0")

    asar_info = verify_asar(args.app / "Contents/Resources/app.asar")
    ls_info = verify_language_server_and_agentapi(args.app / "Contents/Resources/bin/language_server")
    sidecar_info = verify_sidecar_sdk(args.sidecar_sdk)

    capabilities = {
        "status_events_hooks": [
            "SessionStart",
            "PreInvocation",
            "PostInvocation",
            "PreToolUse",
            "PostToolUse",
            "Stop",
        ],
        "stop_fully_idle_field": True,
        "transcript_path_redacted": True,
        "agentapi_commands": ls_info["agentapi_commands"],
        "agentapi_create_binds_project_id": True,
        "agentapi_send_binds_conversation_id": True,
        "agentapi_explicit_steer_flag": ls_info["agentapi_explicit_steer_flag"],
        "agentapi_running_delivery_default": "nextInvocation",
        "sidecar_loopback_only": True,
        "sidecar_ui_messages": sidecar_info["ui_messages"],
        "catalog_proto_markers": ls_info["catalog_proto_markers"],
        "stop_proto_markers": ls_info["stop_proto_markers"],
        "approval_proto_markers": ls_info["approval_proto_markers"],
        "model_config_proto_markers": ls_info["model_config_proto_markers"],
        "catalog_navigation_schema_verified": True,
        "stop_schema_verified": True,
        "approval_schema_verified": True,
        "model_config_schema_verified": True,
        "csrf_token_header_required": True,
        "arbitrary_rpc_exposed": False,
        "existing_session_catalog_official": False,
        "exact_window_navigation_official": False,
        "stop_cancel_official_cli": False,
        "approval_resolution_official_cli": False,
    }

    result = {
        "status": "PASS",
        "bundle_id": "com.google.antigravity",
        "version": "2.29.0",
        "build_cl": ls_info["build_cl"],
        "asar_sha256": asar_info["asar_sha256"],
        "language_server_sha256": ls_info["language_server_sha256"],
        "sidecar_sdk": sidecar_info,
        "capabilities": capabilities,
        "files": asar_info["files"],
        "transcript_reads": 0,
        "token_reads": 0,
        "runtime": "NOT_RUN",
        "physical_key": "NOT_RUN",
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(f"Antigravity installed 2.29.0 contract: PASS ({args.output})")


if __name__ == "__main__":
    main()
