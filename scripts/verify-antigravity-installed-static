#!/usr/bin/env python3
import argparse
import hashlib
import json
from pathlib import Path
import plistlib
import re
import struct
import subprocess


EXPECTED_ASAR_SHA256 = "290e1b7a1caa430a0c5367c7b433e8d284e2ca5d0b305e91e5ce8ec926f43283"
EXPECTED_LS_CL = "1013060670"

ASAR_MODULES = {
    "package.json": ("version", "2.29.0"),
    "dist/languageServer.js": ("startLanguageServer", "language_server"),
    "dist/hostBridgeServer.js": ("startHostBridgeServer", "127.0.0.1"),
    "dist/preload.js": ("updaterAPI", "extensionsAPI"),
    "dist/customScheme.js": ("registerCustomSchemes", "extensionAuthorities"),
}


def verify_asar(package: Path) -> dict:
    with package.open("rb") as stream:
        asar_sha256 = hashlib.file_digest(stream, "sha256").hexdigest()
    if asar_sha256 != EXPECTED_ASAR_SHA256:
        raise ValueError(f"unexpected app.asar sha256: {asar_sha256}")
    with package.open("rb") as stream:
        size_pickle, header_size, payload_size, json_size = struct.unpack("<4I", stream.read(16))
        if (
            size_pickle != 4
            or header_size > 32 * 1024 * 1024
            or payload_size + 4 != header_size
            or json_size > payload_size - 4
        ):
            raise ValueError("invalid ASAR header")
        header = json.loads(stream.read(json_size))
        data_start = 8 + header_size
        package_size = package.stat().st_size
        files = []
        for name, markers in ASAR_MODULES.items():
            entry = header
            for component in name.split("/"):
                entry = entry["files"][component]
            if entry.get("unpacked") or "link" in entry:
                raise ValueError(f"module is not contained in ASAR: {name}")
            start, size = data_start + int(entry["offset"]), int(entry["size"])
            if start < data_start or size < 0 or size > 16 * 1024 * 1024 or start + size > package_size:
                raise ValueError(f"invalid ASAR module bounds: {name}")
            stream.seek(start)
            data = stream.read(size)
            digest = hashlib.sha256(data).hexdigest()
            integrity = entry.get("integrity") or {}
            if integrity.get("algorithm") != "SHA256" or digest != integrity.get("hash"):
                raise ValueError(f"ASAR module integrity mismatch: {name}")
            content = data.decode("utf-8")
            marker_map = {m: (m in content) for m in markers}
            if not all(marker_map.values()):
                raise ValueError(f"missing expected marker in {name}: {marker_map}")
            if name == "package.json":
                pkg = json.loads(content)
                if pkg.get("name") != "antigravity" or pkg.get("version") != "2.29.0":
                    raise ValueError("ASAR package.json identity mismatch")
            files.append(
                {
                    "path": name,
                    "sha256": digest,
                    "integrity_verified": True,
                    "markers": marker_map,
                }
            )
    return {"asar_sha256": asar_sha256, "files": files}


def verify_language_server_and_agentapi(ls_bin: Path) -> dict:
    if not ls_bin.is_file():
        raise ValueError(f"missing language_server binary: {ls_bin}")
    with ls_bin.open("rb") as stream:
        ls_sha256 = hashlib.file_digest(stream, "sha256").hexdigest()
    stamp_out = subprocess.check_output([str(ls_bin), "--stamp"], text=True, timeout=10)
    match = re.search(r"Built at CL:\s*(\d+)", stamp_out)
    if not match or match.group(1) != EXPECTED_LS_CL:
        raise ValueError(f"unexpected language_server CL: {stamp_out.strip()}")
    help_out = subprocess.check_output([str(ls_bin), "agentapi", "--help"], text=True, timeout=10)
    commands = []
    for cmd in ("get-conversation-metadata", "new-conversation", "send-message"):
        if cmd not in help_out:
            raise ValueError(f"agentapi help missing command: {cmd}")
        commands.append(cmd)
    new_conv_help = subprocess.check_output(
        [str(ls_bin), "agentapi", "new-conversation", "--help"], text=True, timeout=10
    )
    send_msg_help = subprocess.check_output(
        [str(ls_bin), "agentapi", "send-message", "--help"], text=True, timeout=10
    )
    if "--model=" not in new_conv_help or "<recipient_id>" not in send_msg_help:
        raise ValueError("agentapi subcommand help flags differ from expected contract")
    return {
        "language_server_sha256": ls_sha256,
        "build_cl": match.group(1),
        "agentapi_commands": commands,
    }


def verify_sidecar_sdk(sdk_dir: Path) -> dict:
    pkg_path = sdk_dir / "package.json"
    index_path = sdk_dir / "index.mjs"
    preload_path = sdk_dir / "preload.js"
    for p in (pkg_path, index_path, preload_path):
        if not p.is_file():
            raise ValueError(f"missing sidecar_sdk file: {p}")
    pkg = json.loads(pkg_path.read_text(encoding="utf-8"))
    if pkg.get("name") != "sidecar_sdk" or pkg.get("version") != "1.0.0":
        raise ValueError("sidecar_sdk package.json version mismatch")
    index_text = index_path.read_text(encoding="utf-8")
    preload_text = preload_path.read_text(encoding="utf-8")
    required_index = (
        "ANTIGRAVITY_LS_ADDRESS",
        "ANTIGRAVITY_CSRF_TOKEN",
        "ANTIGRAVITY_SIDECAR_WEB_PORT",
        "ANTIGRAVITY_PROJECT_ID",
        "/_sidecar/send-message",
        "/_sidecar/new-conversation",
        "/_sidecar/get-conversation-metadata",
    )
    required_preload = (
        "X-Sidecar-Token",
        "toggle-conversation",
        "workspace-change",
    )
    if not all(m in index_text for m in required_index):
        raise ValueError("sidecar_sdk index.mjs missing required contract markers")
    if not all(m in preload_text for m in required_preload):
        raise ValueError("sidecar_sdk preload.js missing required contract markers")
    return {
        "version": pkg["version"],
        "index_sha256": hashlib.sha256(index_text.encode("utf-8")).hexdigest(),
        "preload_sha256": hashlib.sha256(preload_text.encode("utf-8")).hexdigest(),
        "endpoints": [
            "/_sidecar/get-conversation-metadata",
            "/_sidecar/new-conversation",
            "/_sidecar/send-message",
        ],
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--app", type=Path, default=Path("/Applications/Antigravity.app"))
    parser.add_argument(
        "--sidecar-sdk",
        type=Path,
        default=Path.home() / ".gemini/antigravity/lib/node_modules/sidecar_sdk",
    )
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    info = plistlib.loads((args.app / "Contents/Info.plist").read_bytes())
    if (
        info.get("CFBundleIdentifier") != "com.google.antigravity"
        or info.get("CFBundleShortVersionString") != "2.29.0"
    ):
        raise ValueError("installed app is not the verified Antigravity 2.29.0")

    asar_info = verify_asar(args.app / "Contents/Resources/app.asar")
    ls_info = verify_language_server_and_agentapi(args.app / "Contents/Resources/bin/language_server")
    sidecar_info = verify_sidecar_sdk(args.sidecar_sdk)

    capabilities = {
        "status_events_hooks": [
            "SessionStart",
            "PreInvocation",
            "PostInvocation",
            "PreToolUse",
            "PostToolUse",
            "Stop",
        ],
        "stop_fully_idle_field": True,
        "transcript_path_redacted": True,
        "agentapi_commands": ls_info["agentapi_commands"],
        "sidecar_loopback_only": True,
        "existing_session_catalog_official": False,
        "exact_window_navigation_official": False,
        "stop_cancel_official_cli": False,
        "approval_resolution_official_cli": False,
    }

    result = {
        "status": "PASS",
        "bundle_id": "com.google.antigravity",
        "version": "2.29.0",
        "build_cl": ls_info["build_cl"],
        "asar_sha256": asar_info["asar_sha256"],
        "language_server_sha256": ls_info["language_server_sha256"],
        "sidecar_sdk": sidecar_info,
        "capabilities": capabilities,
        "files": asar_info["files"],
        "transcript_reads": 0,
        "runtime": "NOT_RUN",
        "physical_key": "NOT_RUN",
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(f"Antigravity installed 2.29.0 contract: PASS ({args.output})")


if __name__ == "__main__":
    main()
