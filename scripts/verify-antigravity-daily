#!/usr/bin/env python3
"""Slice P daily-acceptance driver: two real Antigravity conversations through
the live bridge (integrations/antigravity/live-bridge.py) against the
installed 2.29.0 app: navigate / send / stop / resolve-guard / status,
plus unauthorized-rejection and duplicate-idempotency guards.
"""
import argparse
import json
from pathlib import Path
import socket
import subprocess
import time
import uuid

CATALOG_NAV = "antigravity-catalog-nav-v1"
AGENTAPI = "antigravity-agentapi-v1"
STOP_V = "antigravity-stop-v1"
INTERACTION_V = "antigravity-interaction-v1"


class Bridge:
    def __init__(self, run_dir: Path):
        self.grant = json.loads((run_dir / "antigravity-grant.json").read_text())

    def call(self, op, **extra):
        req = dict(
            version=1,
            subscriptionId="micro-input-daily-driver",
            id=str(uuid.uuid4()),
            token=self.grant["token"],
            instanceId=self.grant["instanceId"],
            generation=self.grant["generation"],
            op=op,
            **extra,
        )
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(180)
            sock.connect(self.grant["socketPath"])
            sock.sendall(json.dumps(req).encode() + b"\n")
            data = b""
            while b"\n" not in data:
                chunk = sock.recv(65536)
                if not chunk:
                    raise RuntimeError("bridge closed connection")
                data += chunk
        return json.loads(data.split(b"\n", 1)[0])


def row_by(reply, conv_id):
    for row in reply.get("rows") or []:
        if row.get("conversationId") == conv_id:
            return row
    return None


def wait_phase(bridge, conv_id, phases, timeout=300):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        reply = bridge.call("read")
        row = row_by(reply, conv_id)
        if row is not None:
            last = row
            if row.get("phase") in phases:
                return row
        time.sleep(5)
    return last


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--run-dir", required=True, type=Path)
    parser.add_argument("--result", default=None, type=Path)
    parser.add_argument("--workspace", required=True)
    args = parser.parse_args()
    ws = args.workspace
    checks = {}
    bridge = Bridge(args.run_dir)

    sub = bridge.call("subscribe", activate=False, schemaVersion=CATALOG_NAV)
    checks["subscribe"] = sub.get("status")

    # create two real conversations via agentapi on the installed app
    create_a = bridge.call("create", schemaVersion=AGENTAPI,
                           intent={"requestId": "mi-p-ag-a-" + uuid.uuid4().hex[:8], "workspacePath": ws,
                                   "projectId": "mi-p", "title": "MI-Slice-P-AG-A",
                                   "prompt": "你是 Micro Input Slice P 验收会话 A。请只回复一行：MI-P-AG-A-OK"})
    checks["create_a"] = create_a.get("status")
    conv_a = create_a.get("conversationId")
    create_b = bridge.call("create", schemaVersion=AGENTAPI,
                           intent={"requestId": "mi-p-ag-b-" + uuid.uuid4().hex[:8], "workspacePath": ws,
                                   "projectId": "mi-p", "title": "MI-Slice-P-AG-B",
                                   "prompt": "请先运行命令 sleep 90，然后回复 MI-P-AG-B-DONE"})
    checks["create_b"] = create_b.get("status")
    conv_b = create_b.get("conversationId")

    # duplicate requestId must dedupe
    dup = bridge.call("create", schemaVersion=AGENTAPI,
                      intent={"requestId": create_a.get("requestId") or "dup", "workspacePath": ws,
                              "projectId": "mi-p", "title": "dup", "prompt": "dup"})
    checks["create_a_duplicate"] = dup.get("duplicate") is True

    # navigation: open A, then B; each must confirm via metadata readback
    if conv_a and conv_b:
        open_a = bridge.call("open", schemaVersion=CATALOG_NAV, target={"conversationId": conv_a, "workspacePath": ws})
        checks["open_a"] = open_a.get("status")
        open_b = bridge.call("open", schemaVersion=CATALOG_NAV, target={"conversationId": conv_b, "workspacePath": ws})
        checks["open_b"] = open_b.get("status")
        checks["navigation_confirmed"] = open_a.get("status") == "confirmed" and open_b.get("status") == "confirmed"

        # send on A: re-select A first (selected==target guard)
        bridge.call("open", schemaVersion=CATALOG_NAV, target={"conversationId": conv_a, "workspacePath": ws})
        time.sleep(1)
        send_a = bridge.call("send", schemaVersion=AGENTAPI,
                             intent={"requestId": "mi-p-ag-send-" + uuid.uuid4().hex[:8],
                                     "target": {"conversationId": conv_a, "workspacePath": ws},
                                     "content": "请只回复一行：MI-P-AG-A2-OK"})
        checks["send_a"] = {"status": send_a.get("status"), "delivery": send_a.get("delivery")}

        # status feedback: A settles back to idle
        row_a = wait_phase(bridge, conv_a, ("idle", "completed"), timeout=300)
        checks["status_a_settled"] = bool(row_a and row_a.get("phase") in ("idle", "completed"))

        # stop: B runs sleep 90; stop it via CancelCascadeInvocation
        row_b = wait_phase(bridge, conv_b, ("running", "runningTool"), timeout=300)
        checks["status_b_running_seen"] = bool(row_b and row_b.get("phase") in ("running", "runningTool"))
        bridge.call("open", schemaVersion=CATALOG_NAV, target={"conversationId": conv_b, "workspacePath": ws})
        time.sleep(1)
        stop_b = bridge.call("stop", schemaVersion=STOP_V,
                             intent={"requestId": "mi-p-ag-stop-" + uuid.uuid4().hex[:8],
                                     "target": {"conversationId": conv_b, "workspacePath": ws}})
        checks["stop_b"] = stop_b.get("status")
        # late stop must be a noop (already idle)
        late = bridge.call("stop", schemaVersion=STOP_V,
                           intent={"requestId": "mi-p-ag-stop-late-" + uuid.uuid4().hex[:8],
                                   "target": {"conversationId": conv_b, "workspacePath": ws},
                                   "expectedInvocationNum": 1})
        checks["stop_late_noop"] = late.get("status") == "noop"

        # resolve guards: re-select B first (selected==target guard)
        bridge.call("open", schemaVersion=CATALOG_NAV, target={"conversationId": conv_b, "workspacePath": ws})
        time.sleep(1)
        q_guard = bridge.call("resolve", schemaVersion=INTERACTION_V,
                              intent={"requestId": "mi-p-ag-qg-" + uuid.uuid4().hex[:8],
                                      "target": {"conversationId": conv_b, "workspacePath": ws},
                                      "interactionId": "q-1", "interactionType": "question", "decision": "allow"})
        checks["resolve_question_as_permission_blocked"] = q_guard.get("status") == "unconfirmed" and \
            q_guard.get("reasonCode") == "guard.questionCannotApproveAsPermission"
        stale = bridge.call("resolve", schemaVersion=INTERACTION_V,
                            intent={"requestId": "mi-p-ag-rs-" + uuid.uuid4().hex[:8],
                                    "target": {"conversationId": conv_b, "workspacePath": ws},
                                    "interactionId": "stale-1", "interactionType": "permission", "decision": "approve"})
        checks["resolve_stale_noop"] = stale.get("status") == "noop"

    # unauthorized rejection
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(10)
        sock.connect(bridge.grant["socketPath"])
        bad = dict(version=1, subscriptionId="micro-input-daily-driver", id=str(uuid.uuid4()), token="x" * 64,
                   instanceId=bridge.grant["instanceId"], generation=bridge.grant["generation"],
                   op="read", activate=False, schemaVersion=CATALOG_NAV)
        sock.sendall(json.dumps(bad).encode() + b"\n")
        data = b""
        while b"\n" not in data:
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
    bad_reply = json.loads(data.split(b"\n", 1)[0]) if data else {}
    checks["unauthorized_denied"] = bad_reply.get("status") in ("denied", "stale") and not bad_reply.get("rows")

    evidence = {"app": "antigravity", "layer": "installed", "checks": checks,
                "conversation_a": conv_a, "conversation_b": conv_b,
                "physical_key": "NOT_RUN", "transcript_reads": 0, "token_reads": 0,
                "git_sha": subprocess.check_output(["git", "rev-parse", "HEAD"],
                                                   cwd=Path(__file__).resolve().parent.parent, text=True).strip()}
    ok = (checks.get("subscribe") == "ok"
          and checks.get("create_a") == "created" and checks.get("create_b") == "created"
          and checks.get("create_a_duplicate")
          and checks.get("navigation_confirmed")
          and checks.get("send_a", {}).get("status") == "sent"
          and checks.get("status_a_settled")
          and checks.get("status_b_running_seen")
          and checks.get("stop_b") == "stopped"
          and checks.get("stop_late_noop")
          and checks.get("resolve_question_as_permission_blocked")
          and checks.get("resolve_stale_noop")
          and checks.get("unauthorized_denied"))
    evidence["status"] = "PASS" if ok else "FAIL"
    out = args.result or (args.run_dir / "result.json")
    out.write_text(json.dumps(evidence, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(json.dumps(evidence, indent=2, ensure_ascii=False))
    raise SystemExit(0 if ok else 1)


if __name__ == "__main__":
    main()
