#!/usr/bin/env python3
"""Prepare and inspect an offline hardware-acceptance kit. No device I/O exists here."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import uuid

ROOT = Path(__file__).resolve().parent.parent
MAX_BYTES = 4 * 1024 * 1024


def read_regular(path, limit=MAX_BYTES):
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), 'rb') as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError('input must be a regular file')
        data = stream.read(limit + 1)
    if len(data) > limit:
        raise ValueError('input exceeds bounded file policy')
    return data


def write_new(path, data):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())


def encoded(value):
    return (json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + '\n').encode()


def digest(data):
    return {'size': len(data), 'sha1': hashlib.sha1(data).hexdigest(),
            'sha256': hashlib.sha256(data).hexdigest()}


def payloads():
    # The three-byte UTF-8 sequence deliberately crosses the 3072-byte boundary.
    return {'long.bin': ('a' * 3071 + '中😀').encode(), 'short.bin': b'0123456789abcdef' * 4}


def plan(target):
    return {
        'schema': 1, 'execution': 'NOT_AUTHORIZED', 'device_io': 'NOT_RUN',
        'target': target, 'configuration_writes': [], 'lighting_requests': [],
        'preconditions': ['fresh_verified_identity_and_two_file_backup',
                          'resolve_existing_unknown_operations', 'target_absent',
                          'stable_directory_config_and_active_indices',
                          'explicit_execution_authorization'],
        'tempfile_steps': [
            {'action': 'write_readback', 'payload': 'long.bin', 'offsets': [0, 3072]},
            {'action': 'write_readback', 'payload': 'short.bin', 'offsets': [0]},
            {'action': 'write_readback', 'payload': 'long.bin', 'offsets': [0, 3072]},
            {'action': 'delete_verify_absence'},
        ],
        'write_policy': {'method': 'fs.writebin', 'append': True, 'raw_chunk_bytes': 3072,
                         'completed': 'last_chunk_only', 'retry_count': 0,
                         'write_chunks_max': 5, 'delete_attempts_max': 1,
                         'payload_bytes_total': 6220, 'rpc_timeout_seconds': 4,
                         'overall_timeout_seconds': 240},
        'after_each_step': 'full_config_bytes_non_target_directory_and_active_indices_unchanged',
        'on_uncertainty': 'stop_close_record_unknown_no_retry_no_delete_no_restore',
        'later_stages': {'keymap_write': 'BLOCKED_SEPARATE_SCOPE',
                         'rgb_preview': 'BLOCKED_RUNTIME_READBACK_AND_RESTORE_UNKNOWN'},
    }


def selected_files(args):
    if args.keymap is None:
        if args.smart_actions or args.smart_actions_absent:
            raise ValueError('smart-actions selection requires keymap')
        return None
    if not args.smart_actions and not args.smart_actions_absent:
        raise ValueError('explicit smart-actions file or absence is required')
    files = {'keymap.bin': read_regular(args.keymap)}
    if args.smart_actions:
        files['smart-actions.bin'] = read_regular(args.smart_actions)
    return files


def prepare(args):
    baseline = selected_files(args)
    output = args.output or ROOT / '.scratch' / 'input-study' / ('hardware-kit-' + uuid.uuid4().hex)
    output = output.absolute()
    output.parent.mkdir(parents=True, exist_ok=True)
    output.mkdir(mode=0o700)  # Never reuse or overwrite an existing kit.
    fixtures = payloads()
    target = 'mi_' + uuid.uuid4().hex[:12] + '.txt'
    write_new(output / 'plan.json', encoded(plan(target)))
    for name, data in fixtures.items():
        write_new(output / name, data)
    if baseline is not None:
        for name, data in baseline.items():
            write_new(output / name, data)
    manifest = {
        'schema': 1, 'status': 'PREPARED_OFFLINE', 'device_io': 'NOT_RUN',
        'baseline_origin': 'IMPORTED_UNVERIFIED' if baseline is not None else 'NOT_CAPTURED',
        'files': {name: digest(data) for name, data in fixtures.items()},
        'baseline': None if baseline is None else {name: digest(data) for name, data in baseline.items()},
        'smart_actions': 'UNKNOWN' if baseline is None else ('IMPORTED_PRESENT' if 'smart-actions.bin' in baseline else 'ASSERTED_ABSENT'),
        'plan_sha256': hashlib.sha256(read_regular(output / 'plan.json')).hexdigest(),
    }
    write_new(output / 'manifest.json', encoded(manifest))
    directory = os.open(output, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    verify(output)
    return {'status': 'PREPARED_OFFLINE', 'kit': str(output), 'device_io': 'NOT_RUN'}


def verify(kit):
    if kit.is_symlink() or not kit.is_dir() or stat.S_IMODE(kit.stat().st_mode) != 0o700:
        raise ValueError('kit must be a private regular directory (0700)')
    manifest = json.loads(read_regular(kit / 'manifest.json'))
    stored_plan = json.loads(read_regular(kit / 'plan.json'))
    if not isinstance(manifest, dict) or not isinstance(stored_plan, dict):
        raise ValueError('kit metadata must be objects')
    target = stored_plan.get('target', '')
    if len(target) != 19 or not target.startswith('mi_') or not target.endswith('.txt') or any(c not in '0123456789abcdef' for c in target[3:15]):
        raise ValueError('invalid fixed temporary target')
    if stored_plan != plan(target) or manifest.get('schema') != 1 or manifest.get('status') != 'PREPARED_OFFLINE' or manifest.get('device_io') != 'NOT_RUN':
        raise ValueError('kit scope differs from the fixed offline plan')
    if manifest.get('plan_sha256') != hashlib.sha256(read_regular(kit / 'plan.json')).hexdigest():
        raise ValueError('plan digest differs')
    fixtures = payloads()
    if manifest.get('files') != {name: digest(data) for name, data in fixtures.items()}:
        raise ValueError('fixture metadata differs')
    baseline = manifest.get('baseline')
    if baseline is None:
        if manifest.get('baseline_origin') != 'NOT_CAPTURED' or manifest.get('smart_actions') != 'UNKNOWN':
            raise ValueError('missing baseline must remain unknown')
    elif not isinstance(baseline, dict) or set(baseline) not in ({'keymap.bin'}, {'keymap.bin', 'smart-actions.bin'}):
        raise ValueError('invalid baseline inventory')
    else:
        expected = 'IMPORTED_PRESENT' if 'smart-actions.bin' in baseline else 'ASSERTED_ABSENT'
        if manifest.get('baseline_origin') != 'IMPORTED_UNVERIFIED' or manifest.get('smart_actions') != expected:
            raise ValueError('imported baseline cannot claim device verification')
    inventory = dict(manifest['files'], **(baseline or {}))
    if {p.name for p in kit.iterdir()} != set(inventory) | {'plan.json', 'manifest.json'}:
        raise ValueError('unexpected or missing kit file')
    for name in set(inventory) | {'plan.json', 'manifest.json'}:
        path = kit / name
        if path.is_symlink() or stat.S_IMODE(path.stat().st_mode) != 0o600:
            raise ValueError('kit files must be private regular files (0600)')
        data = read_regular(path)
        if name in inventory and digest(data) != inventory[name]:
            raise ValueError('kit file digest differs')
    return manifest


def compare(args):
    manifest = verify(args.kit)
    if manifest['baseline'] is None:
        raise ValueError('no imported baseline to compare')
    after = selected_files(args)
    if after is None:
        raise ValueError('comparison requires explicit after files')
    expected = manifest['baseline']
    same = set(after) == set(expected) and all(data == read_regular(args.kit / name) for name, data in after.items())
    return {'status': 'LOCAL_BYTES_EQUAL' if same else 'LOCAL_BYTES_DIFFER',
            'device_identity_and_freshness': 'NOT_VERIFIED', 'physical_keys': 'NOT_RUN',
            'lighting_visual': 'NOT_RUN', 'runtime_lighting_restore': 'NOT_VERIFIED',
            'device_io': 'NOT_RUN', 'ready_to_execute': False}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    prep = commands.add_parser('prepare', help='create a new private offline kit')
    prep.add_argument('--output', type=Path)
    check = commands.add_parser('verify', help='check local kit integrity, never device readiness')
    check.add_argument('kit', type=Path)
    cmp = commands.add_parser('compare', help='compare locally supplied after files')
    cmp.add_argument('kit', type=Path)
    for command in (prep, cmp):
        command.add_argument('--keymap', type=Path)
        group = command.add_mutually_exclusive_group()
        group.add_argument('--smart-actions', type=Path)
        group.add_argument('--smart-actions-absent', action='store_true')
    args = parser.parse_args(argv)
    try:
        if args.command == 'prepare':
            result = prepare(args)
        elif args.command == 'verify':
            verify(args.kit)
            result = {'status': 'LOCAL_KIT_VALID', 'device_io': 'NOT_RUN', 'ready_to_execute': False}
        else:
            result = compare(args)
        print(json.dumps(result, ensure_ascii=False))
        return 1 if result['status'] == 'LOCAL_BYTES_DIFFER' else 0
    except (OSError, ValueError, TypeError, KeyError) as error:
        reason = str(error) if isinstance(error, ValueError) else type(error).__name__
        print('Offline preparation failed: ' + reason, file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
