#!/usr/bin/env python3
"""Verify the pinned DSH source bridge, actual state producers and renderer selection."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--output", type=Path, default=ROOT / ".scratch/dsh-native-result.json")
    args = parser.parse_args()
    source = args.source.resolve()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    result = {"status": "INCOMPLETE", "cleanup_confirmed": False, "native_app": "NOT_RUN", "physical_key": "NOT_RUN"}
    args.output.write_text(json.dumps(result, indent=2) + "\n")
    expected = (ROOT / "integrations/dsh/BASE_SHA").read_text().strip()
    sha = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=source, text=True).strip()
    diff_command = ["git", "diff", "--no-ext-diff", "--no-color", "--binary", "--src-prefix=a/", "--dst-prefix=b/", "HEAD"]
    patch = subprocess.check_output(diff_command, cwd=source)
    if sha != expected or patch != (ROOT / "integrations/dsh/navigation.patch").read_bytes():
        raise RuntimeError("source does not match pinned base and packaged patch")
    tests = ["apps/desktop-host/tests/micro-input.spec.ts", "apps/desktop-host/tests/micro-input-host.spec.ts",
             "packages/interaction/user-approval/tests/approval.spec.ts",
             "packages/interaction/user-questions/tests/user-questions.spec.ts",
             "packages/client/ui-workspace/tests/workspaces-service.client.spec.ts"]
    changed = subprocess.check_output(["git", "diff", "--name-only", "HEAD"], cwd=source, text=True).splitlines()
    lint_paths = [path for path in changed if path.endswith((".ts", ".tsx"))]
    evidence = args.output.parent / "dsh-native"
    evidence.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="dn-", dir=ROOT / ".scratch") as temporary:
        env = os.environ.copy()
        env.pop("DEEPSEEK_API_KEY", None)
        env["MI_DSH_TEST_ROOT"] = temporary
        commands = [
            ("contracts", ["pnpm", "exec", "tsx", "scripts/compile-referenced-projects.ts", "host-contracts"]),
            ("typecheck", ["pnpm", "exec", "tsc", "-b", "apps/desktop-host", "apps/desktop/tsconfig.host.json", "packages/client/ui-workspace"]),
            ("lint", ["pnpm", "exec", "tsx", "scripts/run-oxlint.ts", *lint_paths]),
            ("tests", ["pnpm", "exec", "vitest", "run", *tests, "--reporter=json", f"--outputFile={evidence / 'tests.json'}"]),
        ]
        for label, command in commands:
            log = evidence / f"{label}.log"
            with log.open("w") as output:
                completed = subprocess.run(command, cwd=source, env=env, stdout=output, stderr=subprocess.STDOUT, timeout=300)
            print(f"{label}: exit={completed.returncode} log={log}", flush=True)
            if completed.returncode:
                raise RuntimeError(f"DSH {label} failed; inspect {log}")
        report = json.loads((evidence / "tests.json").read_text())
        if not report["success"] or report["numFailedTests"] or list(Path(temporary).iterdir()):
            raise RuntimeError("DSH tests failed or left fixture artifacts")
        result.update(status="PASS", source_sha=sha, patch_sha256=hashlib.sha256(patch).hexdigest(),
                      passed_tests=report["numPassedTests"], test_files=len(report["testResults"]),
                      surface="source-uds-state-producers-and-real-workspace-selection",
                      checks=["unauthorized-zero-metadata", "activate-false-no-session-open", "pending-only-journal",
                              "existing-pending-bootstrap", "no-history-materialization", "projection-registration-order",
                              "selected-id-readback", "subscription-generation", "source-replacement", "journal-gap",
                              "optional-bridge-failure-preserves-host", "bridge-close-preserves-host",
                              "create-workspace-bound-readback", "prompt-queue-and-steer-confirmed",
                              "request-id-deduplication", "cancel-queue-remaining-not-all-stopped",
                              "switch-session-no-misstop", "same-session-stale-stop-zero-cancel",
                              "unprovable-turn-atomicity-refused"],
                      timestamp_ms=int(time.time() * 1000))
    if subprocess.check_output(diff_command, cwd=source) != patch:
        raise RuntimeError("native source changed during verification")
    result["cleanup_confirmed"] = True
    args.output.write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
