#!/usr/bin/env python3
"""Check installed DSH rc.5 package identity and interfaces without running its code."""
import argparse
import hashlib
import json
from pathlib import Path
import plistlib
import struct


MODULES = (
    "package.json",
    "dsh/node_modules/@deepseek-ai/dsh-api-session-controller/lib/index.js",
    "dsh/node_modules/@deepseek-ai/dsh-client-ui-workspace/lib/client.js",
    "dsh/node_modules/@deepseek-ai/dsh-agent/lib/index.js",
)
MARKERS = (
    "pendingInput", "observeState", "activate", "sourceFor(address, signal, true)",
    "openSession(target)", "agent/inbox/spliced",
)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--app", type=Path, default=Path("/Applications/DeepSeek Harness.app"))
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    info = plistlib.loads((args.app / "Contents/Info.plist").read_bytes())
    if info.get("CFBundleIdentifier") != "com.deepseek.dsh" or info.get("CFBundleShortVersionString") != "0.2.1-rc.5":
        raise ValueError("installed app is not the verified DSH 0.2.1-rc.5")
    package = args.app / "Contents/Resources/app.asar"
    with package.open("rb") as stream:
        size_pickle, header_size, payload_size, json_size = struct.unpack("<4I", stream.read(16))
        if (size_pickle != 4 or header_size > 32 * 1024 * 1024
                or payload_size + 4 != header_size or json_size > payload_size - 4):
            raise ValueError("invalid ASAR header")
        header = json.loads(stream.read(json_size))
        data_start = 8 + header_size
        package_size = package.stat().st_size
        files = []
        for name in MODULES:
            entry = header
            for component in name.split("/"):
                entry = entry["files"][component]
            if entry.get("unpacked") or "link" in entry:
                raise ValueError("required module is not contained in ASAR")
            start, size = data_start + int(entry["offset"]), entry["size"]
            if start < data_start or size < 0 or size > 16 * 1024 * 1024 or start + size > package_size:
                raise ValueError("invalid ASAR module bounds")
            stream.seek(start)
            data = stream.read(size)
            digest = hashlib.sha256(data).hexdigest()
            integrity = entry["integrity"]
            if integrity.get("algorithm") != "SHA256" or digest != integrity.get("hash"):
                raise ValueError("ASAR module integrity mismatch")
            content = data.decode("utf-8")
            files.append({"path": name, "sha256": digest, "integrity_verified": True,
                          "markers": {marker: marker in content for marker in MARKERS}})
            if name == "package.json" and json.loads(content).get("version") != "0.2.1-rc.5":
                raise ValueError("ASAR package version mismatch")
    controller = files[1]["markers"]
    if (controller["pendingInput"] or controller["observeState"] or controller["activate"]
            or not controller["sourceFor(address, signal, true)"]
            or not controller["agent/inbox/spliced"] or not files[2]["markers"]["openSession(target)"]):
        raise ValueError("installed interfaces differ from the pinned rc.5 contract")
    with package.open("rb") as stream:
        asar_digest = hashlib.file_digest(stream, "sha256").hexdigest()
    result = {"status": "PASS", "version": "0.2.1-rc.5", "asar_sha256": asar_digest,
              "tag": "dsh-v0.2.1-rc.5", "source_sha": "b830ec950faba0a46dda564be3e2d854afed94f1",
              "files": files, "runtime": "NOT_RUN", "source_binary_equivalence": "NOT_PROVEN"}
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(result, indent=2) + "\n")
    print(f"DSH installed rc.5 interfaces: PASS ({args.output})")


if __name__ == "__main__":
    main()
