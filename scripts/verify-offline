#!/usr/bin/env python3
"""Offline gates + isolated app scenarios, with automatic evidence validation and cleanup.
No hardware probe or production app is launched. --qa-only skips unit gates, not builds.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent


def verify_evidence(run, scenario, started, process_alive):
    evidence = run / "evidence"
    launcher = json.loads((evidence / "launcher.json").read_text())
    if launcher["bundle_id"] != "com.semanticcraft.microinput.qa" or launcher["started_ms"] < started:
        raise ValueError("wrong QA identity or stale evidence")
    if not all(launcher.get(k) for k in ("app_bundle_removed", "documents_removed", "preferences_removed")):
        raise ValueError("QA cleanup incomplete")
    if process_alive(launcher["pid"]) or Path(launcher["app_path"]).exists() or Path(launcher["document_dir"]).exists():
        raise ValueError("QA process or temporary files remain")
    result = {"status": "PASS", "scenario": scenario, "cleanup_confirmed": True,
              "physical_key": "NOT_RUN", "lighting_visual": "NOT_RUN"}
    if scenario == "host-execution":
        rows = [json.loads(line) for line in (evidence / "audit.jsonl").read_text().splitlines()]
        if len(rows) != 22 or any(r["outcome"] != "simulated" for r in rows):
            raise ValueError("host simulation receipts incomplete")
        details = {r.get("detail") for r in rows}
        for required_detail in (
            "antigravity/scroll-up",
            "antigravity/scroll-down",
            "antigravity/scroll-to-bottom",
            "no_newline=true (bytes=8)",
        ):
            if required_detail not in details:
                raise ValueError(f"missing host simulation receipt: {required_detail}")
        bindings = {r.get("binding_id") for r in rows}
        if not {"menu-navigate-back", "menu-navigate-forward"}.issubset(bindings) or not any(
            (d or "").endswith("/submit") for d in details
        ):
            raise ValueError("missing back/forward navigation or submit simulation receipt")
        if len({r["profile_id"] for r in rows}) != 6 or sum(r["binding_id"] in ("AG10", "AG11") for r in rows) != 1:
            raise ValueError("profile/wide-key regression")
        if rows[-1]["action_type"] != "macro_sequence" or rows[-1]["detail"] != "steps=2 keys=2 delays=0":
            raise ValueError("local macro simulation receipt missing")
        result["receipt_count"] = len(rows)
    elif scenario == "zcode-navigation":
        navigation = json.loads((evidence / "zcode-navigation.json").read_text())
        expected = {
            "same_name_two_workspaces",
            "selected_readback_matches",
            "selected_only_isolation",
            "duplicate_command_dedup",
            "inflight_steering_vs_queue",
            "late_stop_noop",
            "timeout_same_id_no_replay",
            "create_workspace_readback",
            "question_never_approved_as_permission",
            "expired_and_duplicate_interaction_zero_misapproval",
            "unsupported_thought_not_sent",
            "model_and_thought_readback_consistent",
            "wrong_selected_unconfirmed",
            "deleted_target_no_redirect",
            "generation_change_blocks_old_selection",
            "disconnect_clears_targets",
            "disabled_zero_reads",
            "out_of_scope_zero_reads",
        }
        if (navigation.get("status") != "PASS" or set(navigation.get("checks", {})) != expected
                or not all(value is True for value in navigation["checks"].values())
                or navigation.get("native_app") != "NOT_RUN" or navigation.get("physical_key") != "NOT_RUN"
                or navigation.get("body_reads") != 0):
            raise ValueError("ZCode navigation evidence incomplete or overclaimed")
        rows = [json.loads(line) for line in (evidence / "audit.jsonl").read_text().splitlines()]
        confirmed = [row for row in rows if row["action_type"] == "zcode_open" and row["outcome"] == "confirmed"]
        created = [row for row in rows if row["action_type"] == "zcode_create" and row["outcome"] == "confirmed"]
        steered = [row for row in rows if row["action_type"] == "zcode_send" and row["outcome"] == "steered"]
        queued = [row for row in rows if row["action_type"] == "zcode_send" and row["outcome"] == "queued"]
        unknown = [row for row in rows if row["action_type"] == "zcode_send" and row["outcome"] == "unknown"]
        noop = [row for row in rows if row["action_type"] == "zcode_stop" and row["outcome"] == "noop"]
        stopped = [row for row in rows if row["action_type"] == "zcode_stop" and row["outcome"] == "stopped"]
        resolved = [row for row in rows if row["action_type"] == "zcode_resolve" and row["outcome"] == "resolved"]
        resolve_mismatch = [row for row in rows if row["action_type"] == "zcode_resolve" and row["outcome"] == "interactionTypeMismatch"]
        resolve_noop = [row for row in rows if row["action_type"] == "zcode_resolve" and row["outcome"] == "noop"]
        model_switched = [row for row in rows if row["action_type"] == "zcode_switch_model" and row["outcome"] == "modelSwitched"]
        unsupported_thought = [row for row in rows if row["action_type"] == "zcode_switch_model" and row["outcome"] == "unsupportedThought"]
        if (
            len(confirmed) < 2
            or len(created) != 1
            or len(steered) != 1
            or len(queued) != 1
            or len(unknown) != 1
            or len(noop) != 1
            or len(stopped) != 1
            or len(resolved) != 4
            or len(resolve_mismatch) != 2
            or len(resolve_noop) != 1
            or len(model_switched) != 1
            or len(unsupported_thought) != 1
            or any(row.get("target") != "zcode" or row.get("text_byte_len") is not None for row in rows)
        ):
            raise ValueError("ZCode exact navigation/execution receipts missing")
        result.update(
            zcode_navigation="SYNTHETIC_PASS",
            zcode_execution="SYNTHETIC_PASS",
            zcode_interactions_and_model="SYNTHETIC_PASS",
            native_app="NOT_RUN",
            receipt_count=len(rows),
            body_reads=0,
        )
    elif scenario == "dsh-navigation":
        navigation = json.loads((evidence / "dsh-navigation.json").read_text())
        expected = {
            "disabled_zero_reads",
            "same_name_exact_identity",
            "cold_target_unavailable",
            "pending_only_transitions_retained",
            "selected_id_readback",
            "duplicate_request_no_double_send",
            "queue_and_steer_confirmed_separately",
            "switch_session_no_misstop",
            "same_session_stale_stop_zero_cancel",
            "cancel_queue_remaining_not_all_stopped",
            "unprovable_turn_atomicity_refused",
            "create_workspace_bound_readback",
            "resolve_approval_recorded",
            "already_resolved_noop_zero_side_effect",
            "interaction_type_mismatch_blocked",
            "resolve_question_answered",
            "select_model_readback_confirmed",
            "unsupported_thought_level_locally_refused",
            "wrong_selected_unconfirmed",
            "out_of_scope_zero_reads",
            "deleted_target_no_redirect",
            "host_generation_rejects_old_selection",
            "journal_gap_clears_targets",
            "bridge_subscription_closed",
        }
        if (navigation.get("status") != "PASS" or set(navigation.get("checks", {})) != expected
                or not all(value is True for value in navigation["checks"].values())
                or navigation.get("body_reads") != 0
                or navigation.get("native_app") != "NOT_RUN" or navigation.get("physical_key") != "NOT_RUN"):
            raise ValueError("DSH navigation evidence incomplete or overclaimed")
        rows = [json.loads(line) for line in (evidence / "audit.jsonl").read_text().splitlines()]
        confirmed = [row for row in rows if row["action_type"] == "dsh_open" and row["outcome"] == "confirmed"]
        created = [row for row in rows if row["action_type"] == "dsh_create" and row["outcome"] == "confirmed"]
        steered = [row for row in rows if row["action_type"] == "dsh_prompt" and row["outcome"] == "steered"]
        queued = [row for row in rows if row["action_type"] == "dsh_prompt" and row["outcome"] == "queued"]
        noop = [row for row in rows if row["action_type"] == "dsh_cancel" and row["outcome"] == "noop"]
        cancelled_queue_remaining = [
            row for row in rows if row["action_type"] == "dsh_cancel" and row["outcome"] == "cancelledQueueRemaining"
        ]
        denied_cancel = [row for row in rows if row["action_type"] == "dsh_cancel" and row["outcome"] == "denied"]
        resolved = [row for row in rows if row["action_type"] == "dsh_resolve" and row["outcome"] == "resolved"]
        resolve_mismatch = [
            row for row in rows if row["action_type"] == "dsh_resolve" and row["outcome"] == "interactionTypeMismatch"
        ]
        model_switched = [
            row for row in rows if row["action_type"] == "dsh_switch_model" and row["outcome"] == "modelSwitched"
        ]
        unsupported_thought = [
            row for row in rows if row["action_type"] == "dsh_switch_model" and row["outcome"] == "unsupportedThought"
        ]
        if (
            len(confirmed) < 2
            or len(created) != 1
            or len(steered) < 1
            or len(queued) != 1
            or len(noop) != 1
            or len(cancelled_queue_remaining) != 1
            or len(denied_cancel) != 1
            or len(resolved) != 3
            or len(resolve_mismatch) != 1
            or len(model_switched) != 1
            or len(unsupported_thought) != 1
            or any(row.get("target") != "dsh" or row.get("text_byte_len") is not None for row in rows)
        ):
            raise ValueError("DSH exact navigation/execution receipts missing")
        result.update(
            dsh_navigation="SYNTHETIC_PASS",
            dsh_execution="SYNTHETIC_PASS",
            dsh_interactions_and_model="SYNTHETIC_PASS",
            body_reads=0,
            native_app="NOT_RUN",
            receipt_count=len(rows),
        )
    elif scenario == "cindy-navigation":
        navigation = json.loads((evidence / "cindy-navigation.json").read_text())
        expected = {
            "disabled_zero_reads",
            "scoped_catalog_only",
            "delivered_vs_confirmed_separated",
            "same_name_exact_identity",
            "selected_readback_matches",
            "wrong_selected_unconfirmed",
            "out_of_scope_zero_reads",
            "deleted_target_no_redirect",
            "account_or_generation_change_blocks_old_selection",
            "stop_bound_to_run_and_stale_noop",
            "resolve_bound_and_question_guard",
            "workspace_create_and_target_prompt_steering",
            "unread_tristate_and_pending_round",
        }
        checks = {item["name"]: item["status"] for item in navigation.get("checks", [])}
        if (
            navigation.get("status") != "PASS"
            or set(checks) != expected
            or not all(value == "PASS" for value in checks.values())
            or navigation.get("unauthorized_metadata_reads") != 0
            or navigation.get("local_agent_api_relaxed") is not False
            or navigation.get("native_app") != "NOT_RUN"
            or navigation.get("physical_key") != "NOT_RUN"
        ):
            raise ValueError("Cindy navigation evidence incomplete or overclaimed")
        rows = [json.loads(line) for line in (evidence / "audit.jsonl").read_text().splitlines()]
        cindy_rows = [row for row in rows if row["action_type"] == "cindy_open"]
        delivered = [row for row in cindy_rows if row["outcome"] == "delivered"]
        confirmed = [row for row in cindy_rows if row["outcome"] == "confirmed"]
        unconfirmed = [row for row in cindy_rows if row["outcome"] == "unconfirmed"]
        stale = [row for row in cindy_rows if row["outcome"] == "stale"]
        stop_stopped = [row for row in rows if row["action_type"] == "cindy_stop" and row["outcome"] == "stopped"]
        stop_noop = [row for row in rows if row["action_type"] == "cindy_stop" and row["outcome"] == "noop"]
        resolve_ok = [row for row in rows if row["action_type"] == "cindy_resolve" and row["outcome"] == "resolved"]
        resolve_mismatch = [row for row in rows if row["action_type"] == "cindy_resolve" and row["outcome"] == "interactionTypeMismatch"]
        resolve_noop = [row for row in rows if row["action_type"] == "cindy_resolve" and row["outcome"] == "noop"]
        created_ok = [row for row in rows if row["action_type"] == "cindy_create" and row["outcome"] == "confirmed"]
        send_started = [row for row in rows if row["action_type"] == "cindy_send" and row["outcome"] == "started"]
        send_steered = [row for row in rows if row["action_type"] == "cindy_send" and row["outcome"] == "steered"]
        send_unknown = [row for row in rows if row["action_type"] == "cindy_send" and row["outcome"] == "unknown"]
        query_queued = [row for row in rows if row["action_type"] == "cindy_query" and row["outcome"] == "queued"]
        round_confirmed = [row for row in rows if row["action_type"] == "cindy_next_attention" and row["outcome"] == "confirmed"]
        round_noop = [row for row in rows if row["action_type"] == "cindy_next_attention" and row["outcome"] == "noop"]
        if (
            len(delivered) != 1
            or len(confirmed) < 2
            or len(unconfirmed) != 1
            or len(stale) < 2
            or len(stop_stopped) != 1
            or len(stop_noop) != 2
            or len(resolve_ok) != 1
            or len(resolve_mismatch) != 1
            or len(resolve_noop) != 2
            or len(created_ok) != 1
            or len(send_started) != 1
            or len(send_steered) != 1
            or len(send_unknown) != 2
            or len(query_queued) != 1
            or len(round_confirmed) != 3
            or len(round_noop) != 1
            or any(row.get("target") != "cindy" for row in rows)
        ):
            raise ValueError("Cindy exact navigation/action receipts missing or unexpected")
        result.update(
            cindy_navigation="SYNTHETIC_PASS",
            cindy_actions="SYNTHETIC_PASS",
            unauthorized_metadata_reads=0,
            local_agent_api_relaxed=False,
            native_app="NOT_RUN",
            receipt_count=len(rows),
        )
    elif scenario == "antigravity-status":
        status_doc = json.loads((evidence / "antigravity-status.json").read_text())
        expected = {
            "version_and_capabilities_recorded",
            "disabled_zero_reads",
            "existing_two_sessions_catalog_and_selected_readback_confirmed",
            "same_name_cross_workspace_no_collision",
            "wrong_selected_readback_unconfirmed",
            "two_sessions_isolated",
            "duplicate_events_deduplicated",
            "stop_fully_idle_false_not_completed",
            "stop_fully_idle_true_completed",
            "create_binds_project_id_and_confirms_selected",
            "two_sessions_send_only_modifies_target",
            "running_session_send_steering_verified_separately",
            "missing_or_deleted_target_send_zero_redirect",
            "timeout_unknown_reconciles_without_resend",
            "stop_selected_session_only_and_stale_noop",
            "resolve_interaction_and_question_guard",
            "switch_model_and_thinking_guard",
            "deleted_target_no_redirect",
            "missing_schema_or_auth_fails_closed",
            "l3_schema_or_csrf_invalidation_fails_closed",
            "stream_disconnect_marks_stale",
            "generation_change_marks_stale",
            "journal_gap_marks_unavailable",
            "zero_transcript_reads",
            "zero_token_reads",
            "bridge_subscription_closed",
        }
        if (
            status_doc.get("status") != "PASS"
            or status_doc.get("installed_version") != "2.29.0"
            or status_doc.get("language_server_cl") != "1013060670"
            or status_doc.get("transcript_reads") != 0
            or status_doc.get("token_reads") != 0
            or set(status_doc.get("checks", {})) != expected
            or not all(value is True for value in status_doc["checks"].values())
            or status_doc.get("native_app") != "NOT_RUN"
            or status_doc.get("physical_key") != "NOT_RUN"
        ):
            raise ValueError("Antigravity status/navigation/agentapi/l3 evidence incomplete or overclaimed")
        rows = [json.loads(line) for line in (evidence / "audit.jsonl").read_text().splitlines()]
        confirmed = [row for row in rows if row["action_type"] == "antigravity_open" and row["outcome"] == "confirmed"]
        unconfirmed = [row for row in rows if row["action_type"] == "antigravity_open" and row["outcome"] == "unconfirmed"]
        denied = [row for row in rows if row["action_type"] == "antigravity_open" and row["outcome"] == "denied"]
        created_ok = [row for row in rows if row["action_type"] == "antigravity_create" and row["outcome"] == "created"]
        created_unconfirmed = [row for row in rows if row["action_type"] == "antigravity_create" and row["outcome"] == "unconfirmed"]
        send_started = [row for row in rows if row["action_type"] == "antigravity_send" and row["outcome"] == "started"]
        send_queued = [row for row in rows if row["action_type"] == "antigravity_send" and row["outcome"] == "queued"]
        send_steered = [row for row in rows if row["action_type"] == "antigravity_send" and row["outcome"] == "steered"]
        send_unconfirmed = [row for row in rows if row["action_type"] == "antigravity_send" and row["outcome"] == "unconfirmed"]
        send_unknown = [row for row in rows if row["action_type"] == "antigravity_send" and row["outcome"] == "unknown"]
        query_reconciled = [row for row in rows if row["action_type"] == "antigravity_query" and row["outcome"] == "queued"]
        stop_stopped = [row for row in rows if row["action_type"] == "antigravity_stop" and row["outcome"] == "stopped"]
        stop_noop = [row for row in rows if row["action_type"] == "antigravity_stop" and row["outcome"] == "noop"]
        stop_unconfirmed = [row for row in rows if row["action_type"] == "antigravity_stop" and row["outcome"] == "unconfirmed"]
        stop_denied = [row for row in rows if row["action_type"] == "antigravity_stop" and row["outcome"] == "denied"]
        resolve_resolved = [row for row in rows if row["action_type"] == "antigravity_resolve" and row["outcome"] == "resolved"]
        resolve_unconfirmed = [row for row in rows if row["action_type"] == "antigravity_resolve" and row["outcome"] == "unconfirmed"]
        resolve_noop = [row for row in rows if row["action_type"] == "antigravity_resolve" and row["outcome"] == "noop"]
        model_switched = [row for row in rows if row["action_type"] == "antigravity_switch_model" and row["outcome"] == "modelSwitched"]
        model_unconfirmed = [row for row in rows if row["action_type"] == "antigravity_switch_model" and row["outcome"] == "unconfirmed"]
        if (
            len(confirmed) < 2
            or len(unconfirmed) != 2
            or len(denied) != 1
            or len(created_ok) != 1
            or len(created_unconfirmed) != 1
            or len(send_started) != 1
            or len(send_queued) != 1
            or len(send_steered) != 1
            or len(send_unconfirmed) != 2
            or len(send_unknown) != 1
            or len(query_reconciled) != 1
            or len(stop_stopped) != 1
            or len(stop_noop) != 1
            or len(stop_unconfirmed) != 1
            or len(stop_denied) != 1
            or len(resolve_resolved) != 3
            or len(resolve_unconfirmed) != 1
            or len(resolve_noop) != 1
            or len(model_switched) != 2
            or len(model_unconfirmed) != 2
            or any(row.get("target") != "antigravity" or row.get("text_byte_len") is not None for row in rows)
        ):
            raise ValueError("Antigravity exact navigation/agentapi/l3 receipts missing or unexpected")
        result.update(
            antigravity_status="SYNTHETIC_PASS",
            antigravity_navigation="SYNTHETIC_PASS",
            antigravity_agentapi="SYNTHETIC_PASS",
            antigravity_l3_control="SYNTHETIC_PASS",
            installed_version="2.29.0",
            language_server_cl="1013060670",
            transcript_reads=0,
            token_reads=0,
            receipt_count=len(rows),
            native_app="NOT_RUN",
        )
    elif scenario == "native-ownership":
        ownership = json.loads((evidence / "ownership.json").read_text())
        expected = {"native_blocks_wide_and_encoder", "released_wide_once_encoder_once",
                    "profile_switch_rejects_old_release", "fresh_release_routes_current_profile",
                    "lost_peer_blocks_input", "unknown_blocks_direct_action", "unknown_blocks_ptt_and_lighting",
                    "protected_oai_layer_locks_ui_and_lighting", "cindy_codex_to_workbench_handoff"}
        if (ownership.get("status") != "PASS" or set(ownership.get("checks", {})) != expected
                or not all(value is True for value in ownership["checks"].values())
                or ownership.get("receipt_count") != 3 or ownership.get("native_app") != "NOT_RUN"
                or ownership.get("physical_key") != "NOT_RUN" or ownership.get("lighting_visual") != "NOT_RUN"):
            raise ValueError("native ownership scenario incomplete or overclaimed")
        rows = [json.loads(line) for line in (evidence / "audit.jsonl").read_text().splitlines()]
        if len(rows) != 3 or any(row["outcome"] != "simulated" for row in rows):
            raise ValueError("ownership host receipts differ from fixture counts")
        result.update(ownership="SYNTHETIC_PASS", native_app="NOT_RUN", receipt_count=3)
    elif scenario == "diagnostic-export":
        diagnostics = json.loads((evidence / "diagnostics.json").read_text())
        expected = {
            "status": "PASS",
            "failure_stage": "config_read",
            "physical_key": "NOT_RUN",
            "lighting_visual": "NOT_RUN",
        }
        if diagnostics != expected:
            raise ValueError("diagnostic export evidence incomplete or overclaimed")
        result.update(diagnostic_export="PASS", failure_stage="config_read")
    else:
        rows = [json.loads(line) for line in (evidence / "device-operations.jsonl").read_text().splitlines()]
        if len(rows) != 2 or any(r["phase"] != "Verified" or r["config_readback"] != "PASS" or r["physical_key"] != "NOT_RUN" or r["lighting_visual"] != "NOT_RUN" for r in rows):
            raise ValueError("apply/restore receipts incomplete or overclaimed")
        result.update(config_readback="PASS", restore="PASS", receipt_count=2)
        if scenario == "config-write":
            editor = json.loads((evidence / "device-editor.json").read_text())
            if editor != {"status": "PASS", "host_document": "UNCHANGED", "host_preferences": "UNCHANGED", "mixed_changes": "3", "routing": "PASS"}:
                raise ValueError("device editing changed host state or mixed application failed")
            result["device_editor"] = "PASS"
        if scenario == "lighting-control":
            lights = json.loads((evidence / "lighting.json").read_text())
            if lights != {"status": "PASS", "runtime_readback": "SYNTHETIC_PASS", "physical_key": "NOT_RUN", "lighting_visual": "NOT_RUN"}:
                raise ValueError("lighting lifecycle did not pass")
            result["runtime_readback"] = "SYNTHETIC_PASS"
    return result


def alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        raise ValueError("invalid QA pid")
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--qa-only", action="store_true")
    args = parser.parse_args()
    env = dict(os.environ, MI_AUTO_HOST_READY="0")
    env.pop("MI_SYNTHETIC_SCENARIO", None)
    try:
        if not args.qa_only:
            subprocess.run(["scripts/check"], cwd=ROOT, env=env, check=True)
        subprocess.run(["scripts/build", "--synthetic"], cwd=ROOT, env=env, check=True)
        for scenario in ("host-execution", "native-ownership", "zcode-navigation", "dsh-navigation", "cindy-navigation", "antigravity-status", "config-write", "lighting-control", "diagnostic-export"):
            started = int(time.time() * 1000)
            scenario_env = dict(env, MI_SYNTHETIC_SCENARIO=scenario)
            if scenario == "diagnostic-export":
                qa_runs = ROOT / ".scratch/qa-runs"
                qa_runs.mkdir(mode=0o700, parents=True, exist_ok=True)
                run_dir = qa_runs / f"{started}-{os.getpid()}"
                run_dir_index = 0
                while run_dir.exists():
                    run_dir_index += 1
                    run_dir = qa_runs / f"{started}-{os.getpid()}-{run_dir_index}"
                run_dir.mkdir(mode=0o700)
                scenario_env["MI_QA_RUN_DIR"] = str(run_dir)
                scenario_env["MI_DIAGNOSTIC_EVIDENCE_PATH"] = str(run_dir / "evidence/diagnostic-report.json")
            proc = subprocess.Popen(["scripts/run", "--verify", "--timeout=45"], cwd=ROOT,
                                    env=scenario_env,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            try:
                output, _ = proc.communicate(timeout=90)
            except BaseException:
                proc.terminate()
                try:
                    proc.communicate(timeout=15)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
                raise
            print(output, end="", flush=True)
            paths = [line.split("=", 1)[1] for line in output.splitlines() if line.startswith("QA_RUN_DIR=")]
            if len(paths) != 1:
                raise ValueError("launcher did not identify exactly one QA run")
            run = Path(paths[0]).resolve()
            if run.parent != (ROOT / ".scratch/qa-runs").resolve():
                raise ValueError("QA path escaped isolated root")
            try:
                result = verify_evidence(run, scenario, started, alive)
                if proc.returncode != 0:
                    raise ValueError(f"launcher failed: {proc.returncode}")
            except Exception as error:
                (run / "evidence/result.json").write_text(json.dumps({"status": "FAIL", "scenario": scenario, "error": str(error)}, indent=2) + "\n")
                raise
            result.update(git_sha=subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
                          working_tree_changes=bool(subprocess.check_output(["git", "status", "--porcelain"], cwd=ROOT)),
                          timestamp_ms=int(time.time() * 1000))
            (run / "evidence/result.json").write_text(json.dumps(result, indent=2) + "\n")
            print(f"{scenario}: PASS ({run / 'evidence/result.json'})", flush=True)
    finally:
        # Restore matching production bindings/library/app; never launch that app.
        subprocess.run(["scripts/build"], cwd=ROOT, env=env, check=True)


if __name__ == "__main__":
    main()
