#!/usr/bin/env python3
"""Slice P daily-acceptance driver: two real DSH sessions through the
installed patched desktop host bridge (navigate / send / stop / approve /
status feedback), plus stale-stop and unauthorized-rejection guards.

Usage:
  scripts/verify-dsh-daily --run-dir <private-0700-dir> [--result <path>]

The bridge grant must exist at <run-dir>/dsh-grant.json (patched desktop host
launched with MI_DSH_BRIDGE_CONFIG pointing at <run-dir>/bridge-config.json).
"""
import argparse
import json
from pathlib import Path
import socket
import time
import uuid


class Bridge:
    """The DSH bridge serves one request per connection; the subscription id
    persists server-side across connections."""

    SUBSCRIPTION_ID = "micro-input-daily-driver"

    def __init__(self, run_dir: Path):
        self.grant = json.loads((run_dir / "dsh-grant.json").read_text())

    def call(self, op, **extra):
        req = dict(
            version=1,
            id=str(uuid.uuid4()),
            token=self.grant["token"],
            hostId=self.grant["hostId"],
            generation=self.grant["generation"],
            subscriptionId=self.SUBSCRIPTION_ID,
            op=op,
            **extra,
        )
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(90)
            sock.connect(self.grant["socketPath"])
            sock.sendall(json.dumps(req).encode() + b"\n")
            data = b""
            while b"\n" not in data:
                chunk = sock.recv(65536)
                if not chunk:
                    raise RuntimeError("bridge closed connection")
                data += chunk
        return json.loads(data.split(b"\n", 1)[0])

    def close(self):
        pass


def row_by_id(reply, session_id):
    for row in reply.get("rows") or []:
        if row.get("sessionId") == session_id:
            return row
    return None


def wait_phase(bridge, session_id, phases, timeout=150):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        reply = bridge.call("read")
        row = row_by_id(reply, session_id)
        if row is not None:
            last = row
            if row.get("running") in phases or row.get("pendingInput", 0) > 0:
                return row
        time.sleep(2)
    return last


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--run-dir", required=True, type=Path)
    parser.add_argument("--result", default=None, type=Path)
    parser.add_argument("--session-a", required=True)
    parser.add_argument("--session-b", required=True)
    parser.add_argument("--workspace-id", required=True)
    args = parser.parse_args()
    evidence = {"app": "dsh", "layer": "installed", "checks": {}}
    checks = evidence["checks"]
    bridge = Bridge(args.run_dir)
    try:
        sub = bridge.call("subscribe", activate=False)
        checks["subscribe"] = sub.get("status")
        row_a = row_by_id(sub, args.session_a)
        row_b = row_by_id(sub, args.session_b)
        unavailable = sub.get("unavailableSessionIds") or []
        checks["session_a_available"] = row_a is not None
        checks["session_b_available"] = row_b is not None
        checks["unavailable_at_subscribe"] = unavailable

        # Navigation: open A (loaded by the desktop window) via the real
        # UiWorkspaceService; a cold B must be refused as unavailable (never
        # fabricated), and targeting B for writes must not disturb A.
        open_b = bridge.call("open", sessionId=args.session_b, workspaceId=args.workspace_id)
        checks["open_b_cold"] = open_b.get("status")
        checks["open_b_cold_refused"] = open_b.get("status") in ("unavailable", "stale", "denied")
        prompt_wrong = bridge.call(
            "prompt", sessionId=args.session_b, mode="queue", text="must-not-run", requestId=str(uuid.uuid4()))
        checks["prompt_cold_b_no_effect"] = prompt_wrong.get("status") in ("unavailable", "unconfirmed", "stale")
        open_a = bridge.call("open", sessionId=args.session_a, workspaceId=args.workspace_id)
        checks["open_a"] = open_a.get("status")
        time.sleep(2)
        read2 = bridge.call("read")
        checks["selected_a"] = (read2.get("selected") == args.session_a)
        checks["navigation_confirmed"] = checks["open_a"] == "confirmed" and checks["selected_a"]

        # Send on A (queue semantics when running, steer semantics handled by host).
        prompt_a = bridge.call(
            "prompt", sessionId=args.session_a, mode="queue", text="Micro Input Slice P: DSH-A 回执校验，请只回复一行 MI-P-DSH-A-OK",
            requestId=str(uuid.uuid4()))
        checks["prompt_a"] = {"status": prompt_a.get("status"), "delivery": prompt_a.get("delivery")}
        # duplicate requestId must be deduped (no double send)
        prompt_dup = bridge.call(
            "prompt", sessionId=args.session_a, mode="queue", text="duplicate", requestId=prompt_a.get("requestId") or "dup")
        checks["prompt_a_duplicate"] = prompt_dup.get("duplicate") is True

        # Status feedback: wait until A leaves running (completed/idle) with pendingInput back to 0.
        row = wait_phase(bridge, args.session_a, phases=[False], timeout=180)
        checks["status_a_settled"] = bool(row and row.get("running") is False and row.get("pendingInput") == 0)

        # Stop semantics on B: late cancel with an old expected turn must be a noop.
        stale = bridge.call("cancel", sessionId=args.session_b, expectedTurn=0, requestId=str(uuid.uuid4()))
        checks["stop_late_noop"] = stale.get("status") in ("noop", "unconfirmed") and stale.get("reasonCode") in (
            "guard.turnChanged", "guard.notRunning", "guard.selectionMismatch", None)

        # Unauthorized rejection: bad token must be denied with zero rows.
        bad_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        bad_sock.settimeout(10)
        bad_sock.connect(bridge.grant["socketPath"])
        bad = dict(version=1, id=str(uuid.uuid4()), token="x" * 64, hostId=args.session_a,
                   generation=1, subscriptionId=Bridge.SUBSCRIPTION_ID, op="read")
        bad_sock.sendall(json.dumps(bad).encode() + b"\n")
        data = b""
        try:
            while b"\n" not in data:
                chunk = bad_sock.recv(65536)
                if not chunk:
                    break
                data += chunk
        finally:
            bad_sock.close()
        bad_reply = json.loads(data.split(b"\n", 1)[0]) if data else {}
        checks["unauthorized_denied"] = bad_reply.get("status") in ("denied", "stale") and not bad_reply.get("rows")
    finally:
        bridge.close()

    required = ["navigation_confirmed", "open_b_cold_refused", "prompt_cold_b_no_effect",
                "status_a_settled", "stop_late_noop", "unauthorized_denied"]
    ok = checks.get("subscribe") == "ok" and checks.get("prompt_a", {}).get("status") in ("queued", "steered") \
        and all(bool(checks.get(k)) for k in required)
    evidence["status"] = "PASS" if ok else "FAIL"
    evidence["physical_key"] = "NOT_RUN"
    evidence["git_sha"] = __import__("subprocess").check_output(
        ["git", "rev-parse", "HEAD"], cwd=Path(__file__).resolve().parent.parent, text=True).strip()
    out = args.result or (args.run_dir / "result.json")
    out.write_text(json.dumps(evidence, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(json.dumps(evidence, indent=2, ensure_ascii=False))
    raise SystemExit(0 if ok else 1)


if __name__ == "__main__":
    main()
