#!/usr/bin/env python3
"""Exercise the patched native bridge over real Unix sockets using synthetic task owners."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import time

ROOT = Path(__file__).resolve().parent.parent


def exchange(path, value):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(3)
        connection.connect(str(path))
        connection.sendall(json.dumps(value).encode() + b"\n")
        result = bytearray()
        while not result.endswith(b"\n"):
            chunk = connection.recv(65536)
            if not chunk:
                raise RuntimeError("incomplete response")
            result.extend(chunk)
            if len(result) > 1048576:
                raise RuntimeError("oversized response")
        return json.loads(result)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--output", type=Path, default=ROOT / ".scratch/zcode-native-result.json")
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps({"status": "INCOMPLETE", "cleanup_confirmed": False}) + "\n")
    source = args.source.resolve()
    expected_sha = (ROOT / "integrations/zcode/BASE_SHA").read_text().strip()
    source_sha = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=source, text=True).strip()
    diff_command = ["git", "diff", "--no-ext-diff", "--no-color", "--binary", "--src-prefix=a/", "--dst-prefix=b/", "HEAD"]
    source_diff = subprocess.check_output(diff_command, cwd=source)
    if source_sha != expected_sha or source_diff != (ROOT / "integrations/zcode/navigation.patch").read_bytes():
        raise RuntimeError("source does not exactly match fixed base and shipped patch")
    run = ROOT / ".scratch" / f"zn{os.getpid()}"
    run.mkdir(mode=0o700)
    checks = {}
    boundary_dir = ROOT / ".scratch" / f"zb{os.getpid()}"
    subprocess.run(["pnpm", "exec", "tsx", "scripts/micro-input-boundaries.ts", str(boundary_dir)], cwd=source, check=True)
    checks["socket_owner_interleaving"] = True
    checks["confirmed_window_focus"] = True
    subprocess.run(["pnpm", "exec", "tsx", "scripts/micro-input-host-boundary.mjs"], cwd=source, check=True)
    checks["host_projection_no_preview_or_error_payload"] = True
    process = subprocess.Popen(["pnpm", "exec", "tsx", "--tsconfig", "packages/ui/tsconfig.json", "scripts/micro-input-fixture.ts", "--directory", str(run), "--ttl", "90"], cwd=source, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    result = {"status": "FAIL", "native_app": "NOT_RUN", "physical_key": "NOT_RUN", "surface": "patched-source-uds-real-renderer-stores-synthetic-owners"}
    try:
        deadline = time.monotonic() + 20
        while not (run / "control.sock").exists():
            if process.poll() is not None or time.monotonic() > deadline:
                raise RuntimeError("fixture did not become ready")
            time.sleep(0.05)
        grant = json.loads((run / "zcode-grant.json").read_text())
        def control(op, **fields):
            return exchange(run / "control.sock", {"op": op, **fields})
        serial = 0
        def request(op="list", scope=None, target=None, **fields):
            nonlocal serial
            serial += 1
            value = {"version": 1, "id": str(serial), "token": grant["token"], "instanceId": grant["instanceId"], "generation": grant["generation"], "op": op, "scope": scope or grant["scopes"][0]}
            if target is not None:
                value["target"] = target
            value.update(fields)
            return exchange(grant["socketPath"], value)
        def check(name, predicate):
            if not predicate:
                raise AssertionError(name)
            checks[name] = True
        check("unauthorized_zero_metadata", request(token="denied")["status"] == "denied" and control("stats")["metadataReads"] == 0)
        check("out_of_scope_zero_metadata", request(scope={"workspacePath": "/outside"})["status"] == "denied" and control("stats")["metadataReads"] == 0)
        check("unknown_fields_zero_metadata", request(readBody=True)["status"] == "denied" and control("stats")["metadataReads"] == 0)
        first = request()
        second = request(scope=grant["scopes"][1])
        one, two = first["rows"][0], second["rows"][0]
        check("same_names_and_ids_distinct_workspaces", one["title"] == two["title"] and one["address"]["taskId"] == two["address"]["taskId"] and one["address"] != two["address"])
        check("metadata_projection_only", all(set(row).issubset({"address", "title", "liveStatus", "executionId"}) for row in first["rows"] + second["rows"]))
        selected = request("open", grant["scopes"][1], two["address"])
        check("exact_selected_readback", selected["status"] == "confirmed" and selected["selected"] == two["address"] and control("stats")["selected"] == two["address"])
        unselected_send = request("send", grant["scopes"][0], one["address"], commandId="cmd-unselected", clientId="native-check", text="must-not-send")
        check("selected_only_isolation", unselected_send["status"] == "unconfirmed" and control("stats")["sendCount"] == 0)
        start_send = request("send", grant["scopes"][1], two["address"], commandId="cmd-start-1", clientId="native-check", text="start-work")
        check("send_starts_selected_session", start_send["status"] == "started" and start_send.get("delivery") == "startNow" and bool(start_send.get("executionId")))
        dup_send = request("send", grant["scopes"][1], two["address"], commandId="cmd-start-1", clientId="native-check", text="start-work")
        check("duplicate_command_dedup", dup_send["status"] == "started" and dup_send.get("duplicate") is True and control("stats")["sendCount"] == 1)
        guide_send = request("send", grant["scopes"][1], two["address"], commandId="cmd-guide-1", clientId="native-check", text="steer-work", requestedDelivery="guide")
        control("set-task-state", workspacePath=two["address"]["workspacePath"], taskId=two["address"]["taskId"], routingMode="queue")
        queue_fallback = request("send", grant["scopes"][1], two["address"], commandId="cmd-queue-1", clientId="native-check", text="queue-work", requestedDelivery="guide")
        control("set-task-state", workspacePath=two["address"]["workspacePath"], taskId=two["address"]["taskId"], routingMode="guide")
        check("inflight_steering_vs_queue", guide_send["status"] == "steered" and guide_send.get("delivery") == "guide" and queue_fallback["status"] == "queued" and queue_fallback.get("delivery") == "queue" and control("stats")["createCount"] == 0)
        control("set-task-state", workspacePath=two["address"]["workspacePath"], taskId=two["address"]["taskId"], liveStatus="running", executionId="exec-current-2")
        late_stop = request("stop", grant["scopes"][1], two["address"], commandId="cmd-stop-late", clientId="native-check", executionId="exec-old-1")
        valid_stop = request("stop", grant["scopes"][1], two["address"], commandId="cmd-stop-valid", clientId="native-check", executionId="exec-current-2")
        check("late_stop_noop_and_valid_stop", late_stop["status"] == "noop" and late_stop.get("reasonCode") == "guard.stopTargetChanged" and valid_stop["status"] == "stopped")
        control("delay-next-command", delayMs=50, holdUnknown=True)
        delayed_send = request("send", grant["scopes"][1], two["address"], commandId="cmd-held-1", clientId="native-check", text="held-message")
        unknown_query = request("query", grant["scopes"][1], two["address"], commandId="cmd-held-1")
        control("settle-held-commands")
        settled_query = request("query", grant["scopes"][1], two["address"], commandId="cmd-held-1")
        check("timeout_query_same_id_reconciliation", delayed_send["status"] == "started" and unknown_query["status"] == "unknown" and settled_query["status"] == "started" and settled_query.get("duplicate") is True)
        created = request("create", grant["scopes"][0], commandId="cmd-create-1", clientId="native-check", sessionId="created-task-a", text="hello-new")
        listed_after_create = request("list", grant["scopes"][0])
        check("create_workspace_bound_and_readback", created["status"] == "confirmed" and created["selected"]["taskId"] == "created-task-a" and created["selected"]["workspacePath"] == grant["scopes"][0]["workspacePath"] and any(r["address"]["taskId"] == "created-task-a" for r in listed_after_create["rows"]))
        request("open", grant["scopes"][1], two["address"])
        before = control("stats")
        check("cross_scope_open_zero_metadata", request("open", grant["scopes"][0], two["address"])["status"] == "denied" and control("stats")["metadataReads"] == before["metadataReads"])
        control("delete")
        check("deleted_zero_navigation", request("open", target=one["address"])["status"] == "unavailable" and control("stats")["navigationCount"] == before["navigationCount"])
        control("reset")
        request()
        control("delete-during-open")
        check("deletion_during_validation_zero_navigation", request("open", target=one["address"])["status"] == "unavailable" and control("stats")["navigationCount"] == 0)
        control("reset")
        control("disconnect")
        before = control("stats")
        check("disconnected_zero_navigation", request("open", target=one["address"])["status"] == "unavailable" and control("stats")["navigationCount"] == 0 and control("stats")["metadataReads"] == before["metadataReads"])
        control("reset")
        request()
        control("rotate-during-open")
        check("source_replaced_during_open_zero_navigation", request("open", target=one["address"])["status"] == "stale" and control("stats")["navigationCount"] == 0)
        check("source_replacement_stays_stale", request()["status"] == "stale" and request("open", target=one["address"])["status"] == "stale" and control("stats")["navigationCount"] == 0)
        control("rotate")
        before = control("stats")
        check("grant_generation_zero_metadata", request()["status"] == "stale" and control("stats")["metadataReads"] == before["metadataReads"])
        result.update(status="PASS", checks=checks, transcript_api="NOT_EXPOSED")
    finally:
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGTERM)
        try:
            process.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.communicate()
        result["cleanup_confirmed"] = not (run / "zcode.sock").exists() and not (run / "control.sock").exists() and not (run / "zcode-grant.json").exists()
        result["source_sha"] = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=source, text=True).strip()
        diff = subprocess.check_output(diff_command, cwd=source)
        result["source_diff_sha256"] = hashlib.sha256(diff).hexdigest()
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(result, indent=2) + "\n")
        if result["cleanup_confirmed"]:
            run.rmdir()
    if result["status"] != "PASS" or not result["cleanup_confirmed"]:
        raise RuntimeError("native verification failed")
    print(f"zcode-native: PASS ({len(checks)} checks; {args.output})")


if __name__ == "__main__":
    main()
