#!/usr/bin/env python3
"""H0/H1 supervisor. Defaults to offline tests; native runs require exact scope and target."""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import uuid

ROOT = Path(__file__).resolve().parent.parent

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--execute', choices=['h0', 'h1'])
    parser.add_argument('--device-path')
    parser.add_argument('--kit', type=Path)
    parser.add_argument('--expected-keymap-sha256')
    parser.add_argument('--unresolved-operations-reviewed', action='store_true')
    args = parser.parse_args()
    command = ['cargo', 'test', '--locked', '-p', 'mi-session', '--test', 'hardware']
    env = {k: v for k, v in os.environ.items() if not k.startswith(('MI_HARDWARE_', 'MI_PROBE_'))}
    if args.execute is None:
        if any([args.device_path, args.kit, args.expected_keymap_sha256, args.unresolved_operations_reviewed]):
            parser.error('native options require explicit --execute')
        return subprocess.run(command, cwd=ROOT, env=env, check=False).returncode
    if not args.device_path or not args.kit:
        parser.error('execution requires an exact device path and verified offline kit')
    if args.execute == 'h1' and (not args.unresolved_operations_reviewed or not args.expected_keymap_sha256 or len(args.expected_keymap_sha256) != 64 or any(c not in '0123456789abcdef' for c in args.expected_keymap_sha256)):
        parser.error('H1 requires reviewed unresolved operations and expected keymap SHA-256')
    if args.execute == 'h0' and (args.expected_keymap_sha256 or args.unresolved_operations_reviewed):
        parser.error('H0 does not accept H1 options')
    loader = importlib.machinery.SourceFileLoader('hardware_kit', str(ROOT / 'scripts' / 'prepare-hardware-acceptance'))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    kit = importlib.util.module_from_spec(spec)
    loader.exec_module(kit)
    kit.verify(args.kit)
    target = json.loads(kit.read_regular(args.kit / 'plan.json'))['target']
    # No caller-provided RPC, payload, backup or target path reaches the wire.
    env.update(MI_HARDWARE_OPERATOR='I_AUTHORIZE_H0_READONLY_BACKUP' if args.execute == 'h0' else 'I_AUTHORIZE_H1_EXACT_TEMPFILE',
               MI_HARDWARE_PATH=args.device_path, MI_HARDWARE_TARGET=target)
    if args.execute == 'h1':
        env.update(MI_HARDWARE_KEYMAP_SHA256=args.expected_keymap_sha256, MI_HARDWARE_REVIEWED='yes')
    directory = ROOT / '.scratch' / 'input-study' / ('hardware-supervisor-' + uuid.uuid4().hex)
    directory.mkdir(parents=True, mode=0o700)
    child = None
    def journal(stage):
        value = {'stage': stage, 'scope': args.execute, 'target': target,
                 'pid': child.pid if child else None,
                 'result': 'UNKNOWN_UNTIL_HARNESS_RECORD_VERIFIED',
                 'hardware_records': '.scratch/input-study/probe-h-*/stage-*.json'}
        kit.write_new(directory / (stage + '.json'), kit.encoded(value))
        fd = os.open(directory, os.O_RDONLY)
        try: os.fsync(fd)
        finally: os.close(fd)
    def stop():
        if child is None or child.poll() is not None: return True
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try: os.killpg(child.pid, sig)
            except ProcessLookupError: return child.poll() is not None
            try:
                child.wait(timeout=10)
                return True
            except subprocess.TimeoutExpired: pass
        return False
    def interrupt(*_): raise KeyboardInterrupt
    for sig in (signal.SIGTERM, signal.SIGHUP): signal.signal(sig, interrupt)
    journal('prepared')
    if args.execute == 'h1':
        # Exclusive durable claim: even interruption before open consumes this kit.
        # Never automatically clear a claim after success or an unknown outcome.
        claim = args.kit.parent / (target + '.h1-claimed.json')
        kit.write_new(claim, kit.encoded({'target': target, 'supervisor': str(directory)}))
        fd = os.open(claim.parent, os.O_RDONLY)
        try: os.fsync(fd)
        finally: os.close(fd)
    try:
        child = subprocess.Popen(command + ['native_' + args.execute, '--', '--ignored', '--exact', '--nocapture'], cwd=ROOT, env=env, start_new_session=True)
        journal('started')
        code = child.wait(timeout=300)
        journal('child-exited')
        return code
    except (subprocess.TimeoutExpired, KeyboardInterrupt, OSError):
        stopped = stop()
        try: journal('stopped-unknown' if stopped else 'exit-unconfirmed-unknown')
        except OSError: pass
        print('UNKNOWN: no retry, reconnect, deletion or restore; inspect private records.', file=sys.stderr)
        return 124

if __name__ == '__main__':
    try: sys.exit(main())
    except (OSError, ValueError, TypeError, KeyError):
        print('Invalid local preparation; native execution not started.', file=sys.stderr)
        sys.exit(2)
