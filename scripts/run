#!/usr/bin/env python3
"""Run this checkout's build. --verify bounds the QA instance lifetime to ten minutes."""
import os
import tempfile
import pathlib
import subprocess
import sys
root = pathlib.Path(__file__).resolve().parent.parent
app = root / 'target/MicroInput.app/Contents/MacOS/MicroInput'
if not app.exists():
    raise SystemExit('Run scripts/build first')
qa = tempfile.TemporaryDirectory(prefix='micro-input-qa-') if '--verify' in sys.argv else None
run_env = os.environ.copy()
if qa:
    run_env['MI_DOCUMENT_DIR'] = qa.name
p = subprocess.Popen([str(app)], env=run_env)
try:
    p.wait(timeout=600 if '--verify' in sys.argv else None)
except (subprocess.TimeoutExpired, KeyboardInterrupt):
    p.terminate()
    try:
        p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        p.kill()
        p.wait()
finally:
    if p.poll() is None:
        p.terminate()

    if qa:
        qa.cleanup()
