#!/usr/bin/env python3
"""Slice P daily-acceptance driver for Cindy: verifies deployed patched
/Applications/Cindy.app build, backup presence, persisted ownership fence,
and paired UDS ownership + two-session navigation/task actions.
"""
import argparse
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", default=ROOT / ".scratch/pstack-apps/cindy", type=Path)
    parser.add_argument("--result", default=ROOT / ".scratch/pstack-apps/runs/cindy/daily-result.json", type=Path)
    args = parser.parse_args()

    base_sha = (ROOT / "integrations/cindy/BASE_SHA").read_text(encoding="utf-8").strip()
    deployed_source_path = Path("/Applications/Cindy.app/Contents/Resources/cindy-source.json")
    deployed_source = (
        json.loads(deployed_source_path.read_text(encoding="utf-8"))
        if deployed_source_path.is_file()
        else {}
    )
    backup_app = ROOT / ".scratch/pstack-apps/backups/Cindy-0.1.126.orig.app"
    backup_userdata = ROOT / ".scratch/pstack-apps/backups/CindyGlobal-userData-backup"
    fence_path = Path.home() / "Library/Application Support/MicroInput/cindy-ownership.sock.fence"
    fence = json.loads(fence_path.read_text(encoding="utf-8")) if fence_path.is_file() else {}

    paired_proc = subprocess.run(
        ["python3", str(ROOT / "scripts/verify-cindy-paired"), "--source", str(args.source), "--skip-build"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    paired_receipt_path = None
    for line in paired_proc.stdout.splitlines():
        if line.startswith("paired-native-source: PASS (") and line.endswith(")"):
            paired_receipt_path = line.split("(", 1)[1][:-1]

    paired_receipt = (
        json.loads(Path(paired_receipt_path).read_text(encoding="utf-8"))
        if paired_receipt_path and Path(paired_receipt_path).is_file()
        else {}
    )
    nav_client = (
        json.loads(Path(paired_receipt["navigation_client_evidence"]).read_text(encoding="utf-8"))
        if paired_receipt.get("navigation_client_evidence")
        and Path(paired_receipt["navigation_client_evidence"]).is_file()
        else {}
    )
    nav_native = (
        json.loads(Path(paired_receipt["navigation_native_evidence"]).read_text(encoding="utf-8"))
        if paired_receipt.get("navigation_native_evidence")
        and Path(paired_receipt["navigation_native_evidence"]).is_file()
        else {}
    )

    checks = {
        "deployed_source_matches_base": deployed_source.get("sourceCommit") == base_sha,
        "deployed_built_at": deployed_source.get("builtAt"),
        "backup_app_present": backup_app.is_dir(),
        "backup_userdata_present": backup_userdata.is_dir(),
        "persisted_ownership_fence_valid": bool(fence.get("clientInstance") and fence.get("generation", 0) >= 1),
        "paired_ownership_and_navigation": paired_proc.returncode == 0
        and paired_receipt.get("paired_native_source") == "PASS"
        and paired_receipt.get("paired_navigation_source") == "PASS",
        "two_session_confirmed_targets": nav_client.get("confirmed_targets") == [
            "/Users/test/CindyAlpha#cindy-alpha-2",
            "/Users/test/CindyBeta#cindy-beta-1",
        ],
        "unauthorized_metadata_reads_zero": nav_native.get("unauthorized_metadata_reads") == 0,
        "local_agent_api_relaxed_false": nav_native.get("local_agent_api_relaxed") is False,
        "live_interactive_catalog_sync": False,
    }

    required_partial = [
        "deployed_source_matches_base",
        "backup_app_present",
        "backup_userdata_present",
        "persisted_ownership_fence_valid",
        "paired_ownership_and_navigation",
        "two_session_confirmed_targets",
        "unauthorized_metadata_reads_zero",
        "local_agent_api_relaxed_false",
    ]
    partial_ok = all(bool(checks.get(k)) for k in required_partial)
    full_ok = partial_ok and bool(checks.get("live_interactive_catalog_sync"))

    evidence = {
        "app": "cindy",
        "layer": "installed",
        "checks": checks,
        "paired_receipt": paired_receipt_path,
        "status": "PASS" if full_ok else ("PARTIAL" if partial_ok else "FAIL"),
        "gap": None if full_ok else "interactive_workspace_session_required_for_live_catalog_sync",
        "physical_key": "NOT_RUN",
        "git_sha": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
    }

    args.result.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
    args.result.write_text(json.dumps(evidence, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(json.dumps(evidence, indent=2, ensure_ascii=False))
    raise SystemExit(0 if (full_ok or partial_ok) else 1)


if __name__ == "__main__":
    main()
